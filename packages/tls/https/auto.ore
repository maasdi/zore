package https

import "std/context"
import "std/net/http"
import "std/net/url"
import "std/time"
import "tls"

const MaxAutoOrigins = 64

type AutoClient struct {
    dialer channel<tls.ClientConfig>
    state Mutex<autoState>
    config http.ClientConfig
    limits http.HTTP2Config
    live bool
}

type AutoStats struct {
    HTTP2Connections int
}

type autoEntry struct {
    origin string
    conn http.HTTP2Conn
}

type autoPending struct {
    origin string
    ready channel<bool>
}

type autoState struct {
    entries Array<autoEntry>
    pending Array<autoPending>
    closed bool
}

type autoRelease struct {
    state Mutex<autoState>
    origin string
    armed bool
}

func (r mut autoRelease) drop() {
    r.release()
}

func (r mut autoRelease) release() {
    if !r.armed {
        return
    }
    r.armed = false
    let origin = r.origin
    r.state.withLock(func(s mut autoState) {
        var kept = Array<autoPending>{}
        for entry in s.pending {
            if entry.origin == origin {
                entry.ready.close()
            } else {
                kept.push(entry)
            }
        }
        s.pending = kept
    })
}

type autoDialer struct {
    home channel<tls.ClientConfig>
    configs Array<tls.ClientConfig>
}

func (d mut autoDialer) drop() {
    let found, config = d.configs.pop()
    if found {
        d.home.send(config)
    }
}

func autoProtocols() Array<string> {
    return Array<string>{"h2", "http/1.1"}
}

func newAutoClient(config own tls.ClientConfig, settings http.ClientConfig, limits http.HTTP2Config) (AutoClient, error) {
    var offered = config
    let names = autoProtocols()
    offered.SetProtocols(names[:])?
    let checked = http.NewClient(settings)?
    let probe = AutoClient{dialer: channel<tls.ClientConfig>(1), state: mutex(autoState{entries: Array<autoEntry>{}, pending: Array<autoPending>{}, closed: false}), config: checked.Config(), limits: limits, live: true}
    let dialer = probe.dialer
    dialer.send(offered)
    return probe, nil
}

func NewAutoClient(rootsPEM []byte, settings http.ClientConfig, limits http.HTTP2Config) (AutoClient, error) {
    let config = tls.NewClientConfig(rootsPEM)?
    return newAutoClient(config, settings, limits)
}

func NewDefaultAutoClient(settings http.ClientConfig, limits http.HTTP2Config) (AutoClient, error) {
    let config = tls.DefaultClientConfig()?
    return newAutoClient(config, settings, limits)
}

func (a AutoClient) Stats() AutoStats {
    if !a.live {
        return AutoStats{HTTP2Connections: 0}
    }
    return a.state.withLock(func(s mut autoState) AutoStats {
        var open = 0
        for entry in s.entries {
            if !entry.conn.Stats().Closed {
                open += 1
            }
        }
        return AutoStats{HTTP2Connections: open}
    })
}

func (a AutoClient) Close() {
    if !a.live {
        return
    }
    let entries = a.state.withLock(func(s mut autoState) Array<autoEntry> {
        s.closed = true
        var taken = Array<autoEntry>{}
        for s.entries.len() > 0 {
            let _, entry = s.entries.pop()
            taken.push(entry)
        }
        return taken
    })
    for entry in entries {
        entry.conn.Close()
    }
}

func (a AutoClient) isClosed() bool {
    return a.state.withLock(func(s mut autoState) bool {
        return s.closed
    })
}

func (s mut autoState) prune() {
    var kept = Array<autoEntry>{}
    for entry in s.entries {
        if !entry.conn.Stats().Closed {
            kept.push(entry)
        }
    }
    s.entries = kept
}

type autoRoute struct {
    shared Array<http.HTTP2Conn>
    direct Array<tls.Conn>
    oneOff bool
}

func emptyAutoResponse() http.ClientResponse {
    return http.ClientResponse{StatusCode: 0, Headers: http.NewHeader(), Body: Array<byte>{}}
}

func (a AutoClient) admit(absoluteURL string, body []byte) (url.AbsoluteURL, error) {
    if !a.live {
        return url.AbsoluteURL{Scheme: "", Hostname: "", Authority: "", Address: "", RequestTarget: ""}, error("https.AutoClient: empty client")
    }
    let target = url.ParseAbsolute(absoluteURL)?
    if a.isClosed() {
        return target, error("https.AutoClient: closed client")
    }
    if target.Scheme == "https" && body.len() > a.config.MaxRequestBodyBytes {
        return target, error("http.Client: request body too large")
    }
    return target, nil
}

func (a AutoClient) Do(ctx context.Context, method string, absoluteURL string, headers http.Header, body []byte) (http.ClientResponse, error) {
    let target, admitErr = a.admit(absoluteURL, body)
    if admitErr != nil {
        return emptyAutoResponse(), admitErr
    }
    let client = http.NewClient(a.config)?
    if target.Scheme != "https" {
        return client.Do(ctx, method, absoluteURL, headers, body)
    }
    let bounded, cancel = context.WithDeadline(ctx, time.Now().Add(a.config.Timeout))
    let guard = autoCancel{cancel: cancel}
    var retried = false
    for {
        var route = a.route(bounded, target)?
        if route.direct.len() > 0 {
            let _, source = route.direct.pop()
            return client.Exchange(bounded, conn{source: source}, method, absoluteURL, headers, body)
        }
        let response, err = route.shared[0].Do(bounded, method, absoluteURL, headers, body)
        if !a.again(route, err, retried) {
            return response, err
        }
        _ = err
        retried = true
    }
}

func (a AutoClient) Open(ctx context.Context, method string, absoluteURL string, headers http.Header, body []byte, config http.StreamConfig) (http.ResponseStream, error) {
    let target = a.admit(absoluteURL, body)?
    let client = http.NewClient(a.config)?
    if target.Scheme != "https" {
        return client.Open(ctx, method, absoluteURL, headers, body, config)
    }
    let bounded, cancel = context.WithDeadline(ctx, time.Now().Add(a.config.DialTimeout + a.config.Timeout))
    let guard = autoCancel{cancel: cancel}
    var retried = false
    for {
        var route = a.route(bounded, target)?
        if route.direct.len() > 0 {
            let _, source = route.direct.pop()
            return client.OpenExchange(ctx, conn{source: source}, method, absoluteURL, headers, body, config)
        }
        let stream, err = route.shared[0].Open(ctx, method, absoluteURL, headers, body, config)
        if !a.again(route, err, retried) {
            return stream, err
        }
        _ = err
        retried = true
    }
}

func (a AutoClient) Upload(ctx context.Context, method string, absoluteURL string, headers http.Header, body own http.RequestBody, config http.UploadConfig) (http.ClientResponse, error) {
    if config.Timeout > 0 {
        let bounded, cancel = context.WithDeadline(ctx, time.Now().Add(config.Timeout))
        let guard = autoCancel{cancel: cancel}
        return a.upload(bounded, method, absoluteURL, headers, body, config)
    }
    return a.upload(ctx, method, absoluteURL, headers, body, config)
}

func (a AutoClient) upload(ctx context.Context, method string, absoluteURL string, headers http.Header, body own http.RequestBody, config http.UploadConfig) (http.ClientResponse, error) {
    let empty = Array<byte>{}
    let target = a.admit(absoluteURL, empty[:])?
    let client = http.NewClient(a.config)?
    if target.Scheme != "https" {
        return client.Upload(ctx, method, absoluteURL, headers, body, config)
    }
    let bounded, cancel = context.WithDeadline(ctx, time.Now().Add(a.config.Timeout))
    let guard = autoCancel{cancel: cancel}
    var route = a.route(bounded, target)?
    if route.direct.len() > 0 {
        let _, source = route.direct.pop()
        return client.UploadExchange(ctx, conn{source: source}, method, absoluteURL, headers, body, config)
    }
    let response, err = route.shared[0].Upload(ctx, method, absoluteURL, headers, body, config)
    if route.oneOff {
        route.shared[0].Close()
    }
    return response, err
}

func (a AutoClient) OpenDecoded(ctx context.Context, method string, absoluteURL string, headers http.Header, body []byte, stream http.StreamConfig, config http.DecodeConfig) (http.ResponseStream, error) {
    let request = http.DecodeHeaders(headers, config)?
    let opened = a.Open(ctx, method, absoluteURL, request, body, stream)?
    return http.DecodeStream(opened, config)
}

type autoCancel struct {
    cancel func()
}

func (g mut autoCancel) drop() {
    (g.cancel)()
}

func (a AutoClient) route(ctx context.Context, target url.AbsoluteURL) (autoRoute, error) {
    var route = autoRoute{shared: Array<http.HTTP2Conn>{}, direct: Array<tls.Conn>{}, oneOff: false}
    let origin = target.Address
    for {
        let closed, known, wait, dialing = a.state.withLock(func(s mut autoState) (bool, Array<http.HTTP2Conn>, Array<channel<bool>>, bool) {
            var found = Array<http.HTTP2Conn>{}
            var waits = Array<channel<bool>>{}
            s.prune()
            for entry in s.entries {
                if entry.origin == origin {
                    found.push(entry.conn)
                }
            }
            if s.closed || found.len() > 0 {
                return s.closed, found, waits, false
            }
            for entry in s.pending {
                if entry.origin == origin {
                    waits.push(entry.ready)
                    return false, found, waits, false
                }
            }
            s.pending.push(autoPending{origin: origin, ready: channel<bool>()})
            return false, found, waits, true
        })
        if closed {
            return route, error("https.AutoClient: closed client")
        }
        if known.len() > 0 {
            route.shared.push(known[0])
            return route, nil
        }
        if dialing {
            return a.connect(ctx, origin, target, autoRelease{state: a.state, origin: origin, armed: true})
        }
        select {
            case wait[0].receive() {
                let _ = 0
            }
            case ctx.Done().receive() {
                return route, ctx.Err()
            }
        }
        let kept = a.state.withLock(func(s mut autoState) bool {
            s.prune()
            for entry in s.entries {
                if entry.origin == origin {
                    return true
                }
            }
            return false
        })
        if !kept {
            return a.connect(ctx, origin, target, autoRelease{state: a.state, origin: origin, armed: false})
        }
    }
}

func (a AutoClient) again(route autoRoute, err error, retried bool) bool {
    if route.oneOff {
        route.shared[0].Close()
    }
    return err != nil && !retried && retryable(err)
}

func retryable(err error) bool {
    return err == error("http2: request not processed") || err == error("http2: closed connection")
}

func (a AutoClient) dial(ctx context.Context, target url.AbsoluteURL) (Array<tls.Conn>, error) {
    var conns = Array<tls.Conn>{}
    select {
        case let config, _ = a.dialer.receive() {
            var holder = autoDialer{home: a.dialer, configs: Array<tls.ClientConfig>{}}
            holder.configs.push(config)
            let bounded, cancel = context.WithDeadline(ctx, time.Now().Add(a.config.DialTimeout))
            let conn, err = tls.DialContext(bounded, target.Address, target.Hostname, holder.configs[0])
            cancel()
            if err != nil {
                return conns, err
            }
            conns.push(conn)
            return conns, nil
        }
        case ctx.Done().receive() {
            return conns, ctx.Err()
        }
    }
}

func (a AutoClient) connect(ctx context.Context, origin string, target url.AbsoluteURL, gate own autoRelease) (autoRoute, error) {
    var waiting = gate
    var route = autoRoute{shared: Array<http.HTTP2Conn>{}, direct: Array<tls.Conn>{}, oneOff: false}
    var conns = a.dial(ctx, target)?
    let _, source = conns.pop()
    if a.isClosed() {
        return route, error("https.AutoClient: closed client")
    }
    if source.Protocol() != "h2" {
        waiting.release()
        route.direct.push(source)
        return route, nil
    }
    let client = http.NewClient(a.config)?
    let shared = client.NewHTTP2Conn(conn{source: source}, a.limits)?
    let stored = a.state.withLock(func(s mut autoState) bool {
        s.prune()
        if s.closed || s.entries.len() >= MaxAutoOrigins {
            return false
        }
        for entry in s.entries {
            if entry.origin == origin {
                return false
            }
        }
        s.entries.push(autoEntry{origin: origin, conn: shared})
        return true
    })
    waiting.release()
    route.shared.push(shared)
    route.oneOff = !stored
    return route, nil
}
