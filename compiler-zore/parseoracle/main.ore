package main

import "compiler-zore/diagnostic"
import "compiler-zore/lexer"
import "compiler-zore/parser"
import "compiler-zore/source"
import "zore/os"
import "zore/strconv"
import "zore/strings"

// Case modes: `p` parses, `n` parses with native functions allowed, `s` probes the source manager.
func main() {
    let data, err = os.ReadFile("cases.bin")
    if err != nil {
        println("cannot read cases.bin")
        return
    }
    var pos = 0
    var index = 0
    for pos < data.len() {
        var length = 0
        for data[pos] != 32 {
            length = length * 10 + int(data[pos]) - 48
            pos += 1
        }
        let mode = data[pos + 1]
        pos += 3
        let text, invalid = strings.FromBytes(data[pos:pos + length])
        if invalid != nil {
            println("invalid-utf8\ndone")
        } else {
            let file = source.NewFile("case-" + strconv.Itoa(index) + ".ore", text)
            var lines = Array<string>{}
            if mode == 105 {
                identityProbe(lines)
            } else if mode == 115 {
                probe(lines, file)
            } else {
                parsed(lines, file, mode == 110)
            }
            lines.push("done")
            println(strings.Join(lines[:], "\n"))
        }
        pos += length
        index += 1
    }
}

func span(start int, end int) string {
    return strconv.Itoa(start) + " " + strconv.Itoa(end)
}

func parsed(lines mut Array<string>, file source.File, native bool) {
    let result = parser.Parse(file, native)
    lines.push("tree " + result.Tree.Print(result.Root))
    for problem in result.LexProblems {
        lines.push("lexerror:" + problem.Code + " " + span(problem.Start, problem.End))
    }
    for d in result.Diagnostics {
        describe(lines, d)
    }
}

func describe(lines mut Array<string>, d diagnostic.Diagnostic) {
    lines.push("diag " + span(d.Primary.Start, d.Primary.End) + " " + d.Message)
    if d.Primary.Message != "" {
        lines.push("  primary " + d.Primary.Message)
    }
    for label in d.Related {
        lines.push("  related " + span(label.Start, label.End) + " " + label.Message)
    }
    for note in d.Notes {
        lines.push("  note " + note)
    }
    let rendered, ok = diagnostic.Render(d)
    if !ok {
        lines.push("  render failed")
        return
    }
    let pieces = strings.Split(rendered, "\n")
    for i, piece in pieces {
        if i + 1 < pieces.len() {
            lines.push("  render " + piece)
        }
    }
}

func probe(lines mut Array<string>, file source.File) {
    let count = file.LineCount()
    lines.push("lines " + strconv.Itoa(count))
    for var i = 0; i < count; i += 1 {
        let line, _ = file.Line(i)
        lines.push("line " + strconv.Itoa(i) + " " + lexer.ByteList(line))
    }
    let text = file.Text()
    var locations = Array<string>{}
    var boundaries = Array<int>{}
    for var offset = 0; offset <= text.len(); offset += 1 {
        let line, column, ok = file.Location(offset)
        if ok {
            locations.push(strconv.Itoa(line) + ":" + strconv.Itoa(column))
            boundaries.push(offset)
        } else {
            locations.push("-")
        }
    }
    lines.push("loc " + strings.Join(locations[:], " "))
    let n = boundaries.len()
    var d = diagnostic.Error("probe", file, boundaries[n / 3], boundaries[2 * n / 3])
    d.SetPrimaryMessage("here")
    d.AddRelated(file, boundaries[0], boundaries[n - 1], "there")
    d.AddNote("probe note")
    describe(lines, d)
}

func retainedDiagnostic() diagnostic.Diagnostic {
    let first = source.NewFile("same.ore", "first")
    let second = source.NewFile("same.ore", "second")
    let other = source.NewFile("other.ore", "third")
    var d = diagnostic.Error("identity", first, 0, 5)
    d.AddRelated(second, 0, 6, "second file")
    d.AddRelated(other, 0, 5, "other file")
    return d
}

func identityProbe(lines mut Array<string>) {
    let unrelated = source.NewFile("same.ore", "wrong")
    describe(lines, retainedDiagnostic())
    let invalid = diagnostic.Error("invalid", unrelated, 0, 99)
    let _, ok = diagnostic.Render(invalid)
    if !ok { lines.push("invalid span rejected") }
    let empty = channel<source.File>()
    empty.close()
    let file, _ = empty.receive()
    let missing = diagnostic.Error("missing", file, 0, 0)
    let _, found = diagnostic.Render(missing)
    if !found { lines.push("empty file rejected") }
}
