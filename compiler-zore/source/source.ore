package source

type File struct {
    valid bool
    path string
    text string
    lines Mutex<Array<int>>
}

func NewFile(path string, text string) File {
    var starts = Array<int>{0}
    for var i = 0; i < text.len(); i += 1 {
        if text[i] == 10 {
            starts.push(i + 1)
        }
    }
    return File{valid: true, path: path, text: text, lines: mutex(starts)}
}

func (f File) Path() string { return f.path }
func (f File) Text() string { return f.text }

func (f File) LineCount() int {
    if !f.valid { return 0 }
    return f.lines.withLock(func(starts mut Array<int>) int { return starts.len() })
}

func (f File) IsBoundary(offset int) bool {
    if !f.valid || offset < 0 || offset > f.text.len() {
        return false
    }
    return offset == f.text.len() || f.text[offset] & 0xC0 != 0x80
}

func (f File) Contains(start int, end int) bool {
    return start <= end && f.IsBoundary(start) && f.IsBoundary(end)
}

func (f File) Line(zeroBased int) (string, bool) {
    if !f.valid { return "", false }
    let text = f.text
    return f.lines.withLock(func(starts mut Array<int>) (string, bool) {
        if zeroBased < 0 || zeroBased >= starts.len() {
            return "", false
        }
        var end = text.len()
        if zeroBased + 1 < starts.len() {
            end = starts[zeroBased + 1]
        }
        let start = starts[zeroBased]
        if end > start && text[end - 1] == 10 {
            end -= 1
            if end > start && text[end - 1] == 13 {
                end -= 1
            }
        }
        return text[start:end], true
    })
}

func (f File) Location(offset int) (int, int, bool) {
    if !f.IsBoundary(offset) {
        return 0, 0, false
    }
    let text = f.text
    return f.lines.withLock(func(starts mut Array<int>) (int, int, bool) {
        var low = 0
        var high = starts.len()
        for low < high {
            let middle = (low + high) / 2
            if starts[middle] <= offset {
                low = middle + 1
            } else {
                high = middle
            }
        }
        let line = low - 1
        var column = 1
        for var i = starts[line]; i < offset; i += 1 {
            if text[i] & 0xC0 != 0x80 {
                column += 1
            }
        }
        return line + 1, column, true
    })
}
