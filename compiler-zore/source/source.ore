package source

type File struct {
    valid bool
    path string
    text string
}

func NewFile(path string, text string) File {
    return File{valid: true, path: path, text: text}
}

func (f File) Path() string { return f.path }
func (f File) Text() string { return f.text }

func (f File) LineCount() int {
    if !f.valid { return 0 }
    var count = 1
    for var i = 0; i < f.text.len(); i += 1 {
        if f.text[i] == 10 {
            count += 1
        }
    }
    return count
}

func (f File) IsBoundary(offset int) bool {
    if !f.valid || offset < 0 || offset > f.text.len() {
        return false
    }
    return offset == f.text.len() || f.text[offset] & 0xC0 != 0x80
}

func (f File) Contains(start int, end int) bool {
    return start <= end && f.IsBoundary(start) && f.IsBoundary(end)
}

func (f File) Line(zeroBased int) (string, bool) {
    if !f.valid || zeroBased < 0 { return "", false }
    let text = f.text
    var start = 0
    var line = 0
    for line < zeroBased {
        if start == text.len() {
            return "", false
        }
        if text[start] == 10 {
            line += 1
        }
        start += 1
    }
    var end = start
    for end < text.len() && text[end] != 10 {
        end += 1
    }
    if end < text.len() && end > start && text[end - 1] == 13 {
        end -= 1
    }
    return text[start:end], true
}

func (f File) Location(offset int) (int, int, bool) {
    if !f.IsBoundary(offset) {
        return 0, 0, false
    }
    var line = 1
    var column = 1
    for var i = 0; i < offset; i += 1 {
        if f.text[i] == 10 {
            line += 1
            column = 1
        } else if f.text[i] & 0xC0 != 0x80 {
            column += 1
        }
    }
    return line, column, true
}
