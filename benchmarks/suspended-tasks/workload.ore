package main

import "zore/bufio"
import "zore/os"
import "zore/strconv"

async func wait(ready channel<bool>, release channel<bool>) int {
    ready.send(true)
    let _, ok = release.receive()
    if !ok { return 0 }
    return 1
}

func main() {
    var input = bufio.NewScanner(os.Stdin())
    if !input.Scan() { return }
    let count, parseError = strconv.Atoi(input.Text())
    if parseError != nil || count < 1 { return }

    let ready = channel<bool>()
    let release = channel<bool>()
    var tasks = Array<Task<int>>{}
    for var i = 0; i < count; i += 1 {
        tasks.push(go wait(ready, release))
    }
    for var i = 0; i < count; i += 1 {
        let _, _ = ready.receive()
    }
    println("READY " + strconv.Itoa(count))

    if !input.Scan() || input.Text() != "release" { return }
    for var i = 0; i < count; i += 1 {
        release.send(true)
    }

    var completed = 0
    for tasks.len() > 0 {
        let found, task = tasks.pop()
        if found { completed += task.wait() }
    }
    println("DONE " + strconv.Itoa(completed))
}
