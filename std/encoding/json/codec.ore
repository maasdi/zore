package json

import "std/math"
import "std/sort"
import "std/strconv"
import "std/strings"

type Naming int
const AsWritten Naming = 0
const LowerCamel Naming = 1
const SnakeCase Naming = 2

type Marshaler interface { EncodeJSON(e mut Encoder) }
type Unmarshaler interface { mut DecodeJSON(d mut Decoder) error }
type Optional<T any> struct { Value T; Set bool }
func Some<T any>(value own T) Optional<T> { return Optional<T>{Value: value, Set: true} }

func encode<T any>(value T, e mut Encoder, naming Naming)
func decode<T any>(value mut T, d mut Decoder, naming Naming) error

func checkNaming(naming Naming) error {
    if naming != AsWritten && naming != LowerCamel && naming != SnakeCase { return error("json: invalid naming policy") }
    return nil
}
func Marshal<T any>(value T) (Array<byte>, error) { return MarshalWith(value, AsWritten) }
func MarshalWith<T any>(value T, naming Naming) (Array<byte>, error) { return MarshalIndent(value, naming, "") }
func MarshalIndent<T any>(value T, naming Naming, indent string) (Array<byte>, error) {
    checkNaming(naming)?
    var encoder = NewEncoder()
    encoder.SetIndent(indent)
    encode(value, encoder, naming)
    return encoder.Finish()
}
func Unmarshal<T any>(data []byte, value mut T) error { return UnmarshalWith(data, value, AsWritten) }
func UnmarshalWith<T any>(data []byte, value mut T, naming Naming) error {
    checkNaming(naming)?
    var decoder = NewDecoder(data)
    decode(value, decoder, naming)?
    return decoder.Finish()
}
func UnmarshalStrict<T any>(data []byte, value mut T, naming Naming) error {
    checkNaming(naming)?
    var decoder = NewDecoder(data)
    decoder.DisallowUnknownFields()
    decode(value, decoder, naming)?
    return decoder.Finish()
}
func fieldIndex(key string, names []string) int {
    for var i = 0; i < names.len(); i += 1 { if key == names[i] { return i } }
    for var i = 0; i < names.len(); i += 1 { if strings.EqualFold(key, names[i]) { return i } }
    return -1
}
func (d mut Decoder) unknown(key string) error {
    if d.strict { return d.fail("unknown field " + strconv.Quote(key)) }
    return d.Skip()
}
func unsignedText(value uint64) string {
    if value == 0 { return "0" }
    let digits = "0123456789"
    var remaining = value
    var result = ""
    for remaining > 0 {
        result = string(rune(digits[int(remaining % 10)])) + result
        remaining /= 10
    }
    return result
}
func (e mut Encoder) unsigned(value uint64) { if e.beforeValue() { e.append(unsignedText(value)) } }
func (e mut Encoder) floatWidth(value float64, bits int) {
    if math.IsNaN(value) || math.IsInf(value, 0) { e.fail("non-finite number"); return }
    if e.beforeValue() { e.append(strconv.FormatFloat(value, 'g', -1, bits)) }
}
func (d mut Decoder) signed(bits int) (int64, error) {
    let text = d.number()?
    let result, err = strconv.ParseInt(text, 10, bits)
    if err != nil { return 0, d.fail("integer outside target range") }
    return int64(result), nil
}
func parseUnsigned(text string, bits int) (uint64, error) {
    var maximum = uint64(18446744073709551615)
    if bits < 64 { maximum = (uint64(1) << bits) - 1 }
    var result = uint64(0)
    if text.len() == 0 { return 0, error("json: expected unsigned integer") }
    for var i = 0; i < text.len(); i += 1 {
        if !digit(text[i]) { return 0, error("json: expected unsigned integer") }
        let next = uint64(text[i] - 48)
        if result > maximum / 10 || (result == maximum / 10 && next > maximum % 10) { return 0, error("json: integer outside target range") }
        result = result * 10 + next
    }
    return result, nil
}
func (d mut Decoder) unsigned(bits int) (uint64, error) {
    let text = d.number()?
    let result, err = parseUnsigned(text, bits)
    if err != nil { return 0, d.fail("unsigned integer outside target range") }
    return result, nil
}
func (d mut Decoder) floatWidth(bits int) (float64, error) {
    let text = d.number()?
    let result, err = strconv.ParseFloat(text, bits)
    if err != nil || math.IsInf(result, 0) { return 0, d.fail("number outside target float range") }
    return result, nil
}
func (d mut Decoder) signedKey(key string, bits int) (int64, error) {
    let result, err = strconv.ParseInt(key, 10, bits)
    if err != nil || strconv.Itoa(result) != key { return 0, d.fail("invalid integer object key") }
    return int64(result), nil
}
func (d mut Decoder) unsignedKey(key string, bits int) (uint64, error) {
    let result, err = parseUnsigned(key, bits)
    if err != nil || unsignedText(result) != key { return 0, d.fail("invalid unsigned integer object key") }
    return result, nil
}
func sortedNames(names own Array<string>) Array<string> {
    var result = names
    sort.Strings(result[:])
    return result
}
