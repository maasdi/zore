package regexp

const MaxPatternBytes = 4096
const MaxInputBytes = 1048576
const MaxOutputBytes = 1048576
const MaxCaptures = 16
const MaxStates = 4096
const MaxMatches = 1024
const MaxWork = 16777216

type Regexp struct {
    id int
    groups int
}

func (r mut Regexp) drop() {
    release(r.id)
}

func Compile(pattern string) (Regexp, error) {
    let id, err = compile(pattern)
    if err != nil {
        return Regexp{id: 0, groups: 0}, err
    }
    return Regexp{id: id, groups: groupCount(id)}, nil
}

func (r Regexp) Share() (Regexp, error) {
    let id, err = share(r.id)
    if err != nil {
        return Regexp{id: 0, groups: 0}, err
    }
    return Regexp{id: id, groups: r.groups}, nil
}

type Span struct {
    Start int
    End int
}

func (s Span) Matched() bool {
    return s.Start >= 0
}

type Match struct {
    Start int
    End int
    Groups Array<Span>
}

func absent() Match {
    return Match{Start: -1, End: -1, Groups: Array<Span>{}}
}

func unpack(values []int, at int, groups int) Match {
    var captures = Array<Span>{}
    for var group = 0; group < groups; group += 1 {
        let offset = at + 2 + group * 2
        captures.push(Span{Start: values[offset], End: values[offset + 1]})
    }
    return Match{Start: values[at], End: values[at + 1], Groups: captures}
}

func (r Regexp) Match(text string) (bool, error) {
    let values, err = search(r.id, text, 1, "regexp.Match")
    return values.len() != 0, err
}

func (r Regexp) Find(text string) (Match, bool, error) {
    let values, err = search(r.id, text, 1, "regexp.Find")
    if err != nil {
        return absent(), false, err
    }
    if values.len() == 0 {
        return absent(), false, nil
    }
    return unpack(values[:], 0, r.groups), true, nil
}

func (r Regexp) FindAll(text string, limit int) (Array<Match>, error) {
    let values, err = search(r.id, text, limit, "regexp.FindAll")
    var found = Array<Match>{}
    if err != nil {
        return found, err
    }
    let width = (r.groups + 1) * 2
    for var at = 0; at < values.len(); at += width {
        found.push(unpack(values[:], at, r.groups))
    }
    return found, nil
}

func (r Regexp) ReplaceAll(text string, replacement string) (string, error) {
    return replace(r.id, text, replacement, false)
}

func (r Regexp) ReplaceAllLiteral(text string, replacement string) (string, error) {
    return replace(r.id, text, replacement, true)
}

func compile(pattern string) (int, error)

func groupCount(id int) int

func share(id int) (int, error)

func release(id int)

func search(id int, text string, limit int, operation string) (Array<int>, error)

func replace(id int, text string, replacement string, literal bool) (string, error)
