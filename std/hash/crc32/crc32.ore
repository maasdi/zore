package crc32

func UpdateByte(crc uint32, octet byte) uint32 {
    var value = crc ^ uint32(0xffffffff) ^ uint32(octet)
    for var bit = 0; bit < 8; bit += 1 {
        if value & 1 != 0 {
            value = (value >> 1) ^ uint32(0xedb88320)
        } else {
            value >>= 1
        }
    }
    return value ^ uint32(0xffffffff)
}

func Update(crc uint32, data []byte) uint32 {
    var value = crc
    for octet in data {
        value = UpdateByte(value, octet)
    }
    return value
}

func Checksum(data []byte) uint32 {
    return Update(0, data)
}
