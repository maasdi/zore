package context

import "std/time"

const active = 0
const canceled = 1
const expired = 2

type cancellationState struct {
    reason int
    revision int
}

type ancestor struct {
    state Mutex<cancellationState>
    parents Mutex<Array<ancestor>>
}

type Context struct {
    done channel<bool>
    state Mutex<cancellationState>
    parents Mutex<Array<ancestor>>
    revision Mutex<int>
    live bool
    deadline int
    limited bool
}

func Background() Context {
    return Context{done: channel<bool>(), state: mutex(cancellationState{reason: active, revision: 0}), parents: mutex(Array<ancestor>{}), revision: mutex(0), live: false, deadline: 0, limited: false}
}

func TODO() Context {
    return Background()
}

func WithCancel(parent Context) (Context, func()) {
    let ctx = derive(parent, parent.deadline, parent.limited)
    return ctx, func() {
        ctx.cancel(canceled)
    }
}

func WithCancelOn(parent Context, done channel<bool>) (Context, func()) {
    let ctx = derive(parent, parent.deadline, parent.limited)
    go cancelOn(ctx, done)
    return ctx, func() { ctx.cancel(canceled) }
}

async func cancelOn(ctx Context, done channel<bool>) {
    select {
        case done.receive() { ctx.cancel(canceled) }
        case ctx.Done().receive() {}
    }
}

func WithTimeout(parent Context, timeout int) (Context, func()) {
    return WithDeadline(parent, time.Now() + timeout)
}

func WithDeadline(parent Context, deadline int) (Context, func()) {
    var at = deadline
    if parent.limited && parent.deadline < at {
        at = parent.deadline
    }
    let ctx = derive(parent, at, true)
    if time.Now() >= at {
        ctx.cancel(expired)
    } else {
        go expire(ctx, at)
    }
    return ctx, func() {
        ctx.cancel(canceled)
    }
}

func (c Context) Done() channel<bool> {
    return c.done
}

func (c Context) Err() error {
    let reason = c.reason()
    if reason == canceled {
        return error("context canceled")
    }
    if reason == expired {
        return error("context deadline exceeded")
    }
    return nil
}

func (c Context) Deadline() (int, bool) {
    return c.deadline, c.limited
}

func derive(parent Context, deadline int, limited bool) Context {
    // Snapshot first so a racing cancellation cannot validate an active child.
    let revision = parent.revision.withLock(func(value mut int) int {
        return value
    })
    let inherited = parent.reason()
    var parents = Array<ancestor>{}
    if parent.live && inherited == active {
        parents.push(ancestor{state: parent.state, parents: parent.parents})
    }
    let ctx = Context{done: channel<bool>(), state: mutex(cancellationState{reason: active, revision: revision}), parents: mutex(parents), revision: parent.revision, live: true, deadline: deadline, limited: limited}
    if inherited != active {
        ctx.cancel(inherited)
    } else if parent.live {
        go follow(parent, ctx)
    }
    return ctx
}

func (c Context) reason() int {
    let revision = c.revision.withLock(func(value mut int) int {
        return value
    })
    let local = c.state.withLock(func(state mut cancellationState) cancellationState {
        return state
    })
    if local.reason != active || local.revision == revision {
        return local.reason
    }
    var current = ancestor{state: c.state, parents: c.parents}
    for {
        let parent, found = current.parents.withLock(func(parents mut Array<ancestor>) (ancestor, bool) {
            if parents.len() == 0 {
                return current, false
            }
            return parents[0], true
        })
        let inherited = parent.state.withLock(func(state mut cancellationState) cancellationState {
            return state
        })
        if inherited.reason != active {
            c.cancel(inherited.reason)
            return c.state.withLock(func(state mut cancellationState) int {
                return state.reason
            })
        }
        if !found || inherited.revision == revision {
            break
        }
        current = parent
    }
    return c.state.withLock(func(state mut cancellationState) int {
        if state.reason == active {
            state.revision = revision
        }
        return state.reason
    })
}

func (c Context) cancel(reason int) {
    let first = c.state.withLock(func(state mut cancellationState) bool {
        if state.reason != active {
            return false
        }
        state.reason = reason
        return true
    })
    if first {
        c.revision.withLock(func(value mut int) {
            value += 1
        })
        c.parents.withLock(func(parents mut Array<ancestor>) {
            parents = Array<ancestor>{}
        })
        c.done.close()
    }
}

async func follow(parent Context, child Context) {
    select {
        case parent.done.receive() {
            child.cancel(parent.reason())
        }
        case child.done.receive() {
        }
    }
}

async func expire(ctx Context, deadline int) {
    if waitUntil(ctx.done, deadline) {
        ctx.cancel(expired)
    }
}

func waitUntil(done channel<bool>, deadline int) bool
