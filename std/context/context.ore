package context

import "std/time"

const active = 0
const canceled = 1
const expired = 2

type Context struct {
    done      channel<bool>
    state     Mutex<int>
    ancestors Mutex<Array<Mutex<int>>>
    live      bool
    deadline  int
    limited   bool
}

func Background() Context {
    return Context{done: channel<bool>(), state: mutex(active), ancestors: mutex(Array<Mutex<int>>{}), live: false, deadline: 0, limited: false}
}

func TODO() Context {
    return Background()
}

func WithCancel(parent Context) (Context, func()) {
    let ctx = derive(parent, parent.deadline, parent.limited)
    return ctx, func() {
        ctx.cancel(canceled)
    }
}

func WithCancelOn(parent Context, done channel<bool>) (Context, func()) {
    let ctx = derive(parent, parent.deadline, parent.limited)
    go cancelOn(ctx, done)
    return ctx, func() { ctx.cancel(canceled) }
}

async func cancelOn(ctx Context, done channel<bool>) {
    select {
        case done.receive() { ctx.cancel(canceled) }
        case ctx.Done().receive() {}
    }
}

func WithTimeout(parent Context, timeout int) (Context, func()) {
    return WithDeadline(parent, time.Now() + timeout)
}

func WithDeadline(parent Context, deadline int) (Context, func()) {
    var at = deadline
    if parent.limited && parent.deadline < at {
        at = parent.deadline
    }
    let ctx = derive(parent, at, true)
    if time.Now() >= at {
        ctx.cancel(expired)
    } else {
        go expire(ctx, at)
    }
    return ctx, func() {
        ctx.cancel(canceled)
    }
}

func (c Context) Done() channel<bool> {
    return c.done
}

func (c Context) Err() error {
    let reason = c.reason()
    if reason == canceled {
        return error("context canceled")
    }
    if reason == expired {
        return error("context deadline exceeded")
    }
    return nil
}

func (c Context) Deadline() (int, bool) {
    return c.deadline, c.limited
}

func derive(parent Context, deadline int, limited bool) Context {
    let ancestors = parent.ancestors.withLock(func(states mut Array<Mutex<int>>) Array<Mutex<int>> {
        var lineage = Array<Mutex<int>>{parent.state}
        for state in states {
            lineage.push(state)
        }
        return lineage
    })
    let ctx = Context{done: channel<bool>(), state: mutex(active), ancestors: mutex(ancestors), live: true, deadline: deadline, limited: limited}
    if parent.live {
        let inherited = parent.reason()
        if inherited != active {
            ctx.cancel(inherited)
        } else {
            go follow(parent, ctx)
        }
    }
    return ctx
}

func (c Context) reason() int {
    let inherited = c.ancestors.withLock(func(states mut Array<Mutex<int>>) int {
        for ancestor in states {
            let reason = ancestor.withLock(func(state mut int) int {
                return state
            })
            if reason != active {
                return reason
            }
        }
        return active
    })
    if inherited != active {
        c.cancel(inherited)
    }
    return c.state.withLock(func(state mut int) int {
        return state
    })
}

func (c Context) cancel(reason int) {
    let first = c.state.withLock(func(state mut int) bool {
        if state != active {
            return false
        }
        state = reason
        return true
    })
    if first {
        c.done.close()
    }
}

async func follow(parent Context, child Context) {
    select {
        case parent.done.receive() {
            child.cancel(parent.reason())
        }
        case child.done.receive() {
        }
    }
}

async func expire(ctx Context, deadline int) {
    if waitUntil(ctx.done, deadline) {
        ctx.cancel(expired)
    }
}

func waitUntil(done channel<bool>, deadline int) bool
