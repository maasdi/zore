package filepath

import "zore/os"
import "zore/path"

const Separator = '/'
const ListSeparator = ':'

func Clean(p string) string {
    return path.Clean(p)
}

func Join(elems []string) string {
    return path.Join(elems)
}

func Split(p string) (string, string) {
    return path.Split(p)
}

func Base(p string) string {
    return path.Base(p)
}

func Dir(p string) string {
    return path.Dir(p)
}

func Ext(p string) string {
    return path.Ext(p)
}

func IsAbs(p string) bool {
    return path.IsAbs(p)
}

func Abs(p string) (string, error) {
    if IsAbs(p) {
        return Clean(p), nil
    }
    let dir, err = os.Getwd()
    if err != nil {
        return "", err
    }
    return Join(Array<string>{dir, p}[:]), nil
}
