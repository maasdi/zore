package path

import "std/strings"
import "std/unicode"

func Clean(p string) string {
    if p.len() == 0 {
        return "."
    }
    let rooted = p[0] == 47
    var parts = Array<string>{}
    var start = 0
    for var i = 0; i <= p.len(); i += 1 {
        if i < p.len() && p[i] != 47 {
            continue
        }
        let part = p[start:i]
        start = i + 1
        if part.len() == 0 || part == "." {
            continue
        }
        if part != ".." {
            parts.push(part)
        } else if parts.len() > 0 && parts[parts.len() - 1] != ".." {
            parts.pop()
        } else if !rooted {
            parts.push(part)
        }
    }
    let joined = strings.Join(parts[:], "/")
    if rooted {
        return "/" + joined
    }
    if joined.len() == 0 {
        return "."
    }
    return joined
}

func Join(elems []string) string {
    var parts = Array<string>{}
    for elem in elems {
        if elem.len() > 0 {
            parts.push(elem)
        }
    }
    if parts.len() == 0 {
        return ""
    }
    return Clean(strings.Join(parts[:], "/"))
}

func Split(p string) (string, string) {
    let slash = strings.LastIndex(p, "/")
    return p[:slash + 1], p[slash + 1:]
}

func Base(p string) string {
    if p.len() == 0 {
        return "."
    }
    var end = p.len()
    for end > 0 && p[end - 1] == 47 {
        end -= 1
    }
    if end == 0 {
        return "/"
    }
    let trimmed = p[:end]
    return trimmed[strings.LastIndex(trimmed, "/") + 1:]
}

func Dir(p string) string {
    let dir, _ = Split(p)
    return Clean(dir)
}

func Ext(p string) string {
    for var i = p.len() - 1; i >= 0 && p[i] != 47; i -= 1 {
        if p[i] == 46 {
            return p[i:]
        }
    }
    return ""
}

func IsAbs(p string) bool {
    return strings.HasPrefix(p, "/")
}

func device(component string) bool {
    var stem = strings.ToUpper(component)
    let dot = strings.Index(stem, ".")
    if dot >= 0 {
        stem = stem[:dot]
    }
    stem = strings.TrimRight(stem, " .")
    if stem == "CON" || stem == "PRN" || stem == "AUX" || stem == "NUL" || stem == "CONIN$" || stem == "CONOUT$" || stem == "CLOCK$" {
        return true
    }
    if strings.HasPrefix(stem, "COM") || strings.HasPrefix(stem, "LPT") {
        let suffix = stem[3:]
        if suffix.len() == 1 && suffix[0] >= 49 && suffix[0] <= 57 {
            return true
        }
        if suffix == "¹" || suffix == "²" || suffix == "³" {
            return true
        }
    }
    return false
}

func IsLocal(name string) bool {
    if name.len() == 0 || name[0] == 47 {
        return false
    }
    for _, point in name {
        if unicode.IsControl(point) {
            return false
        }
    }
    let end = name.len()
    var start = 0
    for var i = 0; i <= end; i += 1 {
        if i < end {
            let value = name[i]
            if value == 92 || value == 58 || value == 34 || value == 60 || value == 62 || value == 124 || value == 63 || value == 42 {
                return false
            }
            if value != 47 {
                continue
            }
        }
        let component = name[start:i]
        if component == "" || component == "." || component == ".." {
            return false
        }
        if component[component.len() - 1] == 32 || component[component.len() - 1] == 46 || device(component) {
            return false
        }
        start = i + 1
    }
    return true
}
