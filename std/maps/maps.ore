package maps

func Keys<K comparable, V any>(m map[K]V) Array<K> {
    var keys = Array<K>{}
    for key, _ in m {
        keys.push(key)
    }
    return keys
}

func Values<K comparable, V copyable>(m map[K]V) Array<V> {
    var values = Array<V>{}
    for _, value in m {
        values.push(value)
    }
    return values
}

func Clone<K comparable, V copyable>(m map[K]V) map[K]V {
    var out = map[K]V{}
    for key, value in m {
        out[key] = value
    }
    return out
}
