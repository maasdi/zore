package cancel

import "zore/time"

type Token struct {
    done channel<bool>
    state Mutex<bool>
}

func New() Token {
    return Token{done: channel<bool>(), state: mutex(false)}
}

func WithTimeout(milliseconds int) Token {
    let token = New()
    go expire(token, milliseconds)
    return token
}

async func expire(token Token, milliseconds int) {
    time.Sleep(milliseconds)
    token.Cancel()
}

func (t Token) Cancel() {
    let first = t.state.withLock(func(cancelled mut bool) bool {
        if cancelled {
            return false
        }
        cancelled = true
        return true
    })
    if first {
        t.done.close()
    }
}

func (t Token) Cancelled() bool {
    return t.state.withLock(func(cancelled mut bool) bool {
        return cancelled
    })
}

func (t Token) Done() channel<bool> {
    return t.done
}

func (t Token) Child() Token {
    let child = New()
    go follow(t, child)
    return child
}

async func follow(parent Token, child Token) {
    select {
        case parent.done.receive() {
            child.Cancel()
        }
        case child.done.receive() {
        }
    }
}

func (t Token) Sleep(milliseconds int) bool {
    select {
        case t.done.receive() {
            return false
        }
        case time.After(milliseconds).receive() {
            return true
        }
    }
}
