package http

import "std/net"
import "std/net/url"
import "std/context"
import "std/io"
import "std/strings"
import "std/strconv"
import "std/time"

type exchangeControl struct {
    committed bool
    continued bool
    failure error
}
type Request struct {
    conn []net.Conn
    server Server
    config Config
    control Mutex<exchangeControl>
    ctx context.Context
    method string
    target string
    path string
    query string
    host string
    headers Header
    params url.Values
    buffer Array<byte>
    position int
    deadline int
    writeDeadline int
    remaining int
    chunked bool
    chunkRemaining int
    chunkEnd bool
    done bool
    total int
    metadata int
    expect bool
    close bool
    failure error
    failureStatus int
    waiting bool
}
type ResponseWriter struct {
    conn []net.Conn
    server Server
    control Mutex<exchangeControl>
    headers Header
    deadline int
    poll int
    head bool
    close bool
    committed bool
    status int
    length int
    written int
    chunked bool
    failure error
}
func (r mut Request) drop() {}
func (w mut ResponseWriter) drop() {}
func (r Request) Method() string { return r.method }
func (r Request) Path() string { return r.path }
func (r Request) RawQuery() string { return r.query }
func (r Request) Target() string { return r.target }
func (r Request) Host() string { return r.host }
func (r Request) RemoteAddr() string {
    if r.conn.len() == 0 { return "" }
    return r.conn[0].RemoteAddr()
}
func (r Request) Headers() Header { return clone(r.headers) }
func (r Request) Query() (url.Values, error) { return url.ParseQuery(r.query) }
func (r Request) PathParam(name string) (string, bool) { return r.params.Get(name) }
func (r Request) Context() context.Context {
    if r.conn.len() == 0 { return context.Background() }
    return r.ctx
}
func (r Request) ContentLength() (int, bool) {
    let text, found = r.headers.Get(HeaderContentLength)
    if !found { return 0, false }
    let n, _ = decimal(text)
    return n, true
}
func (w ResponseWriter) Committed() bool { return w.committed }

func decimal(text string) (int, error) {
    if text == "" { return 0, error("http: invalid length") }
    var value = 0
    for var i = 0; i < text.len(); i += 1 {
        let digit = int(text[i]) - 48
        if digit < 0 || digit > 9 || value > (9223372036854775807 - digit) / 10 { return 0, error("http: invalid length") }
        value = value * 10 + digit
    }
    return value, nil
}

func deadlineAfter(now int, duration int) int {
    if duration > 9223372036854775807 - now { return 9223372036854775807 }
    return now + duration
}

func pollDeadline(deadline int, interval int) int {
    let now = time.Now()
    if deadline - now <= interval { return deadline }
    return now + interval
}

func writeAll(conn []net.Conn, server Server, data []byte, deadline int, interval int) error {
    let _, err = writeBytes(conn, server, data, deadline, interval)
    return err
}

func writeBytes(conn []net.Conn, server Server, data []byte, deadline int, interval int) (int, error) {
    if conn.len() == 0 { return 0, error("http: empty connection") }
    var position = 0
    for position < data.len() {
        if server.canceled() { return position, error("http: server canceled") }
        if time.Now() >= deadline { return position, error("http: write timed out") }
        let deadlineErr = conn[0].SetWriteDeadline(pollDeadline(deadline, interval))
        if deadlineErr != nil { return position, deadlineErr }
        let n, err = conn[0].Write(data[position:])
        position += n
        if err == error("net.Write: timed out") { continue }
        if err != nil { return position, err }
        if n == 0 { return position, error("http: write made no progress") }
    }
    return position, nil
}

func (r Request) readReady() error {
    if !r.waiting {
        let err = r.ctx.Err()
        if err != nil { return err }
    }
    if r.server.canceled() || (r.waiting && r.server.draining()) { return error("http: server draining") }
    if time.Now() >= r.deadline { return error("http: read timed out") }
    return nil
}

func (r mut Request) fill() error {
    r.readReady()?
    if r.position < r.buffer.len() { return nil }
    var data = Array<byte>{}
    for var i = 0; i < 4096; i += 1 { data.push(0) }
    for {
        r.readReady()?
        r.conn[0].SetReadDeadline(pollDeadline(r.deadline, r.config.AcceptPollInterval))?
        let n, err = r.conn[0].Read(data[:])
        _ = err
        if n > 0 {
            r.buffer = Array<byte>{}
            for var i = 0; i < n; i += 1 { r.buffer.push(data[i]) }
            r.position = 0
            return nil
        }
        if err == error("net.Read: timed out") { continue }
        if err != nil { return err }
        return error("http: read made no progress")
    }
}

func (r mut Request) nextByte() (byte, error) {
    r.fill()?
    let value = r.buffer[r.position]
    r.position += 1
    return value, nil
}

type lineSource interface {
    mut nextByte() (byte, error)
}

func readLine(source mut lineSource, budget int, prefix string, overflow string, obsText bool) (string, int, error) {
    var data = Array<byte>{}
    var used = 0
    for {
        if used >= budget { return "", used, error(prefix + overflow) }
        let c = source.nextByte()?
        used += 1
        if c == 13 {
            if used >= budget { return "", used, error(prefix + overflow) }
            let lf = source.nextByte()?
            used += 1
            if lf != 10 { return "", used, error(prefix + "expected CRLF") }
            return lineText(data[:]), used, nil
        }
        if c == 10 || c == 0 || c == 127 || (c < 32 && c != 9) || (c > 127 && !obsText) { return "", used, error(prefix + "invalid line byte") }
        data.push(c)
    }
}

func lineText(data []byte) string {
    let text, err = strings.FromBytes(data)
    if err == nil { return text }
    var latin = ""
    for c in data { latin += string(rune(c)) }
    return latin
}

func (r mut Request) line() (string, error) {
    let budget = r.config.MaxHeaderBytes - r.metadata
    let text, used, err = readLine(r, budget, "http: ", "metadata too large", false)
    r.metadata += used
    return text, err
}

func (r mut Request) fail(err error) error {
    _ = err
    if r.failure == nil {
        r.failure = err
        r.failureStatus = 400
        if err == error("http: body too large") { r.failureStatus = 413 }
        if err == error("http: read timed out") { r.failureStatus = 408 }
        r.close = true
        r.control.withLock(func(c mut exchangeControl) { c.failure = err })
    }
    return r.failure
}

func chunkSize(line string) (int, error) {
    let sizeText, extension, found = strings.Cut(line, ";")
    var text = sizeText
    if found { text = strings.TrimRight(sizeText, " \t") }
    if text == "" { return 0, error("http: invalid chunk size") }
    var size = 0
    for var i = 0; i < text.len(); i += 1 {
        let c = text[i]
        var digit = -1
        if c >= 48 && c <= 57 { digit = int(c) - 48 }
        if c >= 65 && c <= 70 { digit = int(c) - 55 }
        if c >= 97 && c <= 102 { digit = int(c) - 87 }
        if digit < 0 || size > (9223372036854775807 - digit) / 16 { return 0, error("http: invalid chunk size") }
        size = size * 16 + digit
    }
    if found && !validExtensions(extension) { return 0, error("http: invalid chunk extension") }
    return size, nil
}

func validExtensions(text string) bool {
    var i = 0
    for {
        for i < text.len() && (text[i] == 32 || text[i] == 9) { i += 1 }
        let start = i
        for i < text.len() && tokenByte(text[i]) { i += 1 }
        if i == start { return false }
        for i < text.len() && (text[i] == 32 || text[i] == 9) { i += 1 }
        if i == text.len() { return true }
        if text[i] == 61 {
            i += 1
            for i < text.len() && (text[i] == 32 || text[i] == 9) { i += 1 }
            if i == text.len() { return false }
            if text[i] == 34 {
                i += 1
                var closed = false
                for i < text.len() {
                    let c = text[i]
                    i += 1
                    if c == 34 { closed = true; break }
                    if c == 92 {
                        if i == text.len() { return false }
                        if (text[i] < 32 && text[i] != 9) || text[i] > 126 { return false }
                        i += 1
                    } else if (c < 32 && c != 9) || c > 126 { return false }
                }
                if !closed { return false }
            } else {
                let valueStart = i
                for i < text.len() && tokenByte(text[i]) { i += 1 }
                if valueStart == i { return false }
            }
        }
        for i < text.len() && (text[i] == 32 || text[i] == 9) { i += 1 }
        if i == text.len() { return true }
        if text[i] != 59 { return false }
        i += 1
        if i == text.len() { return false }
    }
}

func (r mut Request) Read(buf mut []byte) (int, error) {
    if r.conn.len() == 0 { return 0, error("http.Request.Read: empty request") }
    let committed = r.control.withLock(func(c mut exchangeControl) bool { return c.committed })
    if committed { return 0, error("http.Request.Read: response already started") }
    if r.failure != nil { return 0, r.failure }
    if buf.len() == 0 { return 0, nil }
    if r.done { return 0, io.EOF }
    if r.expect {
        let first = r.control.withLock(func(c mut exchangeControl) bool {
            if c.continued { return false }
            c.continued = true
            return true
        })
        if first {
            let err = writeAll(r.conn, r.server, strings.Bytes("HTTP/1.1 100 Continue\r\n\r\n")[:], r.writeDeadline, r.config.AcceptPollInterval)
            if err != nil { return 0, r.fail(err) }
        }
    }
    if r.chunked && r.chunkRemaining == 0 {
        if r.chunkEnd {
            let cr, crErr = r.nextByte()
            if crErr != nil { return 0, r.fail(crErr) }
            let lf, lfErr = r.nextByte()
            if lfErr != nil { return 0, r.fail(lfErr) }
            if cr != 13 || lf != 10 { return 0, r.fail(error("http: expected chunk CRLF")) }
        }
        let line, lineErr = r.line()
        if lineErr != nil { return 0, r.fail(lineErr) }
        let size, sizeErr = chunkSize(line)
        if sizeErr != nil { return 0, r.fail(sizeErr) }
        if size > r.config.MaxBodyBytes - r.total { return 0, r.fail(error("http: body too large")) }
        if size == 0 {
            let trailer, trailerErr = r.line()
            if trailerErr != nil { return 0, r.fail(trailerErr) }
            if trailer != "" { return 0, r.fail(error("http: trailers are unsupported")) }
            r.done = true
            return 0, io.EOF
        }
        r.chunkRemaining = size
        r.chunkEnd = true
    }
    var count = buf.len()
    if r.chunked {
        if count > r.chunkRemaining { count = r.chunkRemaining }
    } else if count > r.remaining { count = r.remaining }
    var copied = 0
    for copied < count {
        let err = r.fill()
        if err != nil { return copied, r.fail(err) }
        var available = r.buffer.len() - r.position
        if available > count - copied { available = count - copied }
        for var i = 0; i < available; i += 1 { buf[copied + i] = r.buffer[r.position + i] }
        r.position += available
        copied += available
        r.total += available
        if r.chunked { r.chunkRemaining -= available } else { r.remaining -= available }
    }
    if !r.chunked && r.remaining == 0 { r.done = true }
    return count, nil
}

func (w mut ResponseWriter) SetHeader(name string, value string) error {
    if w.conn.len() == 0 { return error("http: empty writer") }
    if w.committed { return error("http: response already started") }
    if strings.EqualFold(name, "Connection") || strings.EqualFold(name, "Transfer-Encoding") { return error("http: server owns framing header") }
    return w.headers.Set(name, value)
}
func (w mut ResponseWriter) AddHeader(name string, value string) error {
    if w.conn.len() == 0 { return error("http: empty writer") }
    if w.committed { return error("http: response already started") }
    if strings.EqualFold(name, "Connection") || strings.EqualFold(name, "Transfer-Encoding") { return error("http: server owns framing header") }
    return w.headers.Add(name, value)
}
func (w mut ResponseWriter) send(text string) error {
    let err = writeAll(w.conn, w.server, strings.Bytes(text)[:], w.deadline, w.poll)
    if err != nil { w.failure = err }
    return err
}
func (w mut ResponseWriter) WriteHeader(status int) error {
    if w.conn.len() == 0 { return error("http: empty writer") }
    if w.committed { return error("http: response already started") }
    let bodyFailure = w.control.withLock(func(c mut exchangeControl) error { return c.failure })
    if bodyFailure != nil { return bodyFailure }
    if status < 200 || status > 599 { return error("http: invalid response status") }
    let lengths = w.headers.Values(HeaderContentLength)
    if lengths.len() > 1 { return error("http: repeated content length") }
    var length = -1
    if lengths.len() == 1 { length = decimal(lengths[0])? }
    if status == 204 && length >= 0 { return error("http: 204 forbids content length") }
    if status == 205 {
        if length > 0 { return error("http: 205 requires zero length") }
        length = 0
        w.headers.Set(HeaderContentLength, "0")?
    }
    w.status = status
    w.length = length
    w.chunked = !w.head && status != 204 && status != 205 && status != 304 && length < 0
    w.headers.Set("Date", time.FormatHTTPDate(time.UnixSeconds())?)?
    var output = "HTTP/1.1 " + strconv.Itoa(status) + " " + StatusText(status) + "\r\n"
    let entries = w.headers.Entries()
    for entry in entries { output += entry.Name + ": " + entry.Value + "\r\n" }
    if w.chunked { output += "Transfer-Encoding: chunked\r\n" }
    if w.close || w.server.draining() { w.close = true; output += "Connection: close\r\n" }
    output += "\r\n"
    w.committed = true
    w.control.withLock(func(c mut exchangeControl) { c.committed = true })
    return w.send(output)
}
func (w mut ResponseWriter) Write(data []byte) (int, error) {
    if w.conn.len() == 0 { return 0, error("http: empty writer") }
    if w.failure != nil { return 0, w.failure }
    if data.len() == 0 { return 0, nil }
    if !w.committed { w.WriteHeader(200)? }
    if w.status == 204 || w.status == 205 || w.status == 304 { return 0, error("http: response forbids content") }
    if w.length >= 0 && data.len() > w.length - w.written { w.failure = error("http: content length overrun"); return 0, w.failure }
    if w.head { w.written += data.len(); return data.len(), nil }
    if w.chunked {
        let err = w.send(strconv.FormatInt(data.len(), 16) + "\r\n")
        if err != nil { return 0, err }
    }
    let n, err = writeBytes(w.conn, w.server, data, w.deadline, w.poll)
    w.written += n
    if err != nil { w.failure = err; return n, err }
    if w.chunked {
        let trailerErr = w.send("\r\n")
        if trailerErr != nil { return n, trailerErr }
    }
    return n, nil
}

func (w mut ResponseWriter) finish() error {
    if w.failure != nil { return w.failure }
    if !w.committed {
        let _, hasLength = w.headers.Get(HeaderContentLength)
        if !hasLength { w.headers.Set(HeaderContentLength, "0")? }
        w.WriteHeader(200)?
    }
    if w.chunked { return w.send("0\r\n\r\n") }
    if !w.head && w.status != 204 && w.status != 205 && w.status != 304 && w.length >= 0 && w.written != w.length { return error("http: content length underrun") }
    return nil
}
