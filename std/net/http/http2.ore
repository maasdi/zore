package http

import "std/context"
import "std/io"
import "std/net/http/hpack"
import "std/net/url"
import "std/strconv"
import "std/strings"
import "std/time"

type HTTP2Config struct {
    MaxStreams int
    StreamWindow int
    MaxWaiters int
}

type HTTP2Stats struct {
    Active int
    Waiting int
    Closed bool
}

type HTTP2Conn struct {
    work channel<h2Request>
    shared Mutex<h2Shared>
    config ClientConfig
    limits HTTP2Config
    live bool
}

type h2Request struct {
    ticket int
    wake bool
    fields Array<hpack.Field>
    body Array<byte>
    head bool
    done channel<h2Result>
    streamed bool
    pipe Mutex<h2Pipe>
    notify channel<bool>
    upload bool
    input Mutex<h2UploadInput>
    inputWake channel<bool>
}

type h2Pipe struct {
    data Array<byte>
    position int
    consumed int
    finished bool
    failure error
    trailers Header
}

func emptyH2Pipe() h2Pipe {
    return h2Pipe{data: Array<byte>{}, position: 0, consumed: 0, finished: false, failure: nil, trailers: NewHeader()}
}

type h2Result struct {
    response ClientResponse
    failure error
}

type h2Shared struct {
    closed bool
    closing bool
    failure error
    inFlight int
    queued int
    next int
    cancels Array<int>
    active int
    waiting int
}

func DefaultHTTP2Config() HTTP2Config {
    return HTTP2Config{MaxStreams: 32, StreamWindow: 262144, MaxWaiters: 256}
}

func http2Settings(config HTTP2Config) (HTTP2Config, error) {
    let defaults = DefaultHTTP2Config()
    if config.MaxStreams < 0 || config.StreamWindow < 0 || config.MaxWaiters < 0 {
        return defaults, error("http2: negative configuration")
    }
    var chosen = config
    if chosen.MaxStreams == 0 {
        chosen.MaxStreams = defaults.MaxStreams
    }
    if chosen.StreamWindow == 0 {
        chosen.StreamWindow = defaults.StreamWindow
    }
    if chosen.MaxWaiters == 0 {
        chosen.MaxWaiters = defaults.MaxWaiters
    }
    if chosen.MaxStreams > 1024 || chosen.MaxWaiters > 65536 || chosen.StreamWindow < 16384 || chosen.StreamWindow > 16777216 {
        return defaults, error("http2: configuration out of range")
    }
    return chosen, nil
}

func emptyH2Shared() h2Shared {
    return h2Shared{closed: true, closing: true, failure: nil, inFlight: 0, queued: 0, next: 0, cancels: Array<int>{}, active: 0, waiting: 0}
}

func emptyHTTP2Conn() HTTP2Conn {
    return HTTP2Conn{work: channel<h2Request>(1), shared: mutex(emptyH2Shared()), config: DefaultClientConfig(), limits: DefaultHTTP2Config(), live: false}
}

func (c Client) NewHTTP2Conn(conn own ClientConn, config HTTP2Config) (HTTP2Conn, error) {
    if !c.live {
        return emptyHTTP2Conn(), error("http.Client: empty client")
    }
    let limits, err = http2Settings(config)
    if err != nil {
        return emptyHTTP2Conn(), err
    }
    if c.config.MaxHeaderBytes > hpack.MaxListBytes {
        return emptyHTTP2Conn(), error("http2: header limit too large")
    }
    var state = emptyH2Shared()
    state.closed = false
    state.closing = false
    let work = channel<h2Request>(limits.MaxStreams + limits.MaxWaiters + 4)
    let shared = mutex(state)
    go h2Serve(conn, work, shared, c.config, limits)
    return HTTP2Conn{work: work, shared: shared, config: c.config, limits: limits, live: true}, nil
}

func (h HTTP2Conn) Stats() HTTP2Stats {
    if !h.live {
        return HTTP2Stats{Active: 0, Waiting: 0, Closed: true}
    }
    return h.shared.withLock(func(s mut h2Shared) HTTP2Stats {
        return HTTP2Stats{Active: s.active, Waiting: s.waiting, Closed: s.closed || s.closing}
    })
}

func (h HTTP2Conn) Close() {
    if !h.live {
        return
    }
    let work = h.work
    let room = h.limits.MaxStreams + h.limits.MaxWaiters + 2
    h.shared.withLock(func(s mut h2Shared) {
        if s.closed || s.closing {
            return
        }
        s.closing = true
        if s.queued < room {
            s.queued += 1
            work.send(h2Wake())
        }
    })
}

func h2Wake() h2Request {
    return h2Request{ticket: 0, wake: true, fields: Array<hpack.Field>{}, body: Array<byte>{}, head: false, done: channel<h2Result>(1), streamed: false, pipe: mutex(emptyH2Pipe()), notify: channel<bool>(1), upload: false, input: mutex(emptyH2UploadInput()), inputWake: channel<bool>(1)}
}

func (h HTTP2Conn) requestFields(method string, absoluteURL string, headers Header, length int) (Array<hpack.Field>, error) {
    var declared = length
    if declared == 0 {
        declared = -1
    }
    return h.requestFieldsLimit(method, absoluteURL, headers, declared, h.config.MaxRequestBodyBytes)
}

func (h HTTP2Conn) requestFieldsLimit(method string, absoluteURL string, headers Header, length int, limit int) (Array<hpack.Field>, error) {
    var fields = Array<hpack.Field>{}
    if !token(method) || asciiEqual(method, "CONNECT") || asciiEqual(method, "TRACE") {
        return fields, error("http.Client: unsupported or invalid method")
    }
    let target, urlErr = url.ParseAbsolute(absoluteURL)
    if urlErr != nil {
        return fields, urlErr
    }
    if length > limit {
        return fields, error("http.Client: request body too large")
    }
    fields.push(hpack.Field{Name: ":method", Value: method, Sensitive: false})
    fields.push(hpack.Field{Name: ":scheme", Value: target.Scheme, Sensitive: false})
    fields.push(hpack.Field{Name: ":authority", Value: target.Authority, Sensitive: false})
    fields.push(hpack.Field{Name: ":path", Value: target.RequestTarget, Sensitive: false})
    if length >= 0 {
        fields.push(hpack.Field{Name: "content-length", Value: strconv.Itoa(length), Sensitive: false})
    }
    var size = 0
    for field in fields {
        size += field.Name.len() + field.Value.len() + 32
    }
    for entry in headers.entries {
        if !token(entry.Name) || !fieldValue(entry.Value) {
            return Array<hpack.Field>{}, error("http.Client: invalid header " + strconv.Quote(entry.Name))
        }
        if clientControlled(entry.Name) || asciiEqual(entry.Name, "TE") || asciiEqual(entry.Name, "Keep-Alive") {
            return Array<hpack.Field>{}, error("http.Client: client owns transport header")
        }
        size += entry.Name.len() + entry.Value.len() + 32
        if size > h.config.MaxHeaderBytes {
            return Array<hpack.Field>{}, error("http.Client: metadata too large")
        }
        fields.push(hpack.Field{Name: strings.ToLower(entry.Name), Value: entry.Value, Sensitive: false})
    }
    if size > h.config.MaxHeaderBytes {
        return Array<hpack.Field>{}, error("http.Client: metadata too large")
    }
    return fields, nil
}

func (h HTTP2Conn) Do(ctx context.Context, method string, absoluteURL string, headers Header, body []byte) (ClientResponse, error) {
    let bounded, cancel = context.WithDeadline(ctx, time.Now().Add(h.config.Timeout))
    let guard = clientCancellation{cancel: cancel}
    let response, _, err = h.submit(bounded, method, absoluteURL, headers, body, false, mutex(emptyH2Pipe()), channel<bool>(1))
    return response, err
}

func (h HTTP2Conn) Open(ctx context.Context, method string, absoluteURL string, headers Header, body []byte, config StreamConfig) (ResponseStream, error) {
    let settings = streamSettings(config)?
    let streamCtx, stops = streamContext(ctx, settings.Timeout)
    let headerCtx, cancel = context.WithDeadline(streamCtx, time.Now().Add(h.config.Timeout))
    let guard = clientCancellation{cancel: cancel}
    let pipe = mutex(emptyH2Pipe())
    let wake = channel<bool>(1)
    let response, ticket, err = h.submit(headerCtx, method, absoluteURL, headers, body, true, pipe, wake)
    if err != nil {
        return emptyResponseStream(), err
    }
    var result = emptyResponseStream()
    result.status = response.StatusCode
    result.headers = response.Headers
    result.limit = settings.MaxBodyBytes
    result.idle = settings.IdleTimeout
    result.stops = stops
    result.h2.push(h2Reader{conn: h, ticket: ticket, pipe: pipe, wake: wake, ctx: streamCtx, settled: false})
    let length, declared = result.headers.Get("content-length")
    if declared {
        let size, sizeErr = decimal(length)
        if sizeErr == nil && size > result.limit {
            return emptyResponseStream(), result.failHTTP2(error("http.Client: body too large"))
        }
        if sizeErr == nil && size > 0 && result.status == 205 {
            return emptyResponseStream(), result.failHTTP2(error("http.Client: 205 forbids content"))
        }
        _ = sizeErr
    }
    let ended, trailers = pipe.withLock(func(p mut h2Pipe) (bool, Header) {
        return p.finished && p.data.len() == 0 && p.failure == nil, clone(p.trailers)
    })
    if ended {
        result.done = true
        result.trailers = trailers
        result.h2[0].settled = true
        result.release()
    }
    return result, nil
}

func (h HTTP2Conn) release() {
    h.shared.withLock(func(s mut h2Shared) {
        s.inFlight -= 1
    })
}

func (h HTTP2Conn) abandon(ticket int) {
    let work = h.work
    let limit = h.limits.MaxStreams + h.limits.MaxWaiters
    h.shared.withLock(func(s mut h2Shared) {
        if !s.closed {
            s.cancels.push(ticket)
            if s.queued < limit + 2 {
                s.queued += 1
                work.send(h2Wake())
            }
        }
    })
}

func (h HTTP2Conn) submit(ctx context.Context, method string, absoluteURL string, headers Header, body []byte, streamed bool, pipe Mutex<h2Pipe>, wake channel<bool>) (ClientResponse, int, error) {
    if !h.live {
        return emptyClientResponse(), 0, error("http2: closed connection")
    }
    let fields, fieldsErr = h.requestFields(method, absoluteURL, headers, body.len())
    if fieldsErr != nil {
        return emptyClientResponse(), 0, fieldsErr
    }
    let contextErr = clientContextError(ctx)
    if contextErr != nil {
        return emptyClientResponse(), 0, contextErr
    }
    var payload = Array<byte>{}
    for value in body {
        payload.push(value)
    }
    let done = channel<h2Result>(1)
    let ticket, admitErr = h.enqueue(h2Request{ticket: 0, wake: false, fields: fields, body: payload, head: method == "HEAD", done: done, streamed: streamed, pipe: pipe, notify: wake, upload: false, input: mutex(emptyH2UploadInput()), inputWake: channel<bool>(1)})
    if admitErr != nil {
        return emptyClientResponse(), 0, admitErr
    }
    select {
        case let result, _ = done.receive() {
            if !streamed || result.failure != nil {
                h.release()
            }
            return result.response, ticket, result.failure
        }
        case ctx.Done().receive() {
            h.release()
            h.abandon(ticket)
            return emptyClientResponse(), 0, h2Reason(ctx.Err(), error("context deadline exceeded"))
        }
    }
}

type h2Reader struct {
    conn HTTP2Conn
    ticket int
    pipe Mutex<h2Pipe>
    wake channel<bool>
    ctx context.Context
    settled bool
}

func (r mut h2Reader) drop() {
    if !r.settled {
        r.settled = true
        r.conn.abandon(r.ticket)
    }
    r.conn.release()
}

func (r mut ResponseStream) readHTTP2(buf mut []byte) (int, error) {
    if buf.len() == 0 {
        return 0, nil
    }
    for {
        var room = buf.len()
        if r.limit - r.total < room {
            room = r.limit - r.total
        }
        let chunk, waiting, finished, trailers, failure = r.h2[0].pipe.withLock(func(p mut h2Pipe) (Array<byte>, bool, bool, Header, error) {
            var taken = Array<byte>{}
            for taken.len() < room && p.position < p.data.len() {
                taken.push(p.data[p.position])
                p.position += 1
            }
            p.consumed += taken.len()
            if p.position == p.data.len() {
                p.data = Array<byte>{}
                p.position = 0
            } else if p.position >= 16384 {
                var rest = Array<byte>{}
                for var i = p.position; i < p.data.len(); i += 1 {
                    rest.push(p.data[i])
                }
                p.data = rest
                p.position = 0
            }
            let ended = p.finished && p.position == p.data.len()
            let more = p.position < p.data.len()
            if ended {
                return taken, more, ended, clone(p.trailers), p.failure
            }
            return taken, more, ended, NewHeader(), p.failure
        })
        if chunk.len() == 0 && room == 0 && waiting {
            _ = failure
            return 0, r.failHTTP2(error("http.Client: body too large"))
        }
        if chunk.len() > 0 {
            _ = failure
            for i, value in chunk {
                buf[i] = value
            }
            r.total += chunk.len()
            return chunk.len(), nil
        }
        if failure != nil {
            r.h2[0].settled = true
            return 0, r.failHTTP2(failure)
        }
        if finished {
            r.done = true
            r.trailers = trailers
            r.h2[0].settled = true
            r.release()
            return 0, io.EOF
        }
        let ctx = r.h2[0].ctx
        let wake = r.h2[0].wake
        let idle = r.idle
        select {
            case wake.receive() {
                let _ = 0
            }
            case ctx.Done().receive() {
                return 0, r.failHTTP2(h2Reason(ctx.Err(), error("context deadline exceeded")))
            }
            case time.After(idle).receive() {
                return 0, r.failHTTP2(error("http.Client: body idle timeout"))
            }
        }
    }
}

func (r mut ResponseStream) failHTTP2(err error) error {
    r.trailers = NewHeader()
    r.failure = err
    r.release()
    return err
}

func (h HTTP2Conn) enqueue(request own h2Request) (int, error) {
    var slot = Array<h2Request>{}
    slot.push(request)
    let work = h.work
    let limit = h.limits.MaxStreams + h.limits.MaxWaiters
    return h.shared.withLock(func(s mut h2Shared) (int, error) {
        if s.closed || s.closing {
            if s.failure != nil {
                return 0, s.failure
            }
            return 0, error("http2: closed connection")
        }
        if s.inFlight >= limit || s.queued >= limit {
            return 0, error("http2: too many waiting requests")
        }
        s.inFlight += 1
        s.queued += 1
        s.next += 1
        let _, taken = slot.pop()
        var request = taken
        request.ticket = s.next
        work.send(request)
        return s.next, nil
    })
}
