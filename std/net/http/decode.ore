package http

import "std/compress/gzip"
import "std/context"
import "std/io"
import "std/strings"

type DecodeConfig struct {
    MaxBytes int
    MaxRatio int
}

type encodedBody struct {
    data Array<byte>
    position int
}

func (b mut encodedBody) Read(buf mut []byte) (int, error) {
    if b.position == b.data.len() {
        return 0, io.EOF
    }
    var count = b.data.len() - b.position
    if count > buf.len() {
        count = buf.len()
    }
    for var i = 0; i < count; i += 1 {
        buf[i] = b.data[b.position + i]
    }
    b.position += count
    return count, nil
}

func DefaultDecodeConfig() DecodeConfig {
    return DecodeConfig{MaxBytes: 16777216, MaxRatio: 200}
}

func decodeSettings(config DecodeConfig) (DecodeConfig, error) {
    let defaults = DefaultDecodeConfig()
    if config.MaxBytes < 0 || config.MaxRatio < 0 {
        return defaults, error("http.Client: negative decode configuration")
    }
    if config.MaxBytes > gzip.MaxBytes {
        return defaults, error("http.Client: decode limit too large")
    }
    var chosen = config
    if chosen.MaxBytes == 0 {
        chosen.MaxBytes = defaults.MaxBytes
    }
    if chosen.MaxRatio == 0 {
        chosen.MaxRatio = defaults.MaxRatio
    }
    return chosen, nil
}

func decodeHeaders(headers Header) (Header, error) {
    if headers.Values("Accept-Encoding").len() != 0 {
        return NewHeader(), error("http.Client: client owns Accept-Encoding")
    }
    var request = clone(headers)
    request.Add("Accept-Encoding", "gzip")?
    return request, nil
}

func contentCoding(headers Header) (string, error) {
    let encodings = headers.Values("Content-Encoding")
    if encodings.len() == 0 {
        return "identity", nil
    }
    let encoding = strings.ToLower(strings.Trim(encodings[0], " \t"))
    if encodings.len() > 1 || (encoding != "gzip" && encoding != "x-gzip" && encoding != "identity") {
        return "", error("http.Client: unsupported content encoding")
    }
    return encoding, nil
}

func decodeLimit(settings DecodeConfig, encodedLength int) int {
    if encodedLength <= settings.MaxBytes / settings.MaxRatio {
        return encodedLength * settings.MaxRatio
    }
    return settings.MaxBytes
}

func DecodeHeaders(headers Header, config DecodeConfig) (Header, error) {
    decodeSettings(config)?
    return decodeHeaders(headers)
}

func Decode(ctx context.Context, response own ClientResponse, config DecodeConfig) (ClientResponse, error) {
    let settings = decodeSettings(config)?
    var result = response
    if result.Headers.Values("Content-Encoding").len() == 0 || result.Body.len() == 0 || result.StatusCode == 206 {
        return result, nil
    }
    let encoding, codingErr = contentCoding(result.Headers)
    if codingErr != nil {
        return emptyClientResponse(), codingErr
    }
    if encoding == "identity" {
        return result, nil
    }
    let encodedLength = result.Body.len()
    if encodedLength > gzip.MaxBytes {
        return emptyClientResponse(), error("http.Client: encoded body too large to decode")
    }
    let limit = decodeLimit(settings, encodedLength)
    var reader = gzip.NewReader(encodedBody{data: result.Body, position: 0}, encodedLength, limit)?
    var decoded = Array<byte>{}
    var buf = Array<byte>{}
    for buf.len() < 4096 {
        buf.push(0)
    }
    for {
        clientContextError(ctx)?
        let n, err = reader.Read(buf[:])
        for var i = 0; i < n; i += 1 {
            decoded.push(buf[i])
        }
        if err == io.EOF {
            break
        }
        if err == error("gzip: output byte limit exceeded") {
            _ = err
            if limit < settings.MaxBytes {
                return emptyClientResponse(), error("http.Client: decoded body expands too much")
            }
            return emptyClientResponse(), error("http.Client: decoded body too large")
        }
        if err != nil {
            return emptyClientResponse(), err
        }
    }
    let _ = result.Headers.Del("Content-Encoding")
    let _ = result.Headers.Del("Content-Length")
    return ClientResponse{StatusCode: result.StatusCode, Headers: result.Headers, Body: decoded}, nil
}

func (c Client) DoDecoded(ctx context.Context, method string, absoluteURL string, headers Header, body []byte, config DecodeConfig) (ClientResponse, error) {
    let request = DecodeHeaders(headers, config)?
    let response = c.Do(ctx, method, absoluteURL, request, body)?
    return Decode(ctx, response, config)
}

func (p Pool) DoDecoded(ctx context.Context, method string, absoluteURL string, headers Header, body []byte, config DecodeConfig) (ClientResponse, error) {
    let request = DecodeHeaders(headers, config)?
    let response = p.Do(ctx, method, absoluteURL, request, body)?
    return Decode(ctx, response, config)
}

type decodeMeter struct {
    received bool
    trailers Header
}

type decodeSource struct {
    stream ResponseStream
    meter Mutex<decodeMeter>
    received bool
}

func (s mut decodeSource) Read(buf mut []byte) (int, error) {
    let n, err = s.stream.Read(buf)
    if n > 0 && !s.received {
        s.received = true
        s.meter.withLock(func(m mut decodeMeter) {
            m.received = true
        })
    }
    if err == io.EOF {
        let trailers, _ = s.stream.Trailers()
        s.meter.withLock(func(m mut decodeMeter) {
            m.trailers = clone(trailers)
        })
    }
    return n, err
}

type decodeState struct {
    reader gzip.Reader
    meter Mutex<decodeMeter>
    capped bool
}

func DecodeStream(stream own ResponseStream, config DecodeConfig) (ResponseStream, error) {
    var source = stream
    let settings = decodeSettings(config)?
    if source.headers.Values("Content-Encoding").len() == 0 || source.done || source.status == 206 {
        return source, nil
    }
    let encoding = contentCoding(source.headers)?
    if encoding == "identity" {
        return source, nil
    }
    var limit = settings.MaxBytes
    let length, declared = source.headers.Get("Content-Length")
    let encodedLength, lengthErr = decimal(length)
    if lengthErr == nil && declared {
        if encodedLength > gzip.MaxBytes {
            return emptyResponseStream(), error("http.Client: encoded body too large to decode")
        }
        limit = decodeLimit(settings, encodedLength)
    }
    var result = emptyResponseStream()
    result.status = source.status
    result.headers = clone(source.headers)
    let _ = result.headers.Del("Content-Encoding")
    let _ = result.headers.Del("Content-Length")
    let meter = mutex(decodeMeter{received: false, trailers: NewHeader()})
    var reader = gzip.NewReader(decodeSource{stream: source, meter: meter, received: false}, gzip.MaxBytes, limit)?
    reader.SetStreaming(true)
    result.gunzip.push(decodeState{reader: reader, meter: meter, capped: limit < settings.MaxBytes})
    return result, nil
}

func (r mut ResponseStream) readDecoded(buf mut []byte) (int, error) {
    if buf.len() == 0 {
        return 0, nil
    }
    let n, err = r.gunzip[0].reader.Read(buf)
    r.total += n
    if err == error("gzip: truncated stream") && n == 0 {
        let received = r.gunzip[0].meter.withLock(func(m mut decodeMeter) bool {
            return m.received
        })
        if !received {
            _ = err
            r.finishDecoded()
            return 0, io.EOF
        }
    }
    if err == io.EOF {
        _ = err
        r.finishDecoded()
        if n > 0 {
            return n, nil
        }
        return 0, io.EOF
    }
    if n > 0 {
        _ = err
        return n, nil
    }
    if err == error("gzip: output byte limit exceeded") {
        _ = err
        if r.gunzip[0].capped {
            return 0, r.failDecoded(error("http.Client: decoded body expands too much"))
        }
        return 0, r.failDecoded(error("http.Client: decoded body too large"))
    }
    if err == error("gzip: compressed byte limit exceeded") {
        _ = err
        return 0, r.failDecoded(error("http.Client: encoded body too large to decode"))
    }
    if err != nil {
        return 0, r.failDecoded(err)
    }
    return 0, nil
}

func (r mut ResponseStream) finishDecoded() {
    r.done = true
    r.trailers = r.gunzip[0].meter.withLock(func(m mut decodeMeter) Header {
        return clone(m.trailers)
    })
    r.gunzip = Array<decodeState>{}
    r.release()
}

func (r mut ResponseStream) failDecoded(err error) error {
    r.trailers = NewHeader()
    r.failure = err
    r.gunzip = Array<decodeState>{}
    r.release()
    return err
}

func (c Client) OpenDecoded(ctx context.Context, method string, absoluteURL string, headers Header, body []byte, stream StreamConfig, config DecodeConfig) (ResponseStream, error) {
    let request = DecodeHeaders(headers, config)?
    let opened = c.Open(ctx, method, absoluteURL, request, body, stream)?
    return DecodeStream(opened, config)
}

func (p Pool) OpenDecoded(ctx context.Context, method string, absoluteURL string, headers Header, body []byte, stream StreamConfig, config DecodeConfig) (ResponseStream, error) {
    let request = DecodeHeaders(headers, config)?
    let opened = p.Open(ctx, method, absoluteURL, request, body, stream)?
    return DecodeStream(opened, config)
}

func (h HTTP2Conn) OpenDecoded(ctx context.Context, method string, absoluteURL string, headers Header, body []byte, stream StreamConfig, config DecodeConfig) (ResponseStream, error) {
    let request = DecodeHeaders(headers, config)?
    let opened = h.Open(ctx, method, absoluteURL, request, body, stream)?
    return DecodeStream(opened, config)
}
