package http

import "std/io"
import "std/mime"
import "std/os"
import "std/path/filepath"
import "std/strconv"
import "std/strings"
import "std/time"

func fileError(problem string) error {
    return error("http.ServeFile: " + problem)
}

func reservedDeviceName(segment string) bool {
    let base, _, _ = strings.Cut(strings.ToUpper(segment), ".")
    if base == "CON" || base == "PRN" || base == "AUX" || base == "NUL" {
        return true
    }
    if base.len() == 4 && (strings.HasPrefix(base, "COM") || strings.HasPrefix(base, "LPT")) {
        return base[3] >= 49 && base[3] <= 57
    }
    return false
}

func servableSegment(segment string) bool {
    if segment == "" || segment[0] == 46 {
        return false
    }
    let last = segment[segment.len() - 1]
    if last == 46 || last == 32 {
        return false
    }
    for var i = 0; i < segment.len(); i += 1 {
        let c = segment[i]
        if c < 32 || c == 127 || c == 92 || c == 58 {
            return false
        }
    }
    return !reservedDeviceName(segment)
}

func notFound(w mut ResponseWriter) error {
    return w.Text(StatusNotFound, "404 not found")
}

func ServeFileIn(w mut ResponseWriter, r Request, root string, name string) error {
    if root == "" {
        return fileError("empty root")
    }
    let segments = strings.Split(name, "/")
    var parts = Array<string>{root}
    for segment in segments {
        if !servableSegment(segment) {
            return notFound(w)
        }
        parts.push(segment)
        let info, err = os.Lstat(filepath.Join(parts[:]))
        if err != nil || info.IsSymlink() {
            return notFound(w)
        }
    }
    return ServeFile(w, r, filepath.Join(parts[:]))
}

func ServeFile(w mut ResponseWriter, r Request, path string) error {
    let method = r.Method()
    if method != "GET" && method != "HEAD" {
        w.SetHeader(HeaderAllow, "GET, HEAD")?
        return w.Text(StatusMethodNotAllowed, "405 method not allowed")
    }
    let info, statErr = os.Stat(path)
    if statErr != nil || info.IsDir() {
        return notFound(w)
    }
    var file, openErr = os.Open(path)
    if openErr != nil {
        return notFound(w)
    }
    let size = info.Size()
    var contentType = "application/octet-stream"
    let known, found = mime.TypeByExtension(filepath.Ext(path))
    if found {
        contentType = known
    }
    w.SetHeader(HeaderContentType, contentType)?
    w.SetHeader("X-Content-Type-Options", "nosniff")?
    w.SetHeader(HeaderContentLength, strconv.Itoa(size))?
    if info.ModTime() > 0 {
        let modified, timeErr = time.Unix(info.ModTime(), 0)
        if timeErr == nil {
            w.SetHeader("Last-Modified", FormatDate(modified))?
        }
    }
    w.WriteHeader(StatusOK)?
    if method == "HEAD" || size == 0 {
        return nil
    }
    let _, copyErr = io.CopyN(w, file, size)
    return copyErr
}
