package http

import "std/context"
import "std/net"
import "std/net/url"
import "std/strconv"
import "std/strings"

type ProxyConfig struct {
    URL string
    Authorization string
}

type ClientTunnel interface {
    Tunnel(ctx context.Context, conn own net.Conn, target url.AbsoluteURL) (ClientConn, error)
}

type clientProxy struct {
    address string
    authorization string
    set bool
}

func noProxy() clientProxy {
    return clientProxy{address: "", authorization: "", set: false}
}

func proxySettings(proxy ProxyConfig) (clientProxy, error) {
    let target, err = url.ParseAbsolute(proxy.URL)
    if err != nil || target.Scheme != "http" || target.RequestTarget != "/" {
        _ = err
        return noProxy(), error("http.Client: invalid proxy URL")
    }
    if proxy.Authorization != "" && !fieldValue(proxy.Authorization) {
        return noProxy(), error("http.Client: invalid proxy authorization")
    }
    return clientProxy{address: target.Address, authorization: proxy.Authorization, set: true}, nil
}

func NewProxyClient(config ClientConfig, proxy ProxyConfig) (Client, error) {
    let settings = proxySettings(proxy)?
    var client = NewClient(config)?
    client.proxy = settings
    return client, nil
}

func NewProxyClientWithTunnel(config ClientConfig, proxy ProxyConfig, tunnel own ClientTunnel) (Client, error) {
    var client = NewProxyClient(config, proxy)?
    client.tunnel.push(tunnel)
    return client, nil
}

func (c Client) proxyDial(ctx context.Context, target url.AbsoluteURL) (ClientConn, error) {
    if target.Scheme != "http" && c.tunnel.len() == 0 {
        return closedClientConn{}, error("http.Client: HTTPS requires verified TLS transport")
    }
    var conns, dialErr = c.dialAddress(ctx, c.proxy.address)
    if dialErr != nil {
        return closedClientConn{}, dialErr
    }
    let _, conn = conns.pop()
    if target.Scheme == "http" {
        return conn, nil
    }
    let connectErr = c.connect(ctx, conn, target)
    if connectErr != nil {
        return closedClientConn{}, connectErr
    }
    let tunneled, tunnelErr = c.tunnel[0].Tunnel(ctx, conn, target)
    if tunnelErr != nil {
        return closedClientConn{}, tunnelErr
    }
    let contextErr = clientContextError(ctx)
    if contextErr != nil {
        return closedClientConn{}, contextErr
    }
    return tunneled, nil
}

func (c Client) connect(ctx context.Context, conn net.Conn, target url.AbsoluteURL) error {
    var request = "CONNECT " + target.Address + " HTTP/1.1\r\nHost: " + target.Address + "\r\n"
    if c.proxy.authorization != "" {
        request += "Proxy-Authorization: " + c.proxy.authorization + "\r\n"
    }
    request += "\r\n"
    let data = strings.Bytes(request)
    let deadline, _ = ctx.Deadline()
    var sent = 0
    var idle = 0
    for sent < data.len() {
        clientContextError(ctx)?
        conn.SetWriteDeadline(pollDeadline(deadline, c.config.PollInterval))?
        let n, err = conn.Write(data[sent:])
        if n < 0 || n > data.len() - sent {
            _ = err
            return error("http.Client: invalid write count")
        }
        sent += n
        if err == error("net.Write: timed out") {
            continue
        }
        if err != nil {
            return err
        }
        if n == 0 {
            idle += 1
            if idle >= 100 {
                return error("http.Client: write made no progress")
            }
        }
    }
    var head = Array<byte>{}
    var one = [byte; 1]{0}
    idle = 0
    conn.SetReadDeadline(pollDeadline(deadline, c.config.PollInterval))?
    for !proxyHeadDone(head) {
        clientContextError(ctx)?
        if head.len() >= c.config.MaxHeaderBytes {
            return error("http.Client: proxy response too large")
        }
        let n, err = conn.Read(one[:])
        if n == 1 {
            head.push(one[0])
            idle = 0
        }
        if proxyHeadDone(head) {
            _ = err
            break
        }
        if err == error("net.Read: timed out") {
            conn.SetReadDeadline(pollDeadline(deadline, c.config.PollInterval))?
            continue
        }
        if err != nil {
            return error("http.Client: proxy closed the tunnel request")
        }
        if n == 0 {
            idle += 1
            if idle >= 100 {
                return error("http.Client: read made no progress")
            }
        }
    }
    conn.ClearDeadline()?
    var end = 0
    for end + 1 < head.len() && !(head[end] == 13 && head[end + 1] == 10) {
        end += 1
    }
    let line, lineErr = strings.FromBytes(head[:end])
    if lineErr != nil {
        _ = lineErr
        return error("http.Client: invalid proxy response")
    }
    let _, status, statusErr = clientStatus(line)
    if statusErr != nil {
        _ = statusErr
        return error("http.Client: invalid proxy response")
    }
    if status < 200 || status > 299 {
        return error("http.Client: proxy refused tunnel with status " + strconv.Itoa(status))
    }
    return nil
}

func proxyHeadDone(head Array<byte>) bool {
    let n = head.len()
    return n >= 4 && head[n - 4] == 13 && head[n - 3] == 10 && head[n - 2] == 13 && head[n - 1] == 10
}
