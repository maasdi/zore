package net

type Listener struct {
    id int
}

type Conn struct {
    id int
}

func (l mut Listener) drop() {
    closeHandle(l.id)
}

func (c mut Conn) drop() {
    closeHandle(c.id)
}

func family(network string) int {
    if network == "tcp" {
        return 0
    }
    if network == "tcp4" {
        return 4
    }
    if network == "tcp6" {
        return 6
    }
    return -1
}

func Listen(network string, address string) (Listener, error) {
    let kind = family(network)
    if kind < 0 {
        return Listener{id: 0}, error("net.Listen: unknown network " + network)
    }
    let id, err = listen(kind, address)
    return Listener{id: id}, err
}

func Dial(network string, address string) (Conn, error) {
    return DialTimeout(network, address, 0)
}

func DialTimeout(network string, address string, timeout int) (Conn, error) {
    let kind = family(network)
    if kind < 0 {
        return Conn{id: 0}, error("net.Dial: unknown network " + network)
    }
    let id, err = dial(kind, address, timeout)
    return Conn{id: id}, err
}

func (l Listener) Accept() (Conn, error) {
    let id, err = accept(l.id)
    return Conn{id: id}, err
}

func (l Listener) Addr() string {
    return localAddr(l.id)
}

func (l Listener) SetDeadline(t int) error {
    return setDeadline(l.id, 0, t)
}

func (l own Listener) Close() error {
    return close(l.id)
}

func (c Conn) Read(buf mut []byte) (int, error) {
    let data, err = read(c.id, buf.len())
    for var i = 0; i < data.len(); i += 1 {
        buf[i] = data[i]
    }
    return data.len(), err
}

func (c Conn) Write(data []byte) (int, error) {
    return write(c.id, data)
}

func (c Conn) LocalAddr() string {
    return localAddr(c.id)
}

func (c Conn) RemoteAddr() string {
    return remoteAddr(c.id)
}

func (c Conn) SetDeadline(t int) error {
    return setDeadline(c.id, 0, t)
}

func (c Conn) SetReadDeadline(t int) error {
    return setDeadline(c.id, 1, t)
}

func (c Conn) SetWriteDeadline(t int) error {
    return setDeadline(c.id, 2, t)
}

func (c Conn) CloseWrite() error {
    return closeWrite(c.id)
}

func (c own Conn) Close() error {
    return close(c.id)
}

func listen(family int, address string) (int, error)
func dial(family int, address string, timeout int) (int, error)
func accept(id int) (int, error)
func read(id int, max int) (Array<byte>, error)
func write(id int, data []byte) (int, error)
func localAddr(id int) string
func remoteAddr(id int) string
func setDeadline(id int, which int, t int) error
func closeWrite(id int) error
func close(id int) error
func closeHandle(id int)
