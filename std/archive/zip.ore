package archive

import "std/hash/crc32"
import "std/compress/flate"
import "std/io"
import "std/strings"

const zipLocal = 0x04034b50
const zipCentral = 0x02014b50
const zipEnd = 0x06054b50
const zipDescriptor = 0x08074b50
const zipUTF8 = 0x0800
const zipStreamed = 0x0008

type Compression int

const Store Compression = 0
const Deflate Compression = 8

type zipEntry struct {
    wide bool
    symlink bool
    executable bool
    method int
    compressed int
    header Header
    crc uint32
    flags int
    offset int
}

func (entry zipEntry) extraSize() int {
    var size = 0
    if entry.header.Size >= marker32 {
        size += 8
    }
    if entry.compressed >= marker32 {
        size += 8
    }
    if entry.offset >= marker32 {
        size += 8
    }
    if size > 0 {
        size += 4
    }
    return size
}

func zipFlags(flags int, method int, version int) error {
    if method != 0 && method != 8 {
        return error("archive: unsupported ZIP compression method")
    }
    var allowed = zipUTF8 | zipStreamed
    if method == 8 {
        allowed |= 6
    }
    if flags & (65535 ^ allowed) != 0 {
        return error("archive: unsupported ZIP flags")
    }
    if version > 45 {
        return error("archive: unsupported ZIP version")
    }
    return nil
}

const wideThreshold = 4293918719
const zip64Locator = 0x07064b50
const zip64End = 0x06064b50
const marker16 = 65535
const marker32 = 4294967295

func put64(data mut []byte, at int, value int) {
    put32(data, at, value & marker32)
    put32(data, at + 4, value >> 32)
}

func smaller(left int, right int) int {
    if left < right {
        return left
    }
    return right
}

func u64(data []byte, at int) int {
    let high = u32(data, at + 4)
    if high >= 1073741824 {
        return -1
    }
    return (high << 32) | u32(data, at)
}

type zip64Field struct {
    start int
    size int
    found bool
}

func zipExtra(data []byte) (zip64Field, error) {
    var field = zip64Field{start: 0, size: 0, found: false}
    var at = 0
    for at < data.len() {
        if data.len() - at < 4 {
            return field, error("archive: invalid ZIP extra field")
        }
        let kind = u16(data, at)
        let size = u16(data, at + 2)
        at += 4
        if size > data.len() - at {
            return field, error("archive: invalid ZIP extra field")
        }
        if kind == 1 {
            if field.found {
                return field, error("archive: invalid ZIP64 extra field")
            }
            field = zip64Field{start: at, size: size, found: true}
        }
        at += size
    }
    return field, nil
}

type zip64Values struct {
    data Array<byte>
    at int
}

func (v mut zip64Values) take(current int, wide bool) (int, error) {
    if current != marker32 && !wide {
        return current, nil
    }
    if v.data.len() - v.at < 8 {
        return 0, error("archive: invalid ZIP64 extra field")
    }
    let value = u64(v.data[:], v.at)
    v.at += 8
    if value < 0 || value > MaxBytes {
        return 0, error("archive: invalid ZIP64 extra field")
    }
    return value, nil
}

func zip64Payload(data []byte, field zip64Field) zip64Values {
    var copied = Array<byte>{}
    if field.found {
        for var i = field.start; i < field.start + field.size; i += 1 {
            copied.push(data[i])
        }
    }
    return zip64Values{data: copied, at: 0}
}

func zipName(data []byte, flags int) (string, error) {
    if flags & zipUTF8 == 0 {
        for value in data {
            if value >= 128 {
                return "", error("archive: ZIP names require ASCII or the UTF-8 flag")
            }
        }
    }
    return strings.FromBytes(data)
}

func seekTo(source mut io.ReadSeeker, offset int) error {
    let actual, err = source.Seek(offset, io.SeekStart)
    if err != nil {
        return err
    }
    if actual != offset {
        return error("archive: invalid seek position")
    }
    return nil
}

type ZIPReader struct {
    source zipInput
    decoder flate.Decoder
    archiveLimit int
    dataLimit int
    entryLimit int
    entries Array<zipEntry>
    cursor int
    remaining int
    crc uint32
    nextOffset int
    centralOffset int
    wide bool
    active bool
    initialized bool
    ended bool
    err error
}

func NewZIPReader(source own io.ReadSeeker, archiveLimit int, dataLimit int, entryLimit int) (ZIPReader, error) {
    let decoder, _ = flate.NewDecoder(0, 0)
    var reader = ZIPReader{source: zipInput{source: source, remaining: 0, framed: false, chunk: zeros(4096), cursor: 0, used: 0, pending: nil}, decoder: decoder, archiveLimit: archiveLimit, dataLimit: dataLimit, entryLimit: entryLimit, entries: Array<zipEntry>{}, cursor: 0, remaining: 0, crc: 0, nextOffset: 0, centralOffset: 0, wide: false, active: false, initialized: false, ended: false, err: nil}
    if !validLimits(archiveLimit, dataLimit, entryLimit) {
        reader.err = error("archive: invalid limit")
    }
    let err = reader.err
    return reader, err
}

func (r mut ZIPReader) initialize() error {
    let size, sizeErr = r.source.Seek(0, io.SeekEnd)
    if sizeErr != nil {
        return sizeErr
    }
    if size < 22 {
        return error("archive: truncated ZIP stream")
    }
    if size > r.archiveLimit {
        return error("archive: archive byte limit exceeded")
    }
    var tailSize = size
    if tailSize > 65577 {
        tailSize = 65577
    }
    let tailStart = size - tailSize
    seekTo(r.source, tailStart)?
    var tail = zeros(tailSize)
    readExact(r.source, tail[:])?
    var end = -1
    var wide = false
    var missingLocator = false
    for var at = tail.len() - 22; at >= 0; at -= 1 {
        if u32(tail[:], at) != zipEnd || u16(tail[:], at + 20) != tail.len() - at - 22 {
            continue
        }
        let located = at >= 20 && u32(tail[:], at - 20) == zip64Locator
        let directoryOffset = u32(tail[:], at + 16)
        let directorySize = u32(tail[:], at + 12)
        if !located && (u16(tail[:], at + 10) == marker16 || directoryOffset == marker32 || directorySize == marker32) {
            missingLocator = true
        }
        let candidateOffset = tailStart + at
        if located || (directoryOffset <= candidateOffset && directorySize == candidateOffset - directoryOffset) {
            if end >= 0 {
                return error("archive: ambiguous ZIP end records")
            }
            end = at
            wide = located
        }
    }
    if end < 0 {
        if missingLocator {
            return error("archive: ZIP64 end locator not found")
        }
        return error("archive: ZIP end record not found")
    }
    if u16(tail[:], end + 4) != 0 || u16(tail[:], end + 6) != 0 {
        return error("archive: split ZIP is unsupported")
    }
    var count = u16(tail[:], end + 10)
    var centralSize = u32(tail[:], end + 12)
    r.centralOffset = u32(tail[:], end + 16)
    if count != u16(tail[:], end + 8) {
        return error("archive: ZIP entry count mismatch")
    }
    var endOffset = tailStart + end
    if wide {
        let locator = end - 20
        if u32(tail[:], locator + 4) != 0 || u32(tail[:], locator + 16) != 1 {
            return error("archive: split ZIP is unsupported")
        }
        let recordOffset = u64(tail[:], locator + 8)
        let locatorOffset = tailStart + locator
        if recordOffset < 0 || recordOffset > locatorOffset - 56 {
            return error("archive: invalid ZIP64 end record")
        }
        seekTo(r.source, recordOffset)?
        var record = zeros(56)
        readExact(r.source, record[:])?
        let recordSize = u64(record[:], 4)
        if u32(record[:], 0) != zip64End || recordSize < 44 || recordSize != locatorOffset - recordOffset - 12 {
            return error("archive: invalid ZIP64 end record")
        }
        if recordSize - 44 > MaxMetadataBytes {
            return error("archive: metadata byte limit exceeded")
        }
        zipFlags(0, 0, u16(record[:], 14))?
        if u32(record[:], 16) != 0 || u32(record[:], 20) != 0 {
            return error("archive: split ZIP is unsupported")
        }
        let wideCount = u64(record[:], 24)
        let wideSize = u64(record[:], 40)
        let wideOffset = u64(record[:], 48)
        if wideCount < 0 || wideCount != u64(record[:], 32) || wideSize < 0 || wideOffset < 0 {
            return error("archive: invalid ZIP64 end record")
        }
        if (count != marker16 && count != wideCount) || (centralSize != marker32 && centralSize != wideSize) || (r.centralOffset != marker32 && r.centralOffset != wideOffset) {
            return error("archive: ZIP64 end record mismatch")
        }
        count = wideCount
        centralSize = wideSize
        r.centralOffset = wideOffset
        endOffset = recordOffset
    } else if count == marker16 || centralSize == marker32 || r.centralOffset == marker32 {
        return error("archive: ZIP64 end locator not found")
    }
    if count > r.entryLimit {
        return error("archive: entry limit exceeded")
    }
    if centralSize > MaxMetadataBytes {
        return error("archive: metadata byte limit exceeded")
    }
    if r.centralOffset > endOffset || centralSize != endOffset - r.centralOffset {
        return error("archive: invalid ZIP directory bounds")
    }
    seekTo(r.source, r.centralOffset)?
    var used = 0
    var declared = 0
    for var index = 0; index < count; index += 1 {
        if centralSize - used < 46 {
            return error("archive: truncated ZIP directory")
        }
        var record = zeros(46)
        readExact(r.source, record[:])?
        used += 46
        if u32(record[:], 0) != zipCentral {
            return error("archive: invalid ZIP directory signature")
        }
        let flags = u16(record[:], 8)
        zipFlags(flags, u16(record[:], 10), u16(record[:], 6))?
        let startDisk = u16(record[:], 34)
        if startDisk != 0 && startDisk != marker16 {
            return error("archive: split ZIP is unsupported")
        }
        let nameSize = u16(record[:], 28)
        let extraSize = u16(record[:], 30)
        let commentSize = u16(record[:], 32)
        if nameSize > MaxNameBytes {
            return error("archive: invalid entry name")
        }
        let variableSize = nameSize + extraSize + commentSize
        if variableSize > centralSize - used {
            return error("archive: invalid ZIP directory record size")
        }
        var variable = zeros(variableSize)
        readExact(r.source, variable[:])?
        used += variableSize
        let field = zipExtra(variable[nameSize:nameSize + extraSize])?
        var values = zip64Payload(variable[nameSize:nameSize + extraSize], field)
        let size = values.take(u32(record[:], 24), false)?
        let compressed = values.take(u32(record[:], 20), false)?
        let offset = values.take(u32(record[:], 42), false)?
        if startDisk == marker16 {
            if values.data.len() - values.at < 4 {
                return error("archive: invalid ZIP64 extra field")
            }
            if u32(values.data[:], values.at) != 0 {
                return error("archive: split ZIP is unsupported")
            }
        }
        if u16(record[:], 10) == 0 && compressed != size {
            return error("archive: stored ZIP size mismatch")
        }
        let name = zipName(variable[:nameSize], flags)?
        let directory = strings.HasSuffix(name, "/")
        let header = Header{Name: name, Size: size, Directory: directory}
        validate(header)?
        let attributes = u32(record[:], 38)
        if attributes & 16 != 0 && !directory {
            return error("archive: inconsistent ZIP directory attributes")
        }
        let kind = (attributes >> 16) & 0o170000
        if kind != 0 && kind != 0o100000 && kind != 0o40000 && kind != 0o120000 {
            return error("archive: unsupported ZIP entry type")
        }
        if (kind == 0o40000 && !directory) || ((kind == 0o100000 || kind == 0o120000) && directory) {
            return error("archive: inconsistent ZIP entry type")
        }
        let symlink = kind == 0o120000
        if symlink && (size == 0 || size > MaxNameBytes) {
            return error("archive: invalid link target")
        }
        let executable = record[5] == 3 && !directory && !symlink && (attributes >> 16) & 0o111 != 0
        let crc = uint32(u32(record[:], 16))
        if directory && crc != 0 {
            return error("archive: invalid ZIP directory checksum")
        }
        if size > r.dataLimit - declared {
            return error("archive: data byte limit exceeded")
        }
        declared += size
        if offset >= r.centralOffset {
            return error("archive: invalid ZIP local offset")
        }
        r.entries.push(zipEntry{wide: false, symlink: symlink, executable: executable, method: u16(record[:], 10), compressed: compressed, header: header, crc: crc, flags: flags, offset: offset})
    }
    if used != centralSize {
        return error("archive: ZIP directory size mismatch")
    }
    r.initialized = true
    return nil
}

func (r mut ZIPReader) finishEntry() error {
    if r.remaining != 0 {
        return error("archive: unread ZIP entry data")
    }
    if !r.active {
        return nil
    }
    let entry = r.entries[r.cursor - 1]
    if entry.method == 8 {
        var probe = [byte; 1]{0}
        let count, err = flate.Read(r.decoder, r.source, probe[:])
        if err != io.EOF {
            if err != nil {
                return err
            };
            return error("archive: excess ZIP output")
        }
        if count != 0 || r.decoder.InputBytes() != entry.compressed || r.decoder.OutputBytes() != entry.header.Size {
            return error("archive: ZIP DEFLATE size mismatch")
        }
        r.source.framed = false
    }
    if r.crc != entry.crc {
        return error("archive: ZIP checksum mismatch")
    }
    if entry.flags & zipStreamed != 0 {
        var boundary = r.centralOffset
        if r.cursor < r.entries.len() {
            boundary = r.entries[r.cursor].offset
        }
        let length = boundary - r.nextOffset
        var width = 4
        if r.wide {
            width = 8
        }
        if length != 4 + 2 * width && length != 8 + 2 * width {
            return error("archive: invalid ZIP descriptor bounds")
        }
        var descriptor = zeros(length)
        readExact(r.source, descriptor[:])?
        var at = 0
        if length == 8 + 2 * width {
            if u32(descriptor[:], 0) != zipDescriptor {
                return error("archive: invalid ZIP descriptor signature")
            }
            at = 4
        }
        var compressedValue = u32(descriptor[:], at + 4)
        var sizeValue = u32(descriptor[:], at + 8)
        if r.wide {
            compressedValue = u64(descriptor[:], at + 4)
            sizeValue = u64(descriptor[:], at + 12)
        }
        if uint32(u32(descriptor[:], at)) != entry.crc || compressedValue != entry.compressed || sizeValue != entry.header.Size {
            return error("archive: ZIP descriptor mismatch")
        }
        r.nextOffset = boundary
    }
    r.active = false
    return nil
}

func (r mut ZIPReader) nextHeader() (Header, bool, error) {
    if !r.initialized {
        r.initialize()?
    }
    r.finishEntry()?
    if r.cursor == r.entries.len() {
        if r.nextOffset != r.centralOffset {
            return absent(), false, error("archive: unindexed ZIP data")
        }
        r.ended = true
        return absent(), false, nil
    }
    let entry = r.entries[r.cursor]
    if entry.offset != r.nextOffset {
        return absent(), false, error("archive: ZIP local records are not contiguous and ordered")
    }
    if r.centralOffset - entry.offset < 30 {
        return absent(), false, error("archive: truncated ZIP local header")
    }
    seekTo(r.source, entry.offset)?
    var record = zeros(30)
    readExact(r.source, record[:])?
    if u32(record[:], 0) != zipLocal {
        return absent(), false, error("archive: invalid ZIP local signature")
    }
    let flags = u16(record[:], 6)
    zipFlags(flags, u16(record[:], 8), u16(record[:], 4))?
    if flags != entry.flags || u16(record[:], 8) != entry.method {
        return absent(), false, error("archive: ZIP flag mismatch")
    }
    let nameSize = u16(record[:], 26)
    let extraSize = u16(record[:], 28)
    if nameSize > MaxNameBytes {
        return absent(), false, error("archive: invalid entry name")
    }
    let dataOffset = entry.offset + 30 + nameSize + extraSize
    if dataOffset > r.centralOffset || entry.compressed > r.centralOffset - dataOffset {
        return absent(), false, error("archive: invalid ZIP entry bounds")
    }
    var variable = zeros(nameSize + extraSize)
    readExact(r.source, variable[:])?
    let field = zipExtra(variable[nameSize:])?
    r.wide = field.found
    var values = zip64Payload(variable[nameSize:], field)
    let crc = u32(record[:], 14)
    let marked = u32(record[:], 18) == marker32 || u32(record[:], 22) == marker32
    if marked && !field.found {
        return absent(), false, error("archive: invalid ZIP64 extra field")
    }
    let size = values.take(u32(record[:], 22), marked)?
    let compressed = values.take(u32(record[:], 18), marked)?
    if flags & zipStreamed == 0 {
        if uint32(crc) != entry.crc || compressed != entry.compressed || size != entry.header.Size {
            return absent(), false, error("archive: ZIP local metadata mismatch")
        }
    } else {
        if (crc != 0 && uint32(crc) != entry.crc) || (compressed != 0 && compressed != entry.compressed) || (size != 0 && size != entry.header.Size) {
            return absent(), false, error("archive: ZIP local metadata mismatch")
        }
    }
    let name = zipName(variable[:nameSize], flags)?
    if name != entry.header.Name {
        return absent(), false, error("archive: ZIP local name mismatch")
    }
    r.nextOffset = dataOffset + entry.compressed
    r.remaining = entry.header.Size
    r.crc = 0
    r.cursor += 1
    r.active = true
    if entry.method == 8 {
        r.decoder = flate.NewDecoder(entry.compressed, entry.header.Size)?
        r.source.remaining = entry.compressed
        r.source.framed = true
    }
    return entry.header, true, nil
}

func (r mut ZIPReader) Next() (Entry, bool, error) {
    if r.err != nil {
        return absentEntry(), false, r.err
    }
    if r.ended {
        return absentEntry(), false, nil
    }
    let header, present, err = r.nextHeader()
    if err != nil || !present {
        r.err = err
        return absentEntry(), false, err
    }
    let stored = r.entries[r.cursor - 1]
    var entry = plainEntry(header)
    entry.Executable = stored.executable
    if !stored.symlink {
        return entry, true, nil
    }
    var target = zeros(header.Size)
    var got = 0
    for got < target.len() {
        let count, readErr = r.Read(target[got:])
        got += count
        if readErr != nil {
            if readErr == io.EOF {
                r.err = error("archive: truncated ZIP stream")
            } else {
                r.err = readErr
            }
            return absentEntry(), false, r.err
        }
    }
    let text, invalid = strings.FromBytes(target[:])
    if invalid != nil {
        r.err = error("archive: invalid link target")
        return absentEntry(), false, r.err
    }
    let linkErr = validLink(text)
    if linkErr != nil {
        r.err = linkErr
        return absentEntry(), false, linkErr
    }
    entry.Header.Size = 0
    entry.Kind = SymlinkEntry
    entry.Link = text
    return entry, true, nil
}

func (r mut ZIPReader) Read(buf mut []byte) (int, error) {
    if buf.len() == 0 {
        return 0, nil
    }
    if r.err != nil {
        return 0, r.err
    }
    if !r.active {
        return 0, io.EOF
    }
    if r.remaining == 0 {
        r.err = r.finishEntry()
        if r.err != nil {
            return 0, r.err
        }
        return 0, io.EOF
    }
    var want = buf.len()
    if want > r.remaining {
        want = r.remaining
    }
    let count, err = r.payload(buf[:want])
    r.crc = crc32.Update(r.crc, buf[:count])
    r.remaining -= count
    if err == io.EOF {
        r.err = error("archive: truncated ZIP stream")
    } else {
        r.err = err
    }
    return count, r.err
}

func (r mut ZIPReader) Skip() error {
    var buf = zeros(4096)
    for {
        let _, err = r.Read(buf[:])
        if err == io.EOF {
            return nil
        }
        if err != nil {
            return err
        }
    }
}

func (r own ZIPReader) Close() error {
    return r.err
}

type ZIPWriter<W io.Writer> struct {
    output output<W>
    encoder flate.Encoder
    payloadStart int
    dataLimit int
    entryLimit int
    declared int
    metadata int
    entries Array<zipEntry>
    remaining int
    crc uint32
    active bool
    finished bool
    err error
}

func NewZIPWriter<W io.Writer>(sink own W, archiveLimit int, dataLimit int, entryLimit int) (ZIPWriter<W>, error) {
    let encoder, _ = flate.NewEncoder(0, 0)
    var writer = ZIPWriter<W>{encoder: encoder, payloadStart: 0, output: output<W>{sink: sink, limit: archiveLimit, count: 0}, dataLimit: dataLimit, entryLimit: entryLimit, declared: 0, metadata: 0, entries: Array<zipEntry>{}, remaining: 0, crc: 0, active: false, finished: false, err: nil}
    if !validLimits(archiveLimit, dataLimit, entryLimit) {
        writer.err = error("archive: invalid limit")
    }
    let err = writer.err
    return writer, err
}

func (w mut ZIPWriter<W>) finishEntry() error {
    if w.remaining != 0 {
        return error("archive: incomplete ZIP entry")
    }
    if !w.active {
        return nil
    }
    let index = w.entries.len() - 1
    if w.entries[index].method == 8 {
        flate.Finish(w.encoder, w.output)?
    }
    let compressed = w.output.count - w.payloadStart
    let previousExtra = w.entries[index].extraSize()
    w.entries[index].compressed = compressed
    let addedMetadata = w.entries[index].extraSize() - previousExtra
    if addedMetadata > MaxMetadataBytes - w.metadata {
        return error("archive: metadata byte limit exceeded")
    }
    w.metadata += addedMetadata
    let size = w.entries[index].header.Size
    var descriptor = zeros(16)
    if w.entries[index].wide {
        descriptor = zeros(24)
        put64(descriptor[:], 8, compressed)
        put64(descriptor[:], 16, size)
    } else {
        put32(descriptor[:], 8, compressed)
        put32(descriptor[:], 12, size)
    }
    put32(descriptor[:], 0, zipDescriptor)
    put32(descriptor[:], 4, int(w.crc))
    let _, err = w.output.Write(descriptor[:])
    if err != nil {
        return err
    }
    w.entries[w.entries.len() - 1].crc = w.crc
    w.active = false
    return nil
}

func (w mut ZIPWriter<W>) start(entry Entry, compression Compression) error {
    if compression != Store && compression != Deflate {
        return error("archive: unsupported ZIP compression method")
    }
    writable(entry)?
    let header = entry.Header
    validate(header)?
    if w.entries.len() == w.entryLimit {
        return error("archive: entry limit exceeded")
    }
    if header.Size > w.dataLimit - w.declared {
        return error("archive: data byte limit exceeded")
    }
    w.finishEntry()?
    let offset = w.output.count
    let wide = header.Size > wideThreshold
    let stored = zipEntry{wide: wide, symlink: false, executable: entry.Executable, method: int(compression), compressed: 0, header: header, crc: 0, flags: zipUTF8 | zipStreamed, offset: offset}
    let metadataSize = 46 + header.Name.len() + stored.extraSize()
    if metadataSize > MaxMetadataBytes - w.metadata {
        return error("archive: metadata byte limit exceeded")
    }
    var extra = 0
    if wide {
        extra = 20
    }
    var record = zeros(30 + header.Name.len() + extra)
    put32(record[:], 0, zipLocal)
    put16(record[:], 6, zipUTF8 | zipStreamed)
    put16(record[:], 8, int(compression))
    put16(record[:], 12, 33)
    put16(record[:], 26, header.Name.len())
    putText(record[:], 30, header.Name)
    if wide {
        put16(record[:], 4, 45)
        put32(record[:], 18, marker32)
        put32(record[:], 22, marker32)
        put16(record[:], 28, extra)
        put16(record[:], 30 + header.Name.len(), 1)
        put16(record[:], 32 + header.Name.len(), 16)
    } else {
        put16(record[:], 4, 20)
    }
    let _, err = w.output.Write(record[:])
    if err != nil {
        return err
    }
    w.entries.push(stored)
    w.metadata += metadataSize
    w.declared += header.Size
    w.payloadStart = w.output.count
    w.encoder = flate.NewEncoder(header.Size, MaxBytes)?
    w.remaining = header.Size
    w.crc = 0
    w.active = true
    return nil
}

func (w mut ZIPWriter<W>) WriteHeader(header Header) error {
    return w.WriteHeaderWith(header, Store)
}

func (w mut ZIPWriter<W>) WriteHeaderWith(header Header, compression Compression) error {
    return w.WriteEntryWith(plainEntry(header), compression)
}

func (w mut ZIPWriter<W>) WriteEntry(entry Entry) error {
    return w.WriteEntryWith(entry, Store)
}

func (w mut ZIPWriter<W>) WriteEntryWith(entry Entry, compression Compression) error {
    if w.finished {
        return error("archive: writer finished")
    }
    if w.err == nil {
        w.err = w.start(entry, compression)
    }
    return w.err
}

func (w mut ZIPWriter<W>) Write(data []byte) (int, error) {
    if w.err != nil {
        return 0, w.err
    }
    if w.finished {
        return 0, error("archive: writer finished")
    }
    if !w.active {
        w.err = error("archive: no writable ZIP entry");
        return 0, w.err
    }
    if data.len() > w.remaining {
        w.err = error("archive: entry size exceeded");
        return 0, w.err
    }
    let count, err = w.payload(data)
    w.crc = crc32.Update(w.crc, data[:count])
    w.remaining -= count
    w.err = err
    return count, err
}

func (w mut ZIPWriter<W>) directory() error {
    let centralOffset = w.output.count
    for entry in w.entries {
        var wideValues = Array<int>{}
        var size = entry.header.Size
        var compressed = entry.compressed
        var offset = entry.offset
        if size >= marker32 {
            wideValues.push(size)
            size = marker32
        }
        if compressed >= marker32 {
            wideValues.push(compressed)
            compressed = marker32
        }
        if offset >= marker32 {
            wideValues.push(offset)
            offset = marker32
        }
        let extra = entry.extraSize()
        let name = entry.header.Name
        var record = zeros(46 + name.len() + extra)
        put32(record[:], 0, zipCentral)
        var version = 20
        if entry.wide || extra > 0 {
            version = 45
        }
        var madeBy = version
        if entry.executable {
            madeBy = 0x0300 | version
        }
        put16(record[:], 4, madeBy)
        put16(record[:], 6, version)
        put16(record[:], 8, entry.flags)
        put16(record[:], 10, entry.method)
        put16(record[:], 14, 33)
        put32(record[:], 16, int(entry.crc))
        put32(record[:], 20, compressed)
        put32(record[:], 24, size)
        put16(record[:], 28, name.len())
        put16(record[:], 30, extra)
        if entry.header.Directory {
            put32(record[:], 38, 16)
        } else if entry.executable {
            put32(record[:], 38, 0o100755 << 16)
        }
        put32(record[:], 42, offset)
        putText(record[:], 46, name)
        if extra > 0 {
            put16(record[:], 46 + name.len(), 1)
            put16(record[:], 48 + name.len(), extra - 4)
            for var i = 0; i < wideValues.len(); i += 1 {
                put64(record[:], 50 + name.len() + 8 * i, wideValues[i])
            }
        }
        let _, err = w.output.Write(record[:])
        if err != nil {
            return err
        }
    }
    let count = w.entries.len()
    let centralSize = w.output.count - centralOffset
    if count >= marker16 || centralSize >= marker32 || centralOffset >= marker32 {
        let recordOffset = w.output.count
        var wideEnd = zeros(76)
        put32(wideEnd[:], 0, zip64End)
        put64(wideEnd[:], 4, 44)
        put16(wideEnd[:], 12, 45)
        put16(wideEnd[:], 14, 45)
        put64(wideEnd[:], 24, count)
        put64(wideEnd[:], 32, count)
        put64(wideEnd[:], 40, centralSize)
        put64(wideEnd[:], 48, centralOffset)
        put32(wideEnd[:], 56, zip64Locator)
        put64(wideEnd[:], 64, recordOffset)
        put32(wideEnd[:], 72, 1)
        let _, wideErr = w.output.Write(wideEnd[:])
        if wideErr != nil {
            return wideErr
        }
    }
    var end = zeros(22)
    put32(end[:], 0, zipEnd)
    put16(end[:], 8, smaller(count, marker16))
    put16(end[:], 10, smaller(count, marker16))
    put32(end[:], 12, smaller(centralSize, marker32))
    put32(end[:], 16, smaller(centralOffset, marker32))
    let _, err = w.output.Write(end[:])
    return err
}

func (w mut ZIPWriter<W>) Finish() error {
    if w.err != nil {
        return w.err
    }
    if w.finished {
        return nil
    }
    w.err = w.finishEntry()
    if w.err != nil {
        return w.err
    }
    w.err = w.directory()
    if w.err == nil {
        w.finished = true
    }
    return w.err
}

func (w own ZIPWriter<W>) Close() error {
    var writer = w
    return writer.Finish()
}

func (w own ZIPWriter<W>) Sink() (W, error) {
    var writer = w
    let err = writer.Finish()
    return writer.output.sink, err
}

type zipInput struct {
    source io.ReadSeeker
    remaining int
    framed bool
    chunk Array<byte>
    cursor int
    used int
    pending error
}

func (s mut zipInput) Seek(offset int, whence int) (int, error) {
    s.cursor = 0
    s.used = 0
    s.pending = nil
    s.framed = false
    return s.source.Seek(offset, whence)
}

func (s mut zipInput) Read(buf mut []byte) (int, error) {
    if !s.framed {
        return s.source.Read(buf)
    }
    if buf.len() == 0 {
        return 0, nil
    }
    if s.cursor == s.used {
        if s.pending != nil {
            return 0, s.pending
        }
        if s.remaining == 0 {
            return 0, io.EOF
        }
        var want = s.remaining
        if want > s.chunk.len() {
            want = s.chunk.len()
        }
        let count, err = readSome(s.source, s.chunk[:want])
        s.cursor = 0
        s.used = count
        s.remaining -= count
        s.pending = err
        if err != nil && err != io.EOF {
            return 0, err
        }
        if count == 0 {
            return 0, err
        }
    }
    var count = buf.len()
    if count > s.used - s.cursor {
        count = s.used - s.cursor
    }
    for var i = 0; i < count; i += 1 {
        buf[i] = s.chunk[s.cursor + i]
    }
    s.cursor += count
    return count, nil
}

func (r mut ZIPReader) payload(buf mut []byte) (int, error) {
    if r.entries[r.cursor - 1].method == 0 {
        return readSome(r.source, buf)
    }
    let count, err = flate.Read(r.decoder, r.source, buf)
    if err == io.EOF {
        if count != r.remaining {
            return count, error("archive: short ZIP DEFLATE output")
        }
        return count, nil
    }
    return count, err
}

func (w mut ZIPWriter<W>) payload(data []byte) (int, error) {
    if w.entries[w.entries.len() - 1].method == 8 {
        return flate.Write(w.encoder, w.output, data)
    }
    return w.output.Write(data)
}
