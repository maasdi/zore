package archive

import "std/io"
import "std/strings"

const tarRecord = 512

func octal(data []byte) (int, error) {
    var value = 0
    var ended = false
    var started = false
    for octet in data {
        if octet == 0 || octet == 32 {
            if started || octet == 0 {
                ended = true
            }
        } else {
            if ended || octet < 48 || octet > 55 {
                return 0, error("archive: invalid TAR octal field")
            }
            started = true
            value = value * 8 + int(octet - 48)
        }
    }
    return value, nil
}

func tarText(data []byte) (string, error) {
    var end = data.len()
    for var i = 0; i < data.len(); i += 1 {
        if data[i] == 0 {
            end = i
            if !allZero(data[i:]) {
                return "", error("archive: invalid TAR text padding")
            }
            break
        }
    }
    return strings.FromBytes(data[:end])
}

const paxLimit = 65536

type tarFields struct {
    kind byte
    name string
    size int
}

func tarMagic(block []byte) (bool, error) {
    if block[257] != 117 || block[258] != 115 || block[259] != 116 || block[260] != 97 || block[261] != 114 {
        return false, error("archive: unsupported TAR format")
    }
    if block[262] == 0 && block[263] == 48 && block[264] == 48 {
        return false, nil
    }
    if block[262] == 32 && block[263] == 32 && block[264] == 0 {
        return true, nil
    }
    return false, error("archive: unsupported TAR format")
}

func tarRecordFields(block []byte) (tarFields, error) {
    let none = tarFields{kind: 0, name: "", size: 0}
    let expected = octal(block[148:156])?
    var sum = 0
    for var i = 0; i < tarRecord; i += 1 {
        if i >= 148 && i < 156 {
            sum += 32
        } else {
            sum += int(block[i])
        }
    }
    if expected != sum {
        return none, error("archive: TAR header checksum mismatch")
    }
    let gnu = tarMagic(block)?
    let kind = block[156]
    if kind == 49 || kind == 50 || kind == 75 {
        return none, error("archive: TAR link target is unsupported")
    }
    if kind == 83 {
        return none, error("archive: sparse TAR entries are unsupported")
    }
    if kind != 0 && kind != 48 && kind != 53 && kind != 120 && kind != 103 && kind != 76 {
        return none, error("archive: unsupported TAR entry type")
    }
    if !allZero(block[157:257]) {
        return none, error("archive: TAR link target is unsupported")
    }
    let _, modeErr = octal(block[100:108])
    if modeErr != nil {
        return none, modeErr
    }
    let _, uidErr = octal(block[108:116])
    if uidErr != nil {
        return none, uidErr
    }
    let _, gidErr = octal(block[116:124])
    if gidErr != nil {
        return none, gidErr
    }
    let _, timeErr = octal(block[136:148])
    if timeErr != nil {
        return none, timeErr
    }
    let _, majorErr = octal(block[329:337])
    if majorErr != nil {
        return none, majorErr
    }
    let _, minorErr = octal(block[337:345])
    if minorErr != nil {
        return none, minorErr
    }
    let size = octal(block[124:136])?
    var name = tarText(block[:100])?
    if !gnu {
        let prefix = tarText(block[345:500])?
        if prefix != "" {
            name = prefix + "/" + name
        }
    } else if block[482] != 0 {
        return none, error("archive: sparse TAR entries are unsupported")
    }
    return tarFields{kind: kind, name: name, size: size}, nil
}

type tarOverride struct {
    path string
    hasPath bool
    size int
    hasSize bool
    longName string
    hasLongName bool
    extended bool
}

func noOverride() tarOverride {
    return tarOverride{path: "", hasPath: false, size: 0, hasSize: false, longName: "", hasLongName: false, extended: false}
}

func paxDecimal(text string) (int, bool) {
    if text.len() == 0 || text.len() > 10 {
        return 0, false
    }
    var value = 0
    for var i = 0; i < text.len(); i += 1 {
        let digit = text[i]
        if digit < 48 || digit > 57 {
            return 0, false
        }
        value = value * 10 + int(digit - 48)
    }
    return value, true
}

func paxRecords(data []byte, global bool, override mut tarOverride) error {
    var at = 0
    for at < data.len() {
        var space = at
        for space < data.len() && data[space] != 32 {
            space += 1
        }
        if space == data.len() || space == at || space - at > 7 || data[at] == 48 {
            return error("archive: invalid PAX record")
        }
        var length = 0
        for var i = at; i < space; i += 1 {
            if data[i] < 48 || data[i] > 57 {
                return error("archive: invalid PAX record")
            }
            length = length * 10 + int(data[i] - 48)
        }
        if length > data.len() - at || length < space - at + 3 || data[at + length - 1] != 10 {
            return error("archive: invalid PAX record")
        }
        let record = data[space + 1:at + length - 1]
        var equals = 0
        for equals < record.len() && record[equals] != 61 {
            equals += 1
        }
        if equals == 0 || equals == record.len() {
            return error("archive: invalid PAX record")
        }
        let key = strings.FromBytes(record[:equals])?
        let value = strings.FromBytes(record[equals + 1:])?
        at += length
        let sparse = strings.HasPrefix(key, "GNU.sparse.")
        if sparse {
            return error("archive: sparse TAR entries are unsupported")
        }
        if key == "linkpath" {
            return error("archive: TAR link target is unsupported")
        }
        if key == "hdrcharset" && value != "ISO-IR 10646 2000 UTF-8" {
            return error("archive: unsupported PAX character set")
        }
        if global && (key == "path" || key == "size") {
            return error("archive: unsupported PAX global header")
        }
        if key == "path" {
            override.path = value
            override.hasPath = value != ""
        }
        if key == "size" {
            if value == "" {
                override.hasSize = false
            } else {
                let size, valid = paxDecimal(value)
                if !valid || size > MaxBytes {
                    return error("archive: invalid PAX size")
                }
                override.size = size
                override.hasSize = true
            }
        }
    }
    return nil
}

func tarEntry(fields tarFields, override tarOverride) (Header, bool, error) {
    let directory = fields.kind == 53
    var name = fields.name
    var extended = false
    if override.hasPath {
        name = override.path
        extended = true
    } else if override.hasLongName {
        name = override.longName
        extended = true
    }
    if extended && directory && !strings.HasSuffix(name, "/") {
        name = name + "/"
    }
    for strings.HasPrefix(name, "./") {
        name = name[2:]
    }
    var size = fields.size
    if override.hasSize {
        size = override.size
    }
    if directory && (name == "" || name == ".") && size == 0 {
        return absent(), false, nil
    }
    let header = Header{Name: name, Size: size, Directory: directory}
    validate(header)?
    return header, true, nil
}

func putOctal(data mut []byte, at int, width int, value int) {
    var rest = value
    data[at + width - 1] = 0
    for var i = width - 2; i >= 0; i -= 1 {
        data[at + i] = byte(48 + rest % 8)
        rest /= 8
    }
}

func ustarBlock(name string, prefix string, kind byte, mode int, size int) Array<byte> {
    var block = zeros(tarRecord)
    putText(block[:], 0, name)
    putText(block[:], 345, prefix)
    block[156] = kind
    putOctal(block[:], 100, 8, mode)
    putOctal(block[:], 108, 8, 0)
    putOctal(block[:], 116, 8, 0)
    putOctal(block[:], 124, 12, size)
    putOctal(block[:], 136, 12, 0)
    putText(block[:], 257, "ustar")
    putText(block[:], 263, "00")
    for var i = 148; i < 156; i += 1 {
        block[i] = 32
    }
    var sum = 0
    for value in block {
        sum += int(value)
    }
    putOctal(block[:], 148, 7, sum)
    block[155] = 32
    return block
}

func shortName(name string, directory bool) string {
    var end = 100
    if directory {
        end = 99
    }
    for end > 0 && name[end] >= 128 && name[end] < 192 {
        end -= 1
    }
    if directory {
        return name[:end] + "/"
    }
    return name[:end]
}

func paxPathRecord(name string) Array<byte> {
    let base = 7 + name.len()
    var digits = 1
    var limit = 10
    for base + digits >= limit {
        digits += 1
        limit *= 10
    }
    var length = base + digits
    var text = Array<byte>{}
    var divisor = 1
    for var i = 1; i < digits; i += 1 {
        divisor *= 10
    }
    for divisor > 0 {
        text.push(byte(48 + length / divisor % 10))
        divisor /= 10
    }
    for value in strings.Bytes(" path=" + name + "\n") {
        text.push(value)
    }
    return text
}

func encodeTAR(header Header) (Array<byte>, error) {
    validate(header)?
    var name = header.Name
    var prefix = ""
    var extended = Array<byte>{}
    if name.len() > 100 {
        var split = -1
        for var i = 0; i < name.len(); i += 1 {
            if name[i] == 47 && i <= 155 && name.len() - i - 1 <= 100 && (header.Directory || i + 1 < name.len()) {
                split = i
            }
        }
        if split < 0 {
            let record = paxPathRecord(header.Name)
            extended = ustarBlock("././@PaxHeader", "", 120, 0o644, record.len())
            for value in record {
                extended.push(value)
            }
            for extended.len() % tarRecord != 0 {
                extended.push(0)
            }
            name = shortName(header.Name, header.Directory)
        } else {
            prefix = name[:split]
            name = name[split + 1:]
        }
    }
    var kind = byte(48)
    var mode = 0o644
    if header.Directory {
        kind = 53
        mode = 0o755
    }
    let block = ustarBlock(name, prefix, kind, mode, header.Size)
    for value in block {
        extended.push(value)
    }
    return extended, nil
}

type TARReader struct {
    source io.Reader
    archiveLimit int
    dataLimit int
    entryLimit int
    consumed int
    declared int
    entries int
    remaining int
    padding int
    active bool
    ended bool
    pending error
    err error
}

func NewTARReader(source own io.Reader, archiveLimit int, dataLimit int, entryLimit int) (TARReader, error) {
    var reader = TARReader{source: source, archiveLimit: archiveLimit, dataLimit: dataLimit, entryLimit: entryLimit, consumed: 0, declared: 0, entries: 0, remaining: 0, padding: 0, active: false, ended: false, pending: nil, err: nil}
    if !validLimits(archiveLimit, dataLimit, entryLimit) {
        reader.err = error("archive: invalid limit")
    }
    let err = reader.err
    return reader, err
}

func (r mut TARReader) pull(buf mut []byte) (int, error) {
    if r.pending != nil {
        return 0, r.pending
    }
    let room = r.archiveLimit - r.consumed
    var want = buf.len()
    if want > room {
        want = room + 1
    }
    let count, err = readSome(r.source, buf[:want])
    r.consumed += count
    if count > room {
        _ = err
        return room, error("archive: archive byte limit exceeded")
    }
    if count > 0 {
        r.pending = err
        return count, nil
    }
    return count, err
}

func (r mut TARReader) exact(buf mut []byte) error {
    var offset = 0
    for offset < buf.len() {
        let count, err = r.pull(buf[offset:])
        offset += count
        if err != nil {
            if err == io.EOF {
                return error("archive: truncated TAR stream")
            }
            return err
        }
    }
    return nil
}

func (r mut TARReader) finishEntry() error {
    if r.remaining != 0 {
        return error("archive: unread TAR entry data")
    }
    if r.active {
        if r.pending != nil && r.pending != io.EOF {
            return r.pending
        }
        var padding = zeros(r.padding)
        r.exact(padding[:])?
        if !allZero(padding[:]) {
            return error("archive: nonzero TAR padding")
        }
        r.active = false
    }
    return nil
}

func (r mut TARReader) nextHeader() (Header, bool, error) {
    r.finishEntry()?
    var block = zeros(tarRecord)
    var override = noOverride()
    for {
        r.exact(block[:])?
        if allZero(block[:]) {
            break
        }
        let fields = tarRecordFields(block[:])?
        if fields.kind == 120 || fields.kind == 103 || fields.kind == 76 {
            r.extension(fields, override)?
            continue
        }
        let header, kept = tarEntry(fields, override)?
        if !kept {
            override = noOverride()
            continue
        }
        return r.accept(header)
    }
    if override.extended || override.hasLongName {
        return absent(), false, error("archive: TAR extended header without entry")
    }
    r.exact(block[:])?
    if !allZero(block[:]) {
        return absent(), false, error("archive: invalid TAR end records")
    }
    for {
        let count, err = r.pull(block[:])
        if !allZero(block[:count]) {
            _ = err;
            return absent(), false, error("archive: trailing TAR data")
        }
        if err != nil {
            if err == io.EOF {
                r.ended = true;
                return absent(), false, nil
            }
            return absent(), false, err
        }
    }
}

func (r mut TARReader) extension(fields tarFields, override mut tarOverride) error {
    var limit = paxLimit
    if fields.kind == 76 {
        limit = MaxNameBytes + 1
    }
    if fields.size > limit {
        return error("archive: TAR extended header too large")
    }
    if (fields.kind == 120 && override.extended) || (fields.kind == 76 && override.hasLongName) {
        return error("archive: repeated TAR extended header")
    }
    var payload = zeros(fields.size)
    r.exact(payload[:])?
    var padding = zeros((tarRecord - fields.size % tarRecord) % tarRecord)
    r.exact(padding[:])?
    if !allZero(padding[:]) {
        return error("archive: nonzero TAR padding")
    }
    if fields.kind == 76 {
        override.longName = tarText(payload[:])?
        override.hasLongName = true
        return nil
    }
    if fields.kind == 120 {
        override.extended = true
    }
    var ignored = noOverride()
    if fields.kind == 103 {
        return paxRecords(payload[:], true, ignored)
    }
    return paxRecords(payload[:], false, override)
}

func (r mut TARReader) accept(header Header) (Header, bool, error) {
    if r.entries == r.entryLimit {
        return absent(), false, error("archive: entry limit exceeded")
    }
    if header.Size > r.dataLimit - r.declared {
        return absent(), false, error("archive: data byte limit exceeded")
    }
    r.entries += 1
    r.declared += header.Size
    r.remaining = header.Size
    r.padding = (tarRecord - header.Size % tarRecord) % tarRecord
    r.active = true
    return header, true, nil
}

func (r mut TARReader) Next() (Header, bool, error) {
    if r.err != nil {
        return absent(), false, r.err
    }
    if r.ended {
        return absent(), false, nil
    }
    let header, present, err = r.nextHeader()
    r.err = err
    return header, present, err
}

func (r mut TARReader) Read(buf mut []byte) (int, error) {
    if buf.len() == 0 {
        return 0, nil
    }
    if r.err != nil {
        return 0, r.err
    }
    if !r.active {
        return 0, io.EOF
    }
    if r.remaining == 0 {
        r.err = r.finishEntry()
        if r.err != nil {
            return 0, r.err
        }
        return 0, io.EOF
    }
    var want = buf.len()
    if want > r.remaining {
        want = r.remaining
    }
    let count, err = r.pull(buf[:want])
    r.remaining -= count
    if err == io.EOF {
        r.err = error("archive: truncated TAR stream")
    } else {
        r.err = err
    }
    return count, r.err
}

func (r mut TARReader) Skip() error {
    var buf = zeros(4096)
    for {
        let _, err = r.Read(buf[:])
        if err == io.EOF {
            return nil
        }
        if err != nil {
            return err
        }
    }
}

func (r own TARReader) Close() error {
    return r.err
}

type TARWriter<W io.Writer> struct {
    output output<W>
    record Array<byte>
    dataLimit int
    entryLimit int
    declared int
    entries int
    remaining int
    padding int
    active bool
    finished bool
    err error
}

func NewTARWriter<W io.Writer>(sink own W, archiveLimit int, dataLimit int, entryLimit int) (TARWriter<W>, error) {
    var writer = TARWriter<W>{record: zeros(tarRecord), output: output<W>{sink: sink, limit: archiveLimit, count: 0}, dataLimit: dataLimit, entryLimit: entryLimit, declared: 0, entries: 0, remaining: 0, padding: 0, active: false, finished: false, err: nil}
    if !validLimits(archiveLimit, dataLimit, entryLimit) {
        writer.err = error("archive: invalid limit")
    }
    let err = writer.err
    return writer, err
}

func (w mut TARWriter<W>) finishEntry() error {
    if w.remaining != 0 {
        return error("archive: incomplete TAR entry")
    }
    if w.active {
        w.record = zeros(tarRecord)
        let _, err = w.output.Write(w.record[:w.padding])
        if err != nil {
            return err
        }
        w.active = false
    }
    return nil
}

func (w mut TARWriter<W>) start(header Header) error {
    let block = encodeTAR(header)?
    if w.entries == w.entryLimit {
        return error("archive: entry limit exceeded")
    }
    if header.Size > w.dataLimit - w.declared {
        return error("archive: data byte limit exceeded")
    }
    w.finishEntry()?
    w.record = block
    let _, err = w.output.Write(w.record[:])
    if err != nil {
        return err
    }
    w.entries += 1
    w.declared += header.Size
    w.remaining = header.Size
    w.padding = (tarRecord - header.Size % tarRecord) % tarRecord
    w.active = true
    return nil
}

func (w mut TARWriter<W>) WriteHeader(header Header) error {
    if w.finished {
        return error("archive: writer finished")
    }
    if w.err == nil {
        w.err = w.start(header)
    }
    return w.err
}

func (w mut TARWriter<W>) Write(data []byte) (int, error) {
    if w.err != nil {
        return 0, w.err
    }
    if w.finished {
        return 0, error("archive: writer finished")
    }
    if !w.active {
        w.err = error("archive: no writable TAR entry");
        return 0, w.err
    }
    if data.len() > w.remaining {
        w.err = error("archive: entry size exceeded");
        return 0, w.err
    }
    let count, err = w.output.Write(data)
    w.remaining -= count
    w.err = err
    return count, err
}

func (w mut TARWriter<W>) Finish() error {
    if w.err != nil {
        return w.err
    }
    if w.finished {
        return nil
    }
    w.err = w.finishEntry()
    if w.err != nil {
        return w.err
    }
    w.record = zeros(tarRecord)
    for var i = 0; i < 2; i += 1 {
        let _, err = w.output.Write(w.record[:])
        if err != nil {
            w.err = err;
            return err
        }
    }
    w.finished = true
    return nil
}

func (w own TARWriter<W>) Close() error {
    var writer = w
    return writer.Finish()
}

func (w own TARWriter<W>) Sink() (W, error) {
    var writer = w
    let err = writer.Finish()
    return writer.output.sink, err
}
