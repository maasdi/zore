package archive

import "std/errors"
import "std/io"
import "std/os"
import "std/strings"

type extractionReader interface {
    mut Next() (Entry, bool, error)
    mut Read(buf mut []byte) (int, error)
}

type extractionNames struct {
    folded map[string]string
    explicit map[string]bool
    nodes int
    limit int
}

func (n mut extractionNames) add(header Header) error {
    var name = header.Name
    if header.Directory {
        name = name[:name.len() - 1]
    }
    if prior = n.explicit.entry(name) {
        _ = prior;
        return error("archive: duplicate extraction entry")
    }
    n.explicit[name] = true
    var depth = 0
    for var i = 0; i <= name.len(); i += 1 {
        if i < name.len() && name[i] != 47 {
            continue
        }
        depth += 1
        if depth > 64 {
            return error("archive: extraction depth limit exceeded")
        }
        let prefix = name[:i]
        let key = strings.ToUpper(prefix)
        if original = n.folded.entry(key) {
            if original != prefix {
                return error("archive: extraction name alias")
            }
        } else {
            if n.nodes == n.limit {
                return error("archive: extraction node limit exceeded")
            }
            n.folded[key] = prefix
            n.nodes += 1
        }
    }
    return nil
}

type ExtractOptions struct {
    ArchiveLimit int
    DataLimit int
    EntryLimit int
    Links bool
    Merge bool
}

func DefaultExtractOptions(archiveLimit int, dataLimit int, entryLimit int) ExtractOptions {
    return ExtractOptions{ArchiveLimit: archiveLimit, DataLimit: dataLimit, EntryLimit: entryLimit, Links: false, Merge: false}
}

func extractLink(entry Entry, tree mut os.StagedTree) error {
    if entry.Kind == SymlinkEntry {
        return tree.Symlink(entry.Header.Name, entry.Link)
    }
    var target = entry.Link
    for strings.HasPrefix(target, "./") {
        target = target[2:]
    }
    if !ValidName(target, false) {
        return error("archive: invalid hard link target")
    }
    return tree.Link(entry.Header.Name, target)
}

func extract(reader mut extractionReader, tree mut os.StagedTree, entryLimit int, links bool) error {
    var names = extractionNames{folded: map[string]string{}, explicit: map[string]bool{}, nodes: 0, limit: entryLimit}
    for {
        let entry, present, err = reader.Next()
        if err != nil {
            return err
        }
        if !present {
            return nil
        }
        let linked = entry.Kind == SymlinkEntry || entry.Kind == HardLinkEntry
        if linked && !links {
            return error("archive: links are not extracted")
        }
        let header = entry.Header
        names.add(header)?
        if linked {
            extractLink(entry, tree)?
            continue
        }
        if header.Directory {
            tree.Mkdir(header.Name[:header.Name.len() - 1])?
        } else {
            if entry.Executable {
                tree.CreateExecutable(header.Name)?
            } else {
                tree.Create(header.Name)?
            }
            let count, copyErr = io.Copy(tree, reader)
            if copyErr != nil {
                return copyErr
            }
            if count != header.Size {
                return error("archive: extraction size mismatch")
            }
            tree.FinishFile()?
        }
    }
}

func stageFor(destination string, options ExtractOptions) (os.StagedTree, error) {
    if options.Merge {
        return os.StageTreeInto(destination, options.EntryLimit)
    }
    return os.StageTree(destination, options.EntryLimit)
}

func extractInto(reader mut extractionReader, destination string, options ExtractOptions) error {
    var tree = stageFor(destination, options)?
    let err = extract(reader, tree, options.EntryLimit, options.Links)
    if err != nil {
        let cleanup = tree.Abort()
        if cleanup != nil {
            return errors.Wrap(err, "archive: staging cleanup failed: " + errors.Message(cleanup))
        }
        return err
    }
    return tree.Commit()
}

func ExtractTAR(source own io.Reader, destination string, archiveLimit int, dataLimit int, entryLimit int) error {
    return ExtractTARWith(source, destination, DefaultExtractOptions(archiveLimit, dataLimit, entryLimit))
}

func ExtractZIP(source own io.ReadSeeker, destination string, archiveLimit int, dataLimit int, entryLimit int) error {
    return ExtractZIPWith(source, destination, DefaultExtractOptions(archiveLimit, dataLimit, entryLimit))
}

func ExtractTARWith(source own io.Reader, destination string, options ExtractOptions) error {
    var reader = NewTARReader(source, options.ArchiveLimit, options.DataLimit, options.EntryLimit)?
    return extractInto(reader, destination, options)
}

func ExtractZIPWith(source own io.ReadSeeker, destination string, options ExtractOptions) error {
    var reader = NewZIPReader(source, options.ArchiveLimit, options.DataLimit, options.EntryLimit)?
    return extractInto(reader, destination, options)
}
