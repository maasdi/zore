package flate

func zeros(count int) Array<byte> {
    var result = Array<byte>{}
    for var i = 0; i < count; i += 1 {
        result.push(0)
    }
    return result
}

type alphabet struct {
    counts Array<int>
    symbols Array<int>
}

func emptyAlphabet() alphabet {
    return alphabet{counts: Array<int>{}, symbols: Array<int>{}}
}

func makeAlphabet(lengths []int, maximum int, complete bool) (alphabet, error) {
    var counts = Array<int>{}
    var offsets = Array<int>{}
    var symbols = Array<int>{}
    for var i = 0; i <= 15; i += 1 {
        counts.push(0)
        offsets.push(0)
    }
    for length in lengths {
        if length < 0 || length > maximum {
            return emptyAlphabet(), error("flate: invalid Huffman length")
        }
        counts[length] += 1
        symbols.push(0)
    }
    var space = 1
    for var bits = 1; bits <= maximum; bits += 1 {
        space = space * 2 - counts[bits]
        if space < 0 {
            return emptyAlphabet(), error("flate: oversubscribed Huffman tree")
        }
    }
    if space != 0 && (complete || lengths.len() - counts[0] != 1 || counts[1] != 1) {
        if lengths.len() != counts[0] || complete {
            return emptyAlphabet(), error("flate: incomplete Huffman tree")
        }
    }
    for var bits = 1; bits < 15; bits += 1 {
        offsets[bits + 1] = offsets[bits] + counts[bits]
    }
    for var symbol = 0; symbol < lengths.len(); symbol += 1 {
        let length = lengths[symbol]
        if length != 0 {
            symbols[offsets[length]] = symbol
            offsets[length] += 1
        }
    }
    return alphabet{counts: counts, symbols: symbols}, nil
}

func lengthExtra(code int) int {
    if code < 8 || code == 28 {
        return 0
    }
    return code / 4 - 1
}

func lengthBase(code int) int {
    if code < 8 {
        return code + 3
    }
    if code == 28 {
        return 258
    }
    return 3 + ((4 + code % 4) << lengthExtra(code))
}

func distanceExtra(code int) int {
    if code < 4 {
        return 0
    }
    return code / 2 - 1
}

func distanceBase(code int) int {
    if code < 4 {
        return code + 1
    }
    return 1 + ((2 + code % 2) << distanceExtra(code))
}
