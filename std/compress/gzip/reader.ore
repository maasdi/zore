package gzip

import "std/io"
import "std/compress/flate"

const MaxBytes = 1073741824
const MaxMembers = 1024
const headerPhase = 0
const blockPhase = 1
const trailerPhase = 4

func validLimit(limit int) bool {
    return limit >= 0 && limit <= MaxBytes
}

type input struct {
    source io.Reader
    compressedLimit int
    compressed int
    chunk Array<byte>
    cursor int
    used int
    pending error
}

type Reader struct {
    input input
    decoder flate.Decoder
    outputLimit int
    output int
    members int
    memberSize int
    crc int
    phase int
    err error
}

func NewReader(source own io.Reader, compressedLimit int, outputLimit int) (Reader, error) {
    let decoder, _ = flate.NewDecoder(MaxBytes, MaxBytes)
    var reader = Reader{input: input{source: source, compressedLimit: compressedLimit, compressed: 0, chunk: zeros(4096), cursor: 0, used: 0, pending: nil}, decoder: decoder, outputLimit: outputLimit, output: 0, members: 0, memberSize: 0, crc: 4294967295, phase: headerPhase, err: nil}
    if !validLimit(compressedLimit) || !validLimit(outputLimit) {
        reader.err = error("gzip: invalid byte limit")
    }
    let err = reader.err
    return reader, err
}

func (r mut input) raw() (byte, error) {
    var empty = 0
    for r.cursor == r.used {
        if r.pending != nil {
            return 0, r.pending
        }
        var want = r.compressedLimit - r.compressed + 1
        if want > r.chunk.len() {
            want = r.chunk.len()
        }
        let count, err = r.source.Read(r.chunk[:want])
        if count < 0 || count > want {
            _ = err
            return 0, error("gzip: invalid read count")
        }
        r.cursor = 0
        r.used = count
        r.pending = err
        if count == 0 && err == nil {
            empty += 1
            if empty == 100 {
                return 0, error("gzip: no read progress")
            }
        }
    }
    let value = r.chunk[r.cursor]
    r.cursor += 1
    r.compressed += 1
    if r.compressed > r.compressedLimit {
        return 0, error("gzip: compressed byte limit exceeded")
    }
    return value, nil
}

func (r mut input) octet() (byte, error) {
    let value, err = r.raw()
    if err == io.EOF {
        return 0, error("gzip: truncated stream")
    }
    return value, err
}

func (r mut input) Read(buf mut []byte) (int, error) {
    if buf.len() == 0 {
        return 0, nil
    }
    let value, err = r.raw()
    if err != nil {
        return 0, err
    }
    buf[0] = value
    return 1, nil
}

func (r mut Reader) header(first byte) error {
    if r.members == MaxMembers {
        return error("gzip: member limit exceeded")
    }
    r.members += 1
    var crc = crcByte(4294967295, first)
    var head = Array<byte>{first}
    for var i = 1; i < 10; i += 1 {
        let value = r.input.octet()?
        crc = crcByte(crc, value)
        head.push(value)
    }
    let flags = int(head[3])
    if head[0] != 31 || head[1] != 139 || head[2] != 8 || flags & 224 != 0 {
        return error("gzip: invalid header")
    }
    if flags & 4 != 0 {
        let low = r.input.octet()?
        let high = r.input.octet()?
        crc = crcByte(crcByte(crc, low), high)
        let size = int(low) | (int(high) << 8)
        for var i = 0; i < size; i += 1 {
            let value = r.input.octet()?
            crc = crcByte(crc, value)
        }
    }
    for flag in Array<int>{8, 16} {
        if flags & flag != 0 {
            for {
                let value = r.input.octet()?
                crc = crcByte(crc, value)
                if value == 0 {
                    break
                }
            }
        }
    }
    if flags & 2 != 0 {
        let low = r.input.octet()?
        let high = r.input.octet()?
        if (int(low) | (int(high) << 8)) != ((crc ^ 4294967295) & 65535) {
            return error("gzip: header checksum mismatch")
        }
    }
    r.decoder = flate.NewDecoder(MaxBytes, MaxBytes)?
    r.memberSize = 0
    r.crc = 4294967295
    r.phase = blockPhase
    return nil
}

func (r mut Reader) little32() (int, error) {
    var value = 0
    for var i = 0; i < 4; i += 1 {
        let octet = r.input.octet()?
        value |= int(octet) << (i * 8)
    }
    return value, nil
}

func (r mut Reader) trailer() error {
    let crc = r.little32()?
    let size = r.little32()?
    if crc != (r.crc ^ 4294967295) {
        return error("gzip: checksum mismatch")
    }
    if size != r.memberSize {
        return error("gzip: size mismatch")
    }
    r.phase = headerPhase
    return nil
}

func (r mut Reader) next() (byte, error) {
    for {
        if r.phase == headerPhase {
            let first, err = r.input.raw()
            if err != nil {
                if err == io.EOF && r.members == 0 {
                    return 0, error("gzip: truncated stream")
                }
                return 0, err
            }
            r.header(first)?
        } else if r.phase == blockPhase {
            var buf = [byte; 1]{0}
            let count, err = flate.Read(r.decoder, r.input, buf[:])
            if err != nil && err != io.EOF {
                return 0, err
            }
            if count > 0 {
                return buf[0], nil
            }
            r.phase = trailerPhase
        } else {
            r.trailer()?
        }
    }
}

func (r mut Reader) Read(buf mut []byte) (int, error) {
    if buf.len() == 0 {
        return 0, nil
    }
    if r.err != nil {
        return 0, r.err
    }
    var count = 0
    for count < buf.len() {
        let value, err = r.next()
        if err != nil {
            r.err = err
            return count, err
        }
        if r.output == r.outputLimit {
            r.err = error("gzip: output byte limit exceeded")
            return count, r.err
        }
        buf[count] = value
        count += 1
        r.memberSize += 1
        r.output += 1
        r.crc = crcByte(r.crc, value)
    }
    return count, nil
}

func (r own Reader) Close() error {
    if r.err == io.EOF {
        return nil
    }
    return r.err
}
