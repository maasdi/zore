package gzip

import "std/compress/flate"
import "std/io"

type output struct {
    sink io.Writer;
    compressedLimit int;
    compressed int
}

func (w mut output) send(data []byte) error {
    if data.len() > w.compressedLimit - w.compressed {
        return error("gzip: compressed byte limit exceeded")
    }
    var offset = 0
    for offset < data.len() {
        let count, err = w.sink.Write(data[offset:])
        if count < 0 || count > data.len() - offset {
            _ = err
            return error("gzip: invalid write count")
        }
        offset += count
        w.compressed += count
        if err != nil {
            return err
        }
        if count == 0 {
            return error("gzip: no write progress")
        }
    }
    return nil
}

func (w mut output) Write(data []byte) (int, error) {
    let before = w.compressed
    let err = w.send(data)
    return w.compressed - before, err
}

type Writer struct {
    output output
    encoder flate.Encoder
    inputLimit int
    input int
    crc int
    started bool
    finished bool
    err error
}

func NewWriter(sink own io.Writer, inputLimit int, compressedLimit int) (Writer, error) {
    let encoder, _ = flate.NewEncoder(MaxBytes, MaxBytes)
    var writer = Writer{output: output{sink: sink, compressedLimit: compressedLimit, compressed: 0}, encoder: encoder, inputLimit: inputLimit, input: 0, crc: 4294967295, started: false, finished: false, err: nil}
    if !validLimit(inputLimit) || !validLimit(compressedLimit) {
        writer.err = error("gzip: invalid byte limit")
    }
    let err = writer.err
    return writer, err
}

func (w mut Writer) header() error {
    if !w.started {
        w.started = true
        return w.output.send(Array<byte>{31, 139, 8, 0, 0, 0, 0, 0, 0, 255}[:])
    }
    return nil
}

func (w mut Writer) Write(data []byte) (int, error) {
    if w.err != nil {
        return 0, w.err
    }
    if w.finished {
        return 0, error("gzip: writer finished")
    }
    if data.len() > w.inputLimit - w.input {
        w.err = error("gzip: input byte limit exceeded");
        return 0, w.err
    }
    if data.len() == 0 {
        return 0, nil
    }
    w.err = w.header()
    if w.err != nil {
        return 0, w.err
    }
    let count, err = flate.Write(w.encoder, w.output, data)
    for var i = 0; i < count; i += 1 {
        w.crc = crcByte(w.crc, data[i])
    }
    w.input += count
    w.err = err
    return count, err
}

func (w mut Writer) Finish() error {
    if w.err != nil {
        return w.err
    }
    if w.finished {
        return nil
    }
    w.err = w.header()
    if w.err != nil {
        return w.err
    }
    w.err = flate.Finish(w.encoder, w.output)
    if w.err != nil {
        return w.err
    }
    var trailer = Array<byte>{}
    for value in Array<int>{w.crc ^ 4294967295, w.input} {
        for var i = 0; i < 4; i += 1 {
            trailer.push(byte((value >>(8 * i)) & 255))
        }
    }
    w.err = w.output.send(trailer[:])
    if w.err == nil {
        w.finished = true
    }
    return w.err
}

func (w own Writer) Close() error {
    var writer = w;
    return writer.Finish()
}
