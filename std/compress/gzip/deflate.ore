package gzip

import "std/hash/crc32"

func zeros(count int) Array<byte> {
    var result = Array<byte>{}
    for var i = 0; i < count; i += 1 {
        result.push(0)
    }
    return result
}

func crcByte(crc int, value byte) int {
    return int(crc32.UpdateByte(uint32(crc ^ 4294967295), value)) ^ 4294967295
}
