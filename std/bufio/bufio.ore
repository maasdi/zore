package bufio

import "zore/os"
import "zore/strings"

const defaultSize = 4096

type Reader struct {
    file    os.File
    chunk   Array<byte>
    pending Array<byte>
    start   int
    err     error
}

func NewReader(file own os.File) Reader {
    return Reader{file: file, chunk: zeros(defaultSize), pending: Array<byte>{}, start: 0, err: nil}
}

func zeros(count int) Array<byte> {
    var data = Array<byte>{}
    for var i = 0; i < count; i += 1 {
        data.push(0)
    }
    return data
}

func (r mut Reader) fill() bool {
    if r.err != nil {
        return false
    }
    let count, err = r.file.Read(r.chunk[:])
    if r.start > 0 {
        var rest = Array<byte>{}
        for var i = r.start; i < r.pending.len(); i += 1 {
            rest.push(r.pending[i])
        }
        r.pending = rest
        r.start = 0
    }
    for var i = 0; i < count; i += 1 {
        r.pending.push(r.chunk[i])
    }
    if err != nil {
        r.err = err
    }
    return count > 0
}

func (r mut Reader) ReadBytes(delim byte) (Array<byte>, error) {
    var scanned = r.start
    for {
        for scanned < r.pending.len() {
            if r.pending[scanned] == delim {
                return r.take(scanned + 1), nil
            }
            scanned += 1
        }
        let offset = scanned - r.start
        if !r.fill() && r.err != nil {
            let rest = r.take(r.pending.len())
            return rest, r.err
        }
        scanned = r.start + offset
    }
}

func (r mut Reader) take(end int) Array<byte> {
    var piece = Array<byte>{}
    for var i = r.start; i < end; i += 1 {
        piece.push(r.pending[i])
    }
    r.start = end
    return piece
}

func (r mut Reader) ReadString(delim byte) (string, error) {
    let data, err = r.ReadBytes(delim)
    let text, invalid = strings.FromBytes(data[:])
    if invalid != nil {
        _ = err
        return "", error("bufio.Reader: invalid UTF-8")
    }
    return text, err
}

func (r mut Reader) ReadByte() (byte, error) {
    for r.start >= r.pending.len() {
        if !r.fill() && r.err != nil {
            return 0, r.err
        }
    }
    let value = r.pending[r.start]
    r.start += 1
    return value, nil
}

type Scanner struct {
    reader Reader
    token  string
    err    error
    done   bool
}

func NewScanner(file own os.File) Scanner {
    return Scanner{reader: NewReader(file), token: "", err: nil, done: false}
}

func (s mut Scanner) Scan() bool {
    if s.done {
        return false
    }
    let line, err = s.reader.ReadBytes(10)
    if err != nil && line.len() == 0 {
        s.done = true
        s.token = ""
        if err != error("EOF") {
            s.err = err
        }
        return false
    }
    var end = line.len()
    if end > 0 && line[end - 1] == 10 {
        end -= 1
        if end > 0 && line[end - 1] == 13 {
            end -= 1
        }
    }
    let text, invalid = strings.FromBytes(line[:end])
    if invalid != nil {
        s.token = ""
        s.err = error("bufio.Scanner: invalid UTF-8")
        s.done = true
        return false
    }
    s.token = text
    return true
}

func (s Scanner) Text() string {
    return s.token
}

func (s Scanner) Err() error {
    return s.err
}

type Writer struct {
    file    os.File
    pending Array<byte>
    err     error
}

func NewWriter(file own os.File) Writer {
    return Writer{file: file, pending: Array<byte>{}, err: nil}
}

func (w mut Writer) Write(p []byte) (int, error) {
    if w.err != nil {
        return 0, w.err
    }
    for b in p {
        w.pending.push(b)
    }
    if w.pending.len() >= defaultSize {
        let err = w.Flush()
        if err != nil {
            return 0, err
        }
    }
    return p.len(), nil
}

func (w mut Writer) WriteString(s string) (int, error) {
    let data = strings.Bytes(s)
    return w.Write(data[:])
}

func (w mut Writer) WriteByte(c byte) error {
    let _, err = w.Write(Array<byte>{c}[:])
    return err
}

func (w mut Writer) WriteRune(r rune) (int, error) {
    return w.WriteString(string(r))
}

func (w Writer) Buffered() int {
    return w.pending.len()
}

func (w mut Writer) Flush() error {
    if w.err != nil {
        return w.err
    }
    if w.pending.len() == 0 {
        return nil
    }
    let _, err = w.file.Write(w.pending[:])
    w.pending = Array<byte>{}
    if err != nil {
        w.err = err
    }
    return err
}
