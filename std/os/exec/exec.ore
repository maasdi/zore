package exec

type Cmd struct {
    Path string
    Args Array<string>
    Dir  string
}

func Command(name string, args []string) Cmd {
    var all = Array<string>{name}
    for arg in args {
        all.push(arg)
    }
    return Cmd{Path: name, Args: all, Dir: ""}
}

func (c Cmd) Run() error {
    let _, err = run(c.Path, c.Args[:], c.Dir, 0)
    return err
}

func (c Cmd) Output() (Array<byte>, error) {
    return run(c.Path, c.Args[:], c.Dir, 1)
}

func (c Cmd) CombinedOutput() (Array<byte>, error) {
    return run(c.Path, c.Args[:], c.Dir, 2)
}

func run(path string, args []string, dir string, capture int) (Array<byte>, error)
