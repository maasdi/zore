package os

func ReadFile(path string) (Array<byte>, error)
func WriteFile(path string, data []byte, perm int) error
func MkdirAll(path string, perm int) error
func Remove(path string) error
func RemoveAll(path string) error
func Rename(oldPath string, newPath string) error
func Getenv(key string) string
func Getwd() (string, error)
func Args() Array<string>
func Exit(code int)

type DirEntry struct {
    name    string
    dir     bool
    symlink bool
}

func (e DirEntry) Name() string {
    return e.name
}

func (e DirEntry) IsDir() bool {
    return e.dir
}

func (e DirEntry) IsSymlink() bool {
    return e.symlink
}

func ReadDir(path string) (Array<DirEntry>, error) {
    let names, err = dirNames(path)
    var entries = Array<DirEntry>{}
    if err != nil {
        return entries, err
    }
    for tagged in names[:] {
        let kind = tagged[0]
        entries.push(DirEntry{name: tagged[1:], dir: kind == 100, symlink: kind == 108})
    }
    return entries, nil
}

type FileInfo struct {
    name     string
    size     int
    mode     int
    dir      bool
    modified int
    symlink  bool
}

func (i FileInfo) Name() string {
    return i.name
}

func (i FileInfo) Size() int {
    return i.size
}

func (i FileInfo) Mode() int {
    return i.mode
}

func (i FileInfo) IsDir() bool {
    return i.dir
}

func (i FileInfo) ModTime() int {
    return i.modified
}

func (i FileInfo) IsSymlink() bool {
    return i.symlink
}

func Stat(path string) (FileInfo, error) {
    return describe(path, true)
}

func Lstat(path string) (FileInfo, error) {
    return describe(path, false)
}

func describe(path string, follow bool) (FileInfo, error) {
    let fields, err = statFields(path, follow)
    if err != nil {
        return FileInfo{name: "", size: 0, mode: 0, dir: false, modified: 0, symlink: false}, err
    }
    return FileInfo{name: baseName(path), size: fields[0], mode: fields[1], dir: fields[2] == 1, modified: fields[3], symlink: fields[4] == 1}, nil
}

func baseName(path string) string {
    var end = path.len()
    for end > 1 && pathSeparator(path[end - 1]) {
        end -= 1
    }
    var start = end
    for start > 0 && !pathSeparator(path[start - 1]) {
        start -= 1
    }
    return path[start:end]
}

func pathSeparator(value byte) bool
func dirNames(path string) (Array<string>, error)
func statFields(path string, follow bool) (Array<int>, error)
