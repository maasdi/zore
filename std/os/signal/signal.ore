package signal

import "std/context"
import "std/time"

type Signal int
const Interrupt Signal = 1
const Terminate Signal = 2

func subscribe(mask int) (int, error)
func raised(id int) bool
func unsubscribe(id int)

type completion struct { id int; finished channel<bool> }
func (c mut completion) drop() { unsubscribe(c.id); c.finished.close() }

async func watch(ctx context.Context, id int, trigger channel<bool>, finished channel<bool>) {
    let guard = completion{id: id, finished: finished}
    for ctx.Err() == nil {
        if raised(id) {
            trigger.close()
            let _, _ = ctx.Done().receive()
            return
        }
        select {
            case ctx.Done().receive() { return }
            case time.After(10 * time.Millisecond).receive() {}
        }
    }
}

func NotifyContext(parent context.Context, signals []Signal) (context.Context, func(), error) {
    var mask = 0
    for selected in signals {
        if selected != Interrupt && selected != Terminate {
            return context.Background(), func() {}, error("signal.NotifyContext: unsupported signal")
        }
        mask |= 1 << (int(selected) - 1)
    }
    let id, err = subscribe(mask)
    if err != nil { return context.Background(), func() {}, err }
    let trigger = channel<bool>()
    let finished = channel<bool>()
    let ctx, cancel = context.WithCancelOn(parent, trigger)
    go watch(ctx, id, trigger, finished)
    return ctx, func() { cancel(); let _, _ = finished.receive() }, nil
}
