package main

import "std/io"
import "std/log"
import "std/net/http"
import "std/net/url"
import "std/os"
import "std/path/filepath"
import "std/strconv"
import "std/strings"

const nameCookie = "board_name"
const nameCookieSeconds = 2592000
const nameBytes = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789 -_"
const maxNameBytes = 40
const maxNameFormBytes = 1024
const maxTitleBytes = 100
const maxPhotoBytes = 5242880
const multipartOverheadBytes = 65536
const maxUploadBytes = maxPhotoBytes + multipartOverheadBytes
const maxUploadParts = 4
const maxUploadTextBytes = 1024

func validName(name string) bool {
    if name == "" || name.len() > maxNameBytes {
        return false
    }
    for var i = 0; i < name.len(); i += 1 {
        if strings.IndexByte(nameBytes, name[i]) < 0 {
            return false
        }
    }
    return true
}

func visitorName(r http.Request) (string, bool) {
    let cookie, found = r.Cookie(nameCookie)
    if !found {
        return "", false
    }
    let name, err = url.QueryUnescape(cookie.Value)
    if err != nil || !validName(name) {
        return "", false
    }
    return name, true
}

func redirectHome(w mut http.ResponseWriter) error {
    w.SetHeader(http.HeaderLocation, "/")?
    return w.WriteHeader(http.StatusSeeOther)
}

func page(w mut http.ResponseWriter, status int, html string) error {
    let data = strings.Bytes(html)
    w.SetHeader(http.HeaderContentType, "text/html; charset=utf-8")?
    w.SetHeader(http.HeaderContentLength, strconv.Itoa(data.len()))?
    w.WriteHeader(status)?
    let _, err = w.Write(data[:])
    return err
}

func showBoard(board Board, w mut http.ResponseWriter, r mut http.Request) error {
    let name, named = visitorName(r)
    return page(w, http.StatusOK, boardPage(name, named, board.Photos()))
}

func saveName(w mut http.ResponseWriter, r mut http.Request) error {
    let form, err = r.ReadForm(maxNameFormBytes)
    if err == io.LimitExceeded {
        return w.Text(http.StatusContentTooLarge, "the form is too large")
    }
    if err != nil {
        return w.Text(http.StatusBadRequest, "expected a form")
    }
    let raw, _ = form.Get("name")
    let name = strings.TrimSpace(raw)
    if !validName(name) {
        return w.Text(http.StatusBadRequest, "use 1 to " + strconv.Itoa(maxNameBytes) + " letters, digits, spaces, - or _")
    }
    w.SetCookie(nameCookieWith(url.QueryEscape(name), nameCookieSeconds))?
    return redirectHome(w)
}

func forgetName(w mut http.ResponseWriter, r mut http.Request) error {
    w.SetCookie(nameCookieWith("", -1))?
    return redirectHome(w)
}

func nameCookieWith(value string, maxAge int) http.Cookie {
    var cookie = http.NewCookie(nameCookie, value)
    cookie.Path = "/"
    cookie.HttpOnly = true
    cookie.SameSite = "Lax"
    cookie.MaxAge = maxAge
    return cookie
}

func photoExtension(filename string) (string, bool) {
    let ext = strings.ToLower(filepath.Ext(filename))
    let allowed = [string; 5]{".png", ".jpg", ".jpeg", ".gif", ".webp"}
    for candidate in allowed {
        if ext == candidate {
            return ext, true
        }
    }
    return "", false
}

func savePhoto(upload http.FormFile, path string) error {
    var source = upload.Open()?
    var target = os.OpenFile(path, os.OpenWriteOnly | os.OpenCreate | os.OpenExclusive, 420)?
    let _, copyErr = io.Copy(target, source)
    let closeErr = target.Close()
    if copyErr != nil {
        _ = closeErr
        _ = os.Remove(path)
        return copyErr
    }
    if closeErr != nil {
        _ = os.Remove(path)
        return closeErr
    }
    return nil
}

func uploadPhoto(board Board, logger log.Logger, w mut http.ResponseWriter, r mut http.Request) error {
    let owner, named = visitorName(r)
    if !named {
        return w.Text(http.StatusUnauthorized, "choose a name first")
    }
    var limits = http.DefaultMultipartLimits()
    limits.MaxBytes = maxUploadBytes
    limits.MaxFileBytes = maxPhotoBytes
    limits.MaxParts = maxUploadParts
    limits.MaxValueBytes = maxUploadTextBytes
    let form, err = r.ReadMultipartForm(limits)
    if err == io.LimitExceeded {
        return w.Text(http.StatusContentTooLarge, "the upload is too large; photos can be at most 5 MiB")
    }
    if err != nil {
        return w.Text(http.StatusBadRequest, "expected a photo upload form")
    }
    let rawTitle, _ = form.Value("title")
    let title = strings.TrimSpace(rawTitle)
    if title == "" || title.len() > maxTitleBytes {
        return w.Text(http.StatusBadRequest, "the title must have 1 to " + strconv.Itoa(maxTitleBytes) + " bytes")
    }
    let upload, found = form.File("photo")
    if !found {
        return w.Text(http.StatusBadRequest, "choose a photo")
    }
    let ext, allowed = photoExtension(upload.Filename)
    if !allowed {
        return w.Text(http.StatusUnsupportedMediaType, "use a PNG, JPEG, GIF or WebP file")
    }
    let id = board.NextID()
    let file = strconv.Itoa(id) + ext
    let parts = [string; 2]{photoDirectory, file}
    savePhoto(upload, filepath.Join(parts[:]))?
    board.Add(Photo{ID: id, Owner: owner, Title: title, File: file})
    logger.Info("photo {id} added by {owner}", id, owner)
    return redirectHome(w)
}

func servePhoto(w mut http.ResponseWriter, r mut http.Request) error {
    let file, _ = r.PathParam("file")
    return http.ServeFileIn(w, r, photoDirectory, file)
}
