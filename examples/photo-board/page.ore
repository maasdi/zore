package main

import "std/strconv"
import "std/strings"

func escapeHTML(text string) string {
    var result = strings.ReplaceAll(text, "&", "&amp;")
    result = strings.ReplaceAll(result, "<", "&lt;")
    result = strings.ReplaceAll(result, ">", "&gt;")
    result = strings.ReplaceAll(result, "\"", "&quot;")
    return strings.ReplaceAll(result, "'", "&#39;")
}

func boardPage(name string, named bool, token string, photos Array<Photo>) string {
    var html = "<!doctype html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><title>Photo board</title></head>\n<body>\n<h1>Photo board</h1>\n"
    if named {
        html += "<p>Signed in as " + escapeHTML(name) + ".</p>\n"
        html += "<form method=\"post\" action=\"/name/forget\"><input type=\"hidden\" name=\"form\" value=\"" + escapeHTML(token) + "\"><button>Forget my name</button></form>\n"
        html += "<form method=\"post\" action=\"/photos\" enctype=\"multipart/form-data\">\n"
        html += "<input type=\"hidden\" name=\"form\" value=\"" + escapeHTML(token) + "\">\n"
        html += "<input name=\"title\" maxlength=\"" + strconv.Itoa(maxTitleBytes) + "\" required placeholder=\"Title\">\n"
        html += "<input type=\"file\" name=\"photo\" accept=\"image/png,image/jpeg,image/gif,image/webp\" required>\n"
        html += "<button>Upload</button>\n</form>\n"
    } else {
        html += "<form method=\"post\" action=\"/name\">\n"
        html += "<input type=\"hidden\" name=\"login\" value=\"" + escapeHTML(token) + "\">\n"
        html += "<input name=\"name\" maxlength=\"" + strconv.Itoa(maxNameBytes) + "\" required placeholder=\"Your name\">\n"
        html += "<button>Continue</button>\n</form>\n"
    }
    if photos.len() == 0 {
        html += "<p>No photos yet.</p>\n"
    }
    for photo in photos {
        html += "<figure><img src=\"/photos/" + escapeHTML(photo.File) + "\" alt=\"" + escapeHTML(photo.Title) + "\" width=\"320\">"
        html += "<figcaption>" + escapeHTML(photo.Title) + " by " + escapeHTML(photo.Owner) + "</figcaption></figure>\n"
    }
    return html + "</body>\n</html>\n"
}
