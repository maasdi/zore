package main

import "std/os"

func demoFailures() bool {
    let value, _ = os.Getenv("ZORE_TEST_DEMO_FAILURES")
    return value == "1"
}

func requestedFailure() error {
    if demoFailures() {
        return error("intentional returned error")
    }
    return nil
}

func TestReturnedError() error {
    let probe = CleanupProbe{label: "error return"}
    requestedFailure()?
    return nil
}

func TestPanic() {
    let probe = CleanupProbe{label: "panic or normal return"}
    if demoFailures() {
        panic("intentional panic")
    }
}
