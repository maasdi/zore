package main

func classify(n int) string {
    if n < 0 {
        return "negative"
    } else if n == 0 {
        return "zero"
    } else {
        return "positive"
    }
}

func main() {
    println(classify(-5))
    println(classify(0))
    println(classify(7))

    var total = 0
    for var i = 1; i <= 10; i += 1 {
        if i % 2 == 0 {
            continue
        }
        total += i
    }
    println(total)

    var n = 27
    var steps = 0
    for n != 1 {
        if n % 2 == 0 {
            n = n / 2
        } else {
            n = 3 * n + 1
        }
        steps += 1
    }
    println(steps)

    var found = 0
    for {
        found += 7
        if found > 30 {
            break
        }
    }
    println(found)
}
