package main

import "std/strconv"
import "std/strings"

func total(line string) (int, error) {
    var sum = 0
    for field in line.Split(",") {
        let value = strconv.Atoi(field.TrimSpace())?
        sum += value
    }
    return sum, nil
}

func main() {
    let title = "  Zore standard packages  "
    println(title.TrimSpace().ToUpper())
    println(title.Contains("standard"))
    println("a-b-c".ReplaceAll("-", "+"))
    let key, value, found = "lang=zore".Cut("=")
    if found {
        println(key + " is " + value)
    }

    let words = "one two three".Split(" ")
    println(words.len())
    println(strings.Join(words[:], ", "))

    var line = strings.NewBuilder()
    for word in words {
        line.WriteString(word[:1].ToUpper())
    }
    println(line.String())

    let sum, err = total("10, 20, 12")
    if err == nil {
        println("sum is " + strconv.Itoa(sum))
    }
    println(strconv.FormatInt(255, 16))
    let _, failure = total("10, x")
    println(failure == error("strconv.Atoi: parsing \"x\": invalid syntax"))
    println(strconv.Quote("tab\there"))
}
