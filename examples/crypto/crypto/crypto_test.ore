    let multiblockDigest = SHA256(multiblock[:])?
    requireDigest(multiblockDigest[:], Array<byte>{36, 141, 106, 97, 210, 6, 56, 184, 229, 192, 38, 147, 12, 62, 96, 57, 163, 60, 228, 89, 100, 255, 33, 103, 246, 236, 237, 212, 25, 219, 6, 193}[:])
