func TestEqualityCases() {
    let empty = Array<byte>{}
    let left = Array<byte>{0, 128, 255, 0}
    var right = clone(left)
    if !Equal(empty[:], empty[:]) || Equal(left[:], empty[:]) {
        panic("equality lengths")
    }
    if !Equal(left[:], right[:]) {
        panic("equal binary buffers")
    }
    for var i = 0; i < right.len(); i += 1 {
        right[i] ^= 1
        if Equal(left[:], right[:]) {
            panic("unequal binary buffers")
        }
        right[i] ^= 1
    }
}

func TestRandomBoundsAndChunks() error {
    let empty = RandomBytes(0)?
    if empty.len() != 0 {
        panic("zero random size")
    }
    let negative, negativeErr = RandomBytes(-1)
    let oversized, oversizedErr = RandomBytes(1048577)
    let huge, hugeErr = RandomBytes(9223372036854775807)
    if negativeErr == nil {
        panic("negative random size accepted")
    }
    if oversizedErr == nil {
        panic("oversized random size accepted")
    }
    if hugeErr == nil {
        panic("huge random size accepted")
    }
    if negative.len() != 0 || oversized.len() != 0 || huge.len() != 0 {
        panic("partial random output")
    }
    let first = RandomBytes(64)?
    let second = RandomBytes(64)?
    if Equal(first[:], second[:]) {
        panic("random requests repeated the same 64 bytes")
    }
    let one = RandomBytes(1)?
    let large = RandomBytes(1048576)?
    if one.len() != 1 || large.len() != 1048576 {
        panic("random output size")
    }
    return nil
}

async func concurrentCrypto() error {
    let random = RandomBytes(64)?
    let key = strings.Bytes("a task-local HMAC key")
    let expected = HMACSHA256(key[:], random[:])?
    time.Sleep(time.Millisecond)
    let actual = HMACSHA256(key[:], random[:])?
    requireDigest(actual[:], expected[:])
    return nil
}

func TestConcurrentCallsAndAsyncOwnership() error {
    scope {
        let first = go concurrentCrypto()
        let second = go concurrentCrypto()
        let third = go concurrentCrypto()
        first.wait()?
        second.wait()?
        third.wait()?
    }
    return nil
}

func TestNativeFunctionValues() error {
    let hash = nativeSHA256
    let random = nativeRandomBytes
    let bytes = random(16)?
    let digest = hash(bytes[:])?
    if digest.len() != 32 {
        panic("native function value")
    }
    return nil
}

async func firstRandomUse(ready channel<bool>, start channel<bool>) error {
    ready.send(true)
    start.receive()
    let bytes = RandomBytes(64)?
    if bytes.len() != 64 {
        panic("first concurrent random output size")
    }
    return nil
}

func TestConcurrentFirstRandomUse() error {
    let ready = channel<bool>(4)
    let start = channel<bool>()
    let first = go firstRandomUse(ready, start)
    let second = go firstRandomUse(ready, start)
    let third = go firstRandomUse(ready, start)
    let fourth = go firstRandomUse(ready, start)
    for var i = 0; i < 4; i += 1 {
        ready.receive()
    }
    start.close()
    first.wait()?
    second.wait()?
    third.wait()?
    fourth.wait()?
    return nil
}
