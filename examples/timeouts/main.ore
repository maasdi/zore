package main

import "zore/cancel"
import "zore/net"
import "zore/time"

func count(token cancel.Token, results channel<int>) {
    var steps = 0
    for token.Sleep(10) {
        steps += 1
    }
    results.send(steps)
}

func main() {
    let slow = channel<string>()
    select {
        case let answer, ok = slow.receive() {
            println(answer)
        }
        case time.After(50).receive() {
            println("no answer in 50 ms")
        }
    }

    let limit = cancel.WithTimeout(100)
    let results = channel<int>(1)
    go count(limit, results)
    let steps, _ = results.receive()
    println(steps > 0)
    println(limit.Cancelled())

    let listener, listenErr = net.Listen("127.0.0.1:0")
    if listenErr != nil {
        println("listen failed")
        return
    }
    _ = listener.SetTimeout(50)
    let _, acceptErr = listener.Accept()
    println(acceptErr == error("net.Accept: timed out"))
}
