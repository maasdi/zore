package main

import "std/encoding/json"

const maxUserNameBytes = 200

func decodeCreateUser(data []byte) (CreateUserInput, error) {
    var decoder = json.NewDecoder(data)
    decoder.BeginObject()?
    let key = decoder.Key()?
    if key != "name" {
        return CreateUserInput{Name: ""}, error("expected name field")
    }
    let name = decoder.String()?
    decoder.EndObject()?
    decoder.Finish()?
    if name == "" || name.len() > maxUserNameBytes {
        return CreateUserInput{Name: ""}, error("invalid name")
    }
    return CreateUserInput{Name: name}, nil
}
