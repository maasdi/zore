package main

import "std/encoding/json"
import "std/strings"

func encodeJSON<T any>(value T) (string, error) {
    let bytes = json.MarshalWith(value, json.LowerCamel)?
    return strings.FromBytes(bytes[:])
}

func decodeName(data []byte) (string, error) {
    var decoder = json.NewDecoder(data)
    decoder.BeginObject()?
    let key = decoder.Key()?
    if key != "name" { return "", error("expected name field") }
    let name = decoder.String()?
    decoder.EndObject()?
    decoder.Finish()?
    if name == "" || name.len() > 200 { return "", error("invalid name") }
    return name, nil
}
