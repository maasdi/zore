package main

import "std/strings"

type jsonInput struct {
    text string
    at int
}
func (p mut jsonInput) whitespace() {
    for p.at < p.text.len() {
        let c = p.text[p.at]
        if c != 32 && c != 9 && c != 10 && c != 13 { return }
        p.at += 1
    }
}
func (p mut jsonInput) take(c byte) bool {
    p.whitespace()
    if p.at == p.text.len() || p.text[p.at] != c { return false }
    p.at += 1
    return true
}
func (p mut jsonInput) hex4() (int, error) {
    if p.text.len() - p.at < 4 { return 0, error("short Unicode escape") }
    var code = 0
    for var i = 0; i < 4; i += 1 {
        let c = p.text[p.at]
        p.at += 1
        var digit = -1
        if c >= 48 && c <= 57 { digit = int(c) - 48 }
        if c >= 65 && c <= 70 { digit = int(c) - 55 }
        if c >= 97 && c <= 102 { digit = int(c) - 87 }
        if digit < 0 { return 0, error("invalid Unicode escape") }
        code = code * 16 + digit
    }
    return code, nil
}
func (p mut jsonInput) quoted() (string, error) {
    if !p.take(34) { return "", error("expected string") }
    var result = ""
    var start = p.at
    for p.at < p.text.len() {
        let c = p.text[p.at]
        if c < 32 { return "", error("control in string") }
        if c == 34 {
            result += p.text[start:p.at]
            p.at += 1
            return result, nil
        }
        if c != 92 { p.at += 1; continue }
        result += p.text[start:p.at]
        p.at += 1
        if p.at == p.text.len() { return "", error("short escape") }
        let escaped = p.text[p.at]
        p.at += 1
        if escaped == 34 { result += "\"" } else if escaped == 92 { result += "\\" } else if escaped == 47 { result += "/" } else if escaped == 98 { result += "\u0008" } else if escaped == 102 { result += "\u000c" } else if escaped == 110 { result += "\n" } else if escaped == 114 { result += "\r" } else if escaped == 116 { result += "\t" } else if escaped == 117 {
            var code = p.hex4()?
            if code >= 55296 && code <= 56319 {
                if p.text.len() - p.at < 2 || p.text[p.at] != 92 || p.text[p.at + 1] != 117 { return "", error("missing low surrogate") }
                p.at += 2
                let low = p.hex4()?
                if low < 56320 || low > 57343 { return "", error("invalid low surrogate") }
                code = 65536 + (code - 55296) * 1024 + low - 56320
            } else if code >= 56320 && code <= 57343 { return "", error("unpaired surrogate") }
            result += string(rune(code))
        } else { return "", error("invalid escape") }
        start = p.at
    }
    return "", error("unterminated string")
}
func decodeName(data []byte) (string, error) {
    let text = strings.FromBytes(data)?
    var p = jsonInput{text: text, at: 0}
    if !p.take(123) { return "", error("expected object") }
    let key = p.quoted()?
    if key != "name" || !p.take(58) { return "", error("expected name field") }
    let name = p.quoted()?
    if !p.take(125) { return "", error("expected one name field") }
    p.whitespace()
    if p.at != text.len() || name == "" || name.len() > 200 { return "", error("invalid name or trailing data") }
    return name, nil
}
func quoteJSON(text string) string {
    let digits = "0123456789abcdef"
    var result = "\""
    var start = 0
    for var i = 0; i < text.len(); i += 1 {
        let c = text[i]
        if c >= 32 && c != 34 && c != 92 { continue }
        result += text[start:i]
        if c == 34 { result += "\\\"" } else if c == 92 { result += "\\\\" } else { result += "\\u00" + digits[int(c) / 16:int(c) / 16 + 1] + digits[int(c) % 16:int(c) % 16 + 1] }
        start = i + 1
    }
    return result + text[start:] + "\""
}
