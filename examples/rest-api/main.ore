package main

import "std/errors"
import "std/log"
import "std/net/http"
import "std/os"

const listenAddress = "127.0.0.1:8080"

func main() {
    let err = run()
    if err != nil {
        println(errors.Message(err))
        os.Exit(1)
    }
}

func run() error {
    let logger = log.New(os.Stderr(), log.LevelInfo)
    let store = NewUserStore()
    let router = newRouter(store, logger)?
    println("Starting http://" + listenAddress + "; Ctrl-C shuts down gracefully")
    logger.Info("listening on {addr}", listenAddress)
    http.ListenAndServe(listenAddress, router)?
    logger.Info("stopped")
    return logger.Err()
}

func newRouter(store UserStore, logger log.Logger) (http.Router, error) {
    var routes = http.NewRouterBuilder()
    routes.Handle("GET /users", func(w mut http.ResponseWriter, r mut http.Request) error {
        return listUsers(store, w, r)
    })
    routes.Handle("GET /users/{id}", func(w mut http.ResponseWriter, r mut http.Request) error {
        return getUser(store, w, r)
    })
    routes.Handle("POST /users", func(w mut http.ResponseWriter, r mut http.Request) error {
        return createUser(store, logger, w, r)
    })
    return routes.Build()
}
