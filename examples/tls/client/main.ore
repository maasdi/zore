package main

import "tls"
import "std/os"
import "std/time"
import "std/context"
import "std/strings"
import "std/errors"

func request() error {
    let roots = os.ReadFile("../tls/testdata/roots.pem")?
    let config = tls.NewClientConfig(roots[:])?
    let ctx, cancel = context.WithTimeout(context.Background(), 5 * time.Second)
    var conn = tls.DialContext(ctx, "127.0.0.1:8443", "localhost", config)?
    let request = strings.Bytes("GET / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n")
    var sent = 0
    for sent < request.len() {
        sent += conn.Write(request[sent:])?
    }
    var response = Array<byte>{};
    for var i = 0; i < 4096; i += 1 {
        response.push(0)
    }
    let n = conn.Read(response[:])?
    println(strings.FromBytes(response[:n])?)
    cancel()
    return nil
}

func main() {
    let err = request()
    if err != nil {
        println(errors.Message(err))
    }
}
