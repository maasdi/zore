package main

import "tls"
import "std/os"
import "std/net"
import "std/time"
import "std/context"
import "std/strings"
import "std/errors"

func respond(conn own tls.Conn) error {
    var c = conn
    c.SetDeadline(time.Now().Add(5 * time.Second))?
    var request = Array<byte>{};
    for var i = 0; i < 4096; i += 1 {
        request.push(0)
    }
    let n = c.Read(request[:])?
    if n == 0 {
        return error("empty request")
    }
    let response = strings.Bytes("HTTP/1.1 200 OK\r\nContent-Length: 3\r\nConnection: close\r\n\r\nok\n")
    c.Write(response[:])?
    return c.Close()
}

func serveOne() error {
    let cert = os.ReadFile("../tls/testdata/server.pem")?
    let key = os.ReadFile("../tls/testdata/server-key.pem")?
    let config = tls.NewServerConfig(cert[:], key[:])?
    let listener = net.Listen("tcp4", "127.0.0.1:8443")?
    listener.SetDeadline(time.Now().Add(30 * time.Second))?
    let source = listener.Accept()?
    let ctx, cancel = context.WithTimeout(context.Background(), 5 * time.Second)
    let conn, err = tls.Server(ctx, source, config)
    cancel()
    _ = err
    if err != nil {
        return err
    }
    return respond(conn)
}

func main() {
    let err = serveOne()
    if err != nil {
        println(errors.Message(err))
    }
}
