package tls

import "std/net"
import "std/context"
import "std/time"
import "std/errors"
import "std/os"
import "std/strings"

type ClientConfig struct {
    handle int
}

type ServerConfig struct {
    handle int
}

type dialResult struct {
    source net.Conn
    failure error
}

type Conn struct {
    source net.Conn
    handle int
    ctx context.Context
    established bool
    readDeadline time.Instant
    writeDeadline time.Instant
    readLimited bool
    writeLimited bool
    failed bool
    peerClosed bool
    output Array<byte>
    outputPosition int
    input Array<byte>
}

func (c mut ClientConfig) drop() {
    nativeClose(c.handle)
}

func (c mut ServerConfig) drop() {
    nativeClose(c.handle)
}

func (c mut Conn) drop() {
    nativeClose(c.handle)
}

func emptyConn() Conn {
    return wrap(net.EmptyConn(), 0, context.Background())
}

func zeros(size int) Array<byte> {
    var data = Array<byte>{};
    for var i = 0; i < size; i += 1 {
        data.push(0)
    };
    return data
}

func wrap(source own net.Conn, handle int, ctx context.Context) Conn {
    return Conn{source: source, handle: handle, ctx: ctx, established: false, readDeadline: time.Now(), writeDeadline: time.Now(), readLimited: false, writeLimited: false, failed: false, peerClosed: false, output: Array<byte>{}, outputPosition: 0, input: Array<byte>{}}
}

func SystemRoots() (Array<byte>, error) {
    let roots, err = nativeSystemRoots(os.Getenv("SSL_CERT_FILE"))
    _ = err
    return roots, errors.Wrap(err, "tls.SystemRoots")
}

func DefaultClientConfig() (ClientConfig, error) {
    let roots, rootsErr = SystemRoots()
    _ = rootsErr
    if rootsErr != nil {
        return ClientConfig{handle: 0}, errors.Wrap(rootsErr, "tls.DefaultClientConfig")
    }
    let config, configErr = NewClientConfig(roots[:])
    _ = configErr
    return config, errors.Wrap(configErr, "tls.DefaultClientConfig")
}

func NewClientConfig(rootsPEM []byte) (ClientConfig, error) {
    let empty = Array<byte>{}
    let handle, err = nativeConfig(false, rootsPEM, empty[:], 0)
    _ = err
    return ClientConfig{handle: handle}, errors.Wrap(err, "tls.NewClientConfig")
}

func NewServerConfig(chainPEM []byte, keyPEM []byte) (ServerConfig, error) {
    let handle, err = nativeConfig(true, chainPEM, keyPEM, 0)
    _ = err
    return ServerConfig{handle: handle}, errors.Wrap(err, "tls.NewServerConfig")
}

func validName(name string) bool {
    if name.len() == 0 || name.len() > 253 {
        return false
    }
    var named = false
    var label = 0
    var last byte = 0
    for var i = 0; i < name.len(); i += 1 {
        let ch = name[i]
        if ch == 46 {
            if label == 0 || last == 45 {
                return false
            }
            label = 0
        } else {
            if (ch >= 97 && ch <= 122) || (ch >= 65 && ch <= 90) {
                named = true
            } else if !((ch >= 48 && ch <= 57) || ch == 45) {
                return false
            }
            if label == 0 && ch == 45 {
                return false
            }
            if ch == 45 {
                named = true
            }
            label += 1
            if label > 63 {
                return false
            }
        }
        last = ch
    }
    return named && label > 0 && last != 45
}

func canonicalServerName(name string) string {
    if strings.HasSuffix(name, ".") {
        let candidate = name[:name.len() - 1]
        if validName(candidate) {
            return candidate
        }
    }
    return name
}

func decimalOctet(part string) bool {
    if part.len() == 0 || part.len() > 3 || (part.len() > 1 && part[0] == 48) {
        return false
    }
    var value = 0
    for var i = 0; i < part.len(); i += 1 {
        let ch = part[i]
        if ch < 48 || ch > 57 {
            return false
        }
        value = value * 10 + int(ch) - 48
    }
    return value <= 255
}

func ipv4(name string) bool {
    let parts = strings.Split(name, ".")
    if parts.len() != 4 {
        return false
    }
    for part in parts {
        if !decimalOctet(part) {
            return false
        }
    }
    return true
}

func hexGroup(part string) bool {
    if part.len() == 0 || part.len() > 4 {
        return false
    }
    for var i = 0; i < part.len(); i += 1 {
        let ch = part[i]
        if !((ch >= 48 && ch <= 57) || (ch >= 97 && ch <= 102) || (ch >= 65 && ch <= 70)) {
            return false
        }
    }
    return true
}

func ipv6(name string) bool {
    if name.len() < 2 || name.len() > 45 || strings.Count(name, "::") > 1 || strings.Contains(name, ":::") {
        return false
    }
    let compressed = strings.Contains(name, "::")
    if strings.HasPrefix(name, ":") && !strings.HasPrefix(name, "::") {
        return false
    }
    if strings.HasSuffix(name, ":") && !strings.HasSuffix(name, "::") {
        return false
    }
    let parts = strings.Split(name, ":")
    var groups = 0
    for var i = 0; i < parts.len(); i += 1 {
        let part = parts[i]
        if part == "" {
            continue
        }
        if strings.Contains(part, ".") {
            if i != parts.len() - 1 || !ipv4(part) {
                return false
            }
            groups += 2
        } else {
            if !hexGroup(part) {
                return false
            }
            groups += 1
        }
    }
    if compressed {
        return groups < 8
    }
    return groups == 8
}

func ipAddress(name string) bool {
    if strings.Contains(name, ":") {
        return ipv6(name)
    }
    return ipv4(name)
}

func validServerName(name string) bool {
    return validName(name) || ipAddress(name)
}

async func dialSource(address string, timeout time.Duration, result channel<dialResult>) {
    let source, err = net.DialTimeout("tcp", address, timeout)
    _ = err
    result.send(dialResult{source: source, failure: err})
}

func finishDial(ctx context.Context, result channel<dialResult>, serverName string, config ClientConfig) (Conn, error) {
    select {
        case let connected, _ = result.receive() {
            let contextErr = ctx.Err()
            _ = contextErr
            if contextErr != nil {
                return emptyConn(), contextErr
            }
            if connected.failure != nil {
                return emptyConn(), errors.Wrap(connected.failure, "tls.DialContext")
            }
            return Client(ctx, connected.source, serverName, config)
        }
        case ctx.Done().receive() {
            return emptyConn(), ctx.Err()
        }
    }
}

func DialContext(ctx context.Context, address string, serverName string, config ClientConfig) (Conn, error) {
    let name = canonicalServerName(serverName)
    if !validServerName(name) {
        return emptyConn(), error("tls.DialContext: DNS name or IP address required")
    }
    let err = ctx.Err()
    _ = err
    if err != nil {
        return emptyConn(), err
    }
    let deadline, limited = ctx.Deadline()
    var timeout = time.Duration(0)
    if limited {
        timeout = time.Until(deadline)
        if timeout <= 0 {
            return emptyConn(), error("context deadline exceeded")
        }
    }
    let result = channel<dialResult>(1)
    go dialSource(address, timeout, result)
    return finishDial(ctx, result, name, config)
}

func Client(ctx context.Context, source own net.Conn, serverName string, config ClientConfig) (Conn, error) {
    let name = canonicalServerName(serverName)
    if !validServerName(name) {
        return emptyConn(), error("tls.Client: DNS name or IP address required")
    }
    let handle, err = nativeSession(config.handle, name)
    _ = err
    if err != nil {
        return emptyConn(), errors.Wrap(err, "tls.Client")
    }
    return handshake(wrap(source, handle, ctx))
}

func Server(ctx context.Context, source own net.Conn, config ServerConfig) (Conn, error) {
    let handle, err = nativeSession(config.handle, "")
    _ = err
    if err != nil {
        return emptyConn(), errors.Wrap(err, "tls.Server")
    }
    return handshake(wrap(source, handle, ctx))
}

func handshake(conn own Conn) (Conn, error) {
    var c = conn
    for {
        let waitErr = c.check(false)
        _ = waitErr
        if waitErr != nil {
            return emptyConn(), waitErr
        }
        let status, err = nativeHandshake(c.handle)
        _ = err
        let flushErr = c.flush(false)
        _ = flushErr
        if err != nil {
            return emptyConn(), errors.Wrap(err, "tls.Handshake")
        }
        if flushErr != nil {
            return emptyConn(), flushErr
        }
        if status == 1 {
            c.established = true;
            return c, nil
        }
        if status == 0 {
            let receiveErr = c.receive(false)
            _ = receiveErr
            if receiveErr != nil {
                return emptyConn(), receiveErr
            }
        }
    }
}

func (c Conn) checkOpen() error {
    if c.handle == 0 || c.failed {
        return error("tls: closed or failed connection")
    }
    return nil
}

func (c Conn) deadline(writing bool) (time.Instant, bool) {
    if writing {
        return c.writeDeadline, c.writeLimited
    }
    return c.readDeadline, c.readLimited
}

func (c Conn) check(writing bool) error {
    c.checkOpen()?
    if !c.established {
        let err = c.ctx.Err()
        _ = err
        if err != nil {
            return err
        }
        let at, limited = c.ctx.Deadline()
        if limited && !time.Now().Before(at) {
            return error("context deadline exceeded")
        }
    }
    let deadline, set = c.deadline(writing)
    if set && !time.Now().Before(deadline) {
        return error("tls: timed out")
    }
    return nil
}

func (c Conn) waitDeadline(writing bool) (time.Instant, bool) {
    var deadline, set = c.deadline(writing)
    if c.established {
        return deadline, set
    }
    let at, limited = c.ctx.Deadline()
    if limited && (!set || at.Before(deadline)) {
        deadline = at
        set = true
    }
    // Handshake waits wake periodically because cancellation cannot interrupt a socket wait.
    let slice = time.Now().Add(100 * time.Millisecond)
    if !set || slice.Before(deadline) {
        deadline = slice
    }
    return deadline, true
}

func (c Conn) armSource(writing bool) error {
    let deadline, set = c.waitDeadline(writing)
    if !set { return c.source.ClearDeadline() }
    if writing { return c.source.SetWriteDeadline(deadline) }
    return c.source.SetReadDeadline(deadline)
}

func (c mut Conn) flush(writing bool) error {
    if c.outputPosition == c.output.len() {
        let output, err = nativeOutput(c.handle)
        _ = err
        if err != nil {
            return errors.Wrap(err, "tls.Output")
        }
        c.output = output
        c.outputPosition = 0
    }
    for c.outputPosition < c.output.len() {
        let waitErr = c.check(writing)
        _ = waitErr
        if waitErr != nil {
            return waitErr
        }
        let deadlineErr = c.armSource(true)
        _ = deadlineErr
        if deadlineErr != nil {
            return deadlineErr
        }
        let n, writeErr = c.source.Write(c.output[c.outputPosition:])
        _ = writeErr
        c.outputPosition += n
        if writeErr == error("net.Write: timed out") {
            continue
        }
        if writeErr != nil {
            return errors.Wrap(writeErr, "tls.Write ciphertext")
        }
        if n == 0 {
            return error("tls: ciphertext write made no progress")
        }
    }
    return nil
}

func (c mut Conn) receive(writing bool) error {
    if c.input.len() == 0 {
        c.input = zeros(16384)
    }
    for {
        let waitErr = c.check(writing)
        _ = waitErr
        if waitErr != nil {
            return waitErr
        }
        let deadlineErr = c.armSource(false)
        _ = deadlineErr
        if deadlineErr != nil {
            return deadlineErr
        }
        let n, err = c.source.Read(c.input[:])
        _ = err
        if n > 0 {
            return nativeFeed(c.handle, c.input[:n])
        }
        if err == error("net.Read: timed out") {
            continue
        }
        if err == error("EOF") {
            return error("tls: truncated connection without close-notify")
        }
        if err != nil {
            return errors.Wrap(err, "tls.Read ciphertext")
        }
        return error("tls: ciphertext read made no progress")
    }
}

func (c mut Conn) Read(buf mut []byte) (int, error) {
    if c.peerClosed {
        return 0, error("EOF")
    }
    let initialErr = c.check(false)
    _ = initialErr
    if initialErr != nil {
        return 0, initialErr
    }
    let pendingErr = c.flush(false)
    _ = pendingErr
    if pendingErr != nil {
        if pendingErr != error("tls: timed out") {
            c.failed = true
        };
        return 0, pendingErr
    }
    if buf.len() == 0 {
        return 0, nil
    }
    var maximum = buf.len()
    if maximum > 16384 {
        maximum = 16384
    }
    for {
        let data, err = nativeRead(c.handle, maximum)
        _ = err
        if err == error("EOF") {
            c.peerClosed = true;
            return 0, err
        }
        if err != nil {
            _ = c.flush(false);
            c.failed = true;
            return 0, errors.Wrap(err, "tls.Read")
        }
        for var i = 0; i < data.len(); i += 1 {
            buf[i] = data[i]
        }
        let flushErr = c.flush(false)
        _ = flushErr
        if flushErr != nil {
            if flushErr != error("tls: timed out") {
                c.failed = true
            };
            return data.len(), flushErr
        }
        if data.len() > 0 {
            return data.len(), nil
        }
        if nativeStatus(c.handle)? == -2 {
            continue
        }
        let receiveErr = c.receive(false)
        _ = receiveErr
        if receiveErr != nil {
            if receiveErr != error("tls: timed out") {
                c.failed = true
            };
            return 0, receiveErr
        }
    }
}

func (c mut Conn) Write(data []byte) (int, error) {
    if c.peerClosed {
        return 0, error("tls: peer closed connection")
    }
    let initialErr = c.check(true)
    _ = initialErr
    if initialErr != nil {
        return 0, initialErr
    }
    let pendingErr = c.flush(true)
    _ = pendingErr
    if pendingErr != nil {
        if pendingErr != error("tls: timed out") {
            c.failed = true
        };
        return 0, pendingErr
    }
    var accepted = 0
    for accepted < data.len() {
        var end = accepted + 16384
        if end > data.len() {
            end = data.len()
        }
        let n, err = nativeWrite(c.handle, data[accepted:end])
        _ = err
        if err != nil {
            _ = c.flush(true);
            c.failed = true;
            return accepted, errors.Wrap(err, "tls.Write")
        }
        if n > 0 {
            accepted += n
        }
        let flushErr = c.flush(true)
        _ = flushErr
        if flushErr != nil {
            if flushErr != error("tls: timed out") {
                c.failed = true
            };
            return accepted, flushErr
        }
        if n == 0 {
            let receiveErr = c.receive(true)
            _ = receiveErr
            if receiveErr != nil {
                if receiveErr != error("tls: timed out") {
                    c.failed = true
                };
                return accepted, receiveErr
            }
        }
    }
    return accepted, nil
}

func (c mut Conn) SetDeadline(t time.Instant) error {
    c.checkOpen()?
    c.readDeadline = t
    c.writeDeadline = t
    c.readLimited = true
    c.writeLimited = true
    return nil
}

func (c mut Conn) SetReadDeadline(t time.Instant) error {
    c.checkOpen()?
    c.readDeadline = t
    c.readLimited = true
    return nil
}

func (c mut Conn) SetWriteDeadline(t time.Instant) error {
    c.checkOpen()?
    c.writeDeadline = t
    c.writeLimited = true
    return nil
}

func (c mut Conn) ClearDeadline() error {
    c.checkOpen()?
    c.readLimited = false
    c.writeLimited = false
    return nil
}

func (c own Conn) Close() error {
    var conn = c
    if conn.failed {
        return nil
    }
    conn.flush(true)?
    let err = nativeShutdown(conn.handle)
    _ = err
    if err != nil {
        return errors.Wrap(err, "tls.Close")
    }
    return conn.flush(true)
}
