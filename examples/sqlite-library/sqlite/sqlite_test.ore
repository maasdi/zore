package sqlite

import "std/time"
import "std/math"
import "std/os"
import "std/strconv"

func TestParametersAndOwnedRows() error {
    let db = Open(":memory:")?
    var query = db.Prepare("select ?, ?, ?, ?, ?, ?")?
    query.BindNull(1)?
    query.BindInt(2, -9223372036854775807)?
    if query.BindFloat(3, math.NaN()) == nil { panic("NaN was silently accepted") }
    query.BindFloat(3, 1.25)?
    query.BindText(4, "hello\u0000world")?
    var binary = Array<uint8>{0, 255, 128, 1}
    query.BindBytes(5, binary[:])?
    query.BindBytes(6, Array<uint8>{}[:])?
    binary[1] = 2
    if !query.Step()? { panic("missing row") }
    if query.ColumnCount()? != 6 || query.ColumnType(0)? != Null { panic("column metadata") }
    if query.Int(1)? != -9223372036854775807 || query.Float(2)? != 1.25 { panic("numeric binding") }
    let text = query.Text(3)?
    let blob = query.Bytes(4)?
    let empty = query.Bytes(5)?
    if empty.len() != 0 || blob.len() != 4 || blob[1] != 255 { panic("binary binding") }
    if text != "hello\u0000world" { panic("text binding") }
    if query.Step()? { panic("unexpected row") }
    query.Reset()?
    if blob[1] != 255 || text != "hello\u0000world" { panic("borrowed result escaped") }
    query.BindInt(2, 42)?
    query.BindFloat(3, math.Inf(1))?
    if !query.Step()? || query.Int(1)? != 42 || query.Text(3)? != "hello\u0000world" { panic("reset did not keep bindings") }
    if !math.IsInf(query.Float(2)?, 1) { panic("real infinity lost") }
    return nil
}

func TestConnectionLeaseAndClosedHandles() error {
    var db = Open(":memory:")?
    var query = db.Prepare("select 7")?
    db.Close()
    db.Close()
    let unused, closed = db.Prepare("select 1")
    if closed == nil { panic("closed database accepted") }
    if !query.Step()? || query.Int(0)? != 7 { panic("connection lease lost") }
    query.Close()?
    query.Close()?
    let row, failure = query.Step()
    if failure == nil { panic("closed statement accepted") }
    let value, invalid = nativeColumn(-1, 0, Integer)
    if invalid == nil { panic("invalid native token accepted") }
    return nil
}

func executeSQL(db Database, sql string) error {
    var statement = db.Prepare(sql)?
    statement.Step()?
    return nil
}

func countRows(db Database) (int, error) {
    var query = db.Prepare("select count(*) from records")?
    query.Step()?
    return query.Int(0)
}

func executeIn(tx Transaction, sql string) error {
    var statement = tx.Prepare(sql)?
    statement.Step()?
    return nil
}

func abortTransaction(db own Database) error {
    var source = db
    let tx = source.Begin()?
    var insert = tx.Prepare("insert into records values (2)")?
    insert.Step()?
    return nil
}

func TestTransactions() error {
    var db = Open(":memory:")?
    executeSQL(db, "create table records(value integer)")?
    var tx = db.Begin()?
    let unused, moved = db.Prepare("select 1")
    if moved == nil { panic("database token survived Begin") }
    {
        var insert = tx.Prepare("insert into records values (?)")?
        insert.BindInt(1, 1)?
        insert.Step()?
    }
    var committed = tx.Commit()?
    if countRows(committed)? != 1 { panic("commit lost row") }
    let again, completed = tx.Rollback()
    if completed == nil { panic("completed transaction remained usable") }
    var rollback = committed.Begin()?
    {
        var insert = rollback.Prepare("insert into records values (2)")?
        insert.Step()?
    }
    let reverted = rollback.Rollback()?
    if countRows(reverted)? != 1 { panic("rollback retained row") }
    return nil
}

func TestTransactionAbandonmentInvalidatesEscapedStatement() error {
    let db = nativeOpen(":memory:")?
    nativeBegin(db)?
    let statement = nativePrepare(db, "select 1")?
    nativeDropDatabase(db, true)
    let row, failure = nativeStep(statement)
    if failure == nil { panic("abandoned transaction remained usable") }
    nativeFinalize(statement)?
    return nil
}

func TestInvalidQueriesAndPhases() error {
    let invalidDatabase, invalidPath = Open("bad\u0000path")
    if invalidPath == nil { panic("NUL path accepted") }
    let unopened, missingPath = Open(".sqlite-missing-" + strconv.Itoa(time.Now()) + "/data.db")
    if missingPath == nil { panic("missing parent directory accepted") }
    let db = Open(":memory:")?
    for sql in Array<string>{"", " ", "select 1; select 2", "select 1\u0000", "begin", "savepoint x", "not SQL"} {
        let statement, failure = db.Prepare(sql)
        if failure == nil { panic("invalid SQL accepted") }
    }
    var query = db.Prepare("select ?")?
    let before, missing = query.Int(0)
    if missing == nil { panic("read before step accepted") }
    if query.BindInt(0, 1) == nil || query.BindInt(2, 1) == nil { panic("bad parameter accepted") }
    query.BindText(1, "value")?
    query.Step()?
    let value, wrongType = query.Int(0)
    let index, wrongIndex = query.ColumnType(1)
    if wrongType == nil { panic("row type checks bypassed") }
    if wrongIndex == nil { panic("row bounds checks bypassed") }
    if query.BindInt(1, 3) == nil { panic("row phase checks bypassed") }
    query.Step()?
    let row, done = query.Step()
    if done == nil { panic("completed query restarted") }
    if db.SetBusyTimeout(-1) == nil || db.SetBusyTimeout(60001) == nil { panic("bad timeout accepted") }
    executeSQL(db, "create table unique_values(value integer unique)")?
    executeSQL(db, "insert into unique_values values (1)")?
    var duplicate = db.Prepare("insert into unique_values values (1)")?
    let ignored, constraint = duplicate.Step()
    if constraint == nil { panic("constraint failure lost") }
    duplicate.Reset()?
    let retried, repeated = duplicate.Step()
    if repeated == nil { panic("retried constraint failure lost") }
    duplicate.Close()?
    duplicate.Close()?

    return nil
}

async func asyncQuery() error {
    let db = Open(":memory:")?
    var query = db.Prepare("select ?")?
    query.BindText(1, "async")?
    time.Sleep(time.Millisecond)
    if !query.Step()? || query.Text(0)? != "async" { panic("async resource lost") }
    return nil
}

func TestAsyncResourceAcrossWaits() error {
    let task = go asyncQuery()
    return task.wait()
}

func TestPersistenceContentionAndRollbackOnDrop() error {
    let path = ".sqlite-test-" + strconv.Itoa(time.UnixSeconds()) + "-" + strconv.Itoa(time.Now()) + ".db"
    var db = Open(path)?
    executeSQL(db, "create table if not exists records(value integer)")?
    executeSQL(db, "delete from records")?
    var tx = db.Begin()?
    {
        var insert = tx.Prepare("insert into records values (1)")?
        insert.Step()?
    }
    var second = Open(path)?
    second.SetBusyTimeout(2)?
    let blocked, busy = second.Begin()
    if busy == nil { panic("writer contention was ignored") }
    let committed = tx.Commit()?
    if countRows(second)? != 1 { panic("failed Begin lost the database") }
    {
        var retried = second.Begin()?
        let restored = retried.Rollback()?
    }
    abortTransaction(committed)?
    var reopened = Open(path)?
    if countRows(reopened)? != 1 { panic("abandoned transaction did not roll back") }
    reopened.Close()
    os.Remove(path)?
    return nil
}

func TestStrictTextAndEmptyValues() error {
    let db = Open(":memory:")?
    var query = db.Prepare("select cast(x'ff' as text), '', x''")?
    query.Step()?
    let invalid, failure = query.Text(0)
    if failure == nil { panic("invalid UTF-8 escaped") }
    if query.Text(1)? != "" || (query.Bytes(2)?).len() != 0 { panic("empty values lost type") }
    return nil
}

func TestFailedCompletionKeepsTransaction() error {
    var db = Open(":memory:")?
    executeSQL(db, "create table records(value integer)")?
    var tx = db.Begin()?
    var insert = tx.Prepare("insert into records values (1)")?
    let early, failure = tx.Commit()
    if failure == nil { panic("live statement allowed completion") }
    if insert.Step()? { panic("insert returned a row") }
    insert.Close()?
    let committed = tx.Commit()?
    if countRows(committed)? != 1 { panic("retried commit lost row") }
    return nil
}

func TestFailedSQLiteCommitCanBeRepairedOrRolledBack() error {
    let path = ".sqlite-commit-test-" + strconv.Itoa(time.UnixSeconds()) + "-" + strconv.Itoa(time.Now()) + ".db"
    var db = Open(path)?
    executeSQL(db, "pragma foreign_keys=on")?
    executeSQL(db, "create table parent(id integer primary key)")?
    executeSQL(db, "create table child(id integer references parent(id) deferrable initially deferred)")?
    var repaired = db.Begin()?
    executeIn(repaired, "insert into child values (1)")?
    let early, violation = repaired.Commit()
    if violation == nil { panic("deferred foreign key commit succeeded") }
    executeIn(repaired, "insert into parent values (1)")?
    var committed = repaired.Commit()?
    var reverted = committed.Begin()?
    executeIn(reverted, "insert into child values (2)")?
    let late, repeated = reverted.Commit()
    if repeated == nil { panic("second deferred foreign key commit succeeded") }
    var restored = reverted.Rollback()?
    restored.Close()
    var reopened = Open(path)?
    {
        var query = reopened.Prepare("select count(*) from child")?
        query.Step()?
        if query.Int(0)? != 1 { panic("failed SQLite commit was not recoverable") }
    }
    reopened.Close()
    os.Remove(path)?
    return nil
}

async func sumStatement(input own Statement) (int, error) {
    var rows = input
    var total = 0
    for rows.Step()? {
        total += rows.Int(0)?
        time.Sleep(time.Millisecond)
    }
    return total, nil
}

func TestConcurrentStatementsShareSerializedConnection() error {
    let db = Open(":memory:")?
    let first = db.Prepare("with recursive n(v) as (values(1) union all select v+1 from n where v<10) select v from n")?
    let second = db.Prepare("with recursive n(v) as (values(1) union all select v+1 from n where v<10) select v from n")?
    let left = go sumStatement(first)
    let right = go sumStatement(second)
    let leftTotal = left.wait()?
    let rightTotal = right.wait()?
    if leftTotal != 55 || rightTotal != 55 { panic("concurrent connection serialization failed") }
    return nil
}

func TestClearBindingsSetsNullAfterReset() error {
    let db = Open(":memory:")?
    var query = db.Prepare("select ?, ?")?
    query.BindInt(1, 7)?
    query.BindText(2, "kept")?
    if !query.Step()? { panic("missing row") }
    if query.ClearBindings() == nil { panic("ClearBindings accepted during a row") }
    query.Reset()?
    if !query.Step()? || query.Int(0)? != 7 || query.Text(1)? != "kept" { panic("Reset lost bindings") }
    query.Reset()?
    query.ClearBindings()?
    if !query.Step()? || query.ColumnType(0)? != Null || query.ColumnType(1)? != Null { panic("ClearBindings kept values") }
    return nil
}

func TestTransactionCallbackCommitsOnLetDatabase() error {
    let db = Open(":memory:")?
    executeSQL(db, "create table records(value integer)")?
    var calls = 0
    db.Transaction(func(tx mut Transaction) error {
        var insert = tx.Prepare("insert into records values (?)")?
        insert.BindInt(1, 1)?
        insert.Step()?
        insert.Reset()?
        insert.Step()?
        calls += 1
        return nil
    })?
    db.Transaction(func(tx mut Transaction) error {
        return executeIn(tx, "insert into records values (3)")
    })?
    if calls != 1 || countRows(db)? != 3 { panic("callback transactions did not commit") }
    var reused = db.Prepare("select count(*) from records where value = 1")?
    reused.Step()?
    if reused.Int(0)? != 2 { panic("binding was not reused after Reset") }
    return nil
}

func TestTransactionCallbackErrorRollsBack() error {
    let db = Open(":memory:")?
    executeSQL(db, "create table records(value integer)")?
    let stop = error("stop")
    let result = db.Transaction(func(tx mut Transaction) error {
        executeIn(tx, "insert into records values (1)")?
        return stop
    })
    if result != stop || countRows(db)? != 0 { panic("callback error did not roll back") }
    db.Transaction(func(tx mut Transaction) error {
        return executeIn(tx, "insert into records values (2)")
    })?
    if countRows(db)? != 1 { panic("database unusable after rollback") }
    return nil
}

func TestTransactionRejectsExplicitCompletionInCallback() error {
    let db = Open(":memory:")?
    executeSQL(db, "create table records(value integer)")?
    db.Transaction(func(tx mut Transaction) error {
        executeIn(tx, "insert into records values (1)")?
        let committed, commitFailure = tx.Commit()
        let reverted, rollbackFailure = tx.Rollback()
        if commitFailure == nil { panic("callback committed its own transaction") }
        if rollbackFailure == nil { panic("callback rolled back its own transaction") }
        executeIn(tx, "insert into records values (2)")?
        return nil
    })?
    if countRows(db)? != 2 { panic("library did not commit") }
    let stop = error("stop")
    let result = db.Transaction(func(tx mut Transaction) error {
        let committed, commitFailure = tx.Commit()
        let reverted, rollbackFailure = tx.Rollback()
        if commitFailure == nil { panic("callback committed its own transaction") }
        if rollbackFailure == nil { panic("callback rolled back its own transaction") }
        executeIn(tx, "insert into records values (3)")?
        return stop
    })
    if result != stop || countRows(db)? != 2 { panic("error after explicit completion did not roll back") }
    return nil
}

func TestTransactionFinalizesEscapedStatements() error {
    let db = Open(":memory:")?
    executeSQL(db, "create table records(value integer)")?
    var escaped = Statement{handle: 0}
    let result = db.Transaction(func(tx mut Transaction) error {
        executeIn(tx, "insert into records values (1)")?
        escaped = tx.Prepare("select count(*) from records")?
        return nil
    })
    if result == nil { panic("live statement allowed commit") }
    let row, failure = escaped.Step()
    if failure == nil { panic("escaped statement stayed usable") }
    escaped.Close()?
    if countRows(db)? != 0 { panic("failed commit kept rows") }
    return nil
}

func TestTransactionRequiresNoLiveStatementsAndRejectsNesting() error {
    let db = Open(":memory:")?
    executeSQL(db, "create table records(value integer)")?
    var live = db.Prepare("select 1")?
    let blocked = db.Transaction(func(tx mut Transaction) error { return nil })
    if blocked == nil { panic("Transaction ignored a live statement") }
    live.Close()?
    let nested = db.Transaction(func(tx mut Transaction) error {
        executeIn(tx, "insert into records values (1)")?
        return db.Transaction(func(inner mut Transaction) error { return nil })
    })
    if nested == nil || countRows(db)? != 0 { panic("nested Transaction was accepted") }
    return nil
}

func TestTransactionBusyCommitRollsBackAfterTimeout() error {
    let path = ".sqlite-busy-test-" + strconv.Itoa(time.UnixSeconds()) + "-" + strconv.Itoa(time.Now()) + ".db"
    {
        let db = Open(path)?
        executeSQL(db, "create table records(value integer)")?
        executeSQL(db, "insert into records values (0)")?
        db.SetBusyTimeout(2)?
        let reader = Open(path)?
        var rows = reader.Prepare("select value from records")?
        if !rows.Step()? { panic("missing reader row") }
        let busy = db.Transaction(func(tx mut Transaction) error {
            return executeIn(tx, "insert into records values (1)")
        })
        if busy == nil { panic("busy commit succeeded") }
        rows.Close()?
        if countRows(db)? != 1 { panic("busy commit kept rows") }
        db.Transaction(func(tx mut Transaction) error {
            return executeIn(tx, "insert into records values (1)")
        })?
        if countRows(db)? != 2 { panic("retried Transaction lost row") }
    }
    os.Remove(path)?
    return nil
}

async func releaseReader(rows own Statement) error {
    var held = rows
    time.Sleep(20 * time.Millisecond)
    return held.Close()
}

func TestTransactionCommitWaitsForReaderWithinBusyTimeout() error {
    let path = ".sqlite-busy-wait-test-" + strconv.Itoa(time.UnixSeconds()) + "-" + strconv.Itoa(time.Now()) + ".db"
    {
        let db = Open(path)?
        executeSQL(db, "create table records(value integer)")?
        executeSQL(db, "insert into records values (0)")?
        db.SetBusyTimeout(5000)?
        let reader = Open(path)?
        var rows = reader.Prepare("select value from records")?
        if !rows.Step()? { panic("missing reader row") }
        let release = go releaseReader(rows)
        db.Transaction(func(tx mut Transaction) error {
            return executeIn(tx, "insert into records values (1)")
        })?
        release.wait()?
        if countRows(db)? != 2 { panic("commit lost row after waiting") }
    }
    os.Remove(path)?
    return nil
}

func TestScopedTransactionDropRollsBackAndKeepsDatabase() error {
    let db = Open(":memory:")?
    executeSQL(db, "create table records(value integer)")?
    var escaped = Statement{handle: 0}
    nativeBegin(db.handle)?
    {
        let tx = Transaction{handle: db.handle, scoped: true}
        executeIn(tx, "insert into records values (1)")?
        escaped = tx.Prepare("select 1")?
    }
    if countRows(db)? != 1 { panic("scoped Transaction drop completed the transaction") }
    {
        let guard = rollbackGuard{handle: db.handle}
    }
    let row, failure = escaped.Step()
    if failure == nil { panic("guard drop left a statement usable") }
    if countRows(db)? != 0 { panic("guard drop kept rows") }
    db.Transaction(func(tx mut Transaction) error {
        return executeIn(tx, "insert into records values (1)")
    })?
    if countRows(db)? != 1 { panic("database closed by scoped drop") }
    return nil
}

async func asyncTransaction() error {
    let db = Open(":memory:")?
    executeSQL(db, "create table records(value integer)")?
    time.Sleep(time.Millisecond)
    db.Transaction(func(tx mut Transaction) error {
        return executeIn(tx, "insert into records values (1)")
    })?
    time.Sleep(time.Millisecond)
    if countRows(db)? != 1 { panic("async Transaction lost row") }
    return nil
}

func TestTransactionInAsyncCaller() error {
    let task = go asyncTransaction()
    return task.wait()
}

func countValues(db Database) (int, error) {
    var query = db.Prepare("select count(*) from unique_values")?
    query.Step()?
    return query.Int(0)
}

func TestTransactionRolledBackBySQLiteAcceptsOnlyRollback() error {
    var db = Open(":memory:")?
    executeSQL(db, "create table unique_values(value integer unique)")?
    executeSQL(db, "insert into unique_values values (1)")?
    var tx = db.Begin()?
    var pending = tx.Prepare("insert into unique_values values (3)")?
    executeIn(tx, "insert into unique_values values (2)")?
    if executeIn(tx, "insert or rollback into unique_values values (1)") == nil { panic("OR ROLLBACK conflict was accepted") }
    let row, stepFailure = pending.Step()
    if stepFailure == nil { panic("Step ran outside the rolled back transaction") }
    pending.Close()?
    let prepared, prepareFailure = tx.Prepare("select 1")
    if prepareFailure == nil { panic("Prepare accepted after SQLite rollback") }
    let early, commitFailure = tx.Commit()
    if commitFailure == nil { panic("Commit accepted after SQLite rollback") }
    let restored = tx.Rollback()?
    if countValues(restored)? != 1 { panic("rolled back transaction kept rows") }
    let failure = restored.Transaction(func(scoped mut Transaction) error {
        executeIn(scoped, "insert into unique_values values (4)")?
        if executeIn(scoped, "insert or rollback into unique_values values (1)") == nil { panic("OR ROLLBACK conflict was accepted") }
        return executeIn(scoped, "insert into unique_values values (5)")
    })
    if failure == nil || countValues(restored)? != 1 { panic("statements ran outside the rolled back transaction") }
    return nil
}

func replaceAndInsert(db Database, failing bool) error {
    var other = Open(":memory:")?
    return db.Transaction(func(tx mut Transaction) error {
        tx = other.Begin()?
        executeSQL(db, "insert into records values (1)")?
        if failing { return error("stop") }
        return nil
    })
}

func TestTransactionCallbackReplacingItsTransactionStaysAtomic() error {
    let db = Open(":memory:")?
    executeSQL(db, "create table records(value integer)")?
    replaceAndInsert(db, false)?
    if countRows(db)? != 1 { panic("replaced transaction lost the committed write") }
    let failure = replaceAndInsert(db, true)
    if failure == nil || countRows(db)? != 1 { panic("replaced transaction escaped rollback") }
    db.Transaction(func(tx mut Transaction) error {
        return executeIn(tx, "insert into records values (2)")
    })?
    if countRows(db)? != 2 { panic("database unusable after replacement") }
    return nil
}
