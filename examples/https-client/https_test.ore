package main

import "std/context"
import "std/errors"
import "std/io"
import "std/net"
import "std/net/http"
import "std/net/url"
import "std/os"
import "std/strings"
import "std/time"
import "tls"
import "tls/https"

async func serveHTTPS(listener own net.Listener, config own tls.ServerConfig, ctx context.Context, host string) error {
    let accepted = listener.Accept()?
    var conn = tls.Server(ctx, accepted, config)?
    var request = ""
    var one = Array<byte>{0}
    for !strings.HasSuffix(request, "\r\n\r\n") {
        let n = conn.Read(one[:])?
        if n != 1 || request.len() > 4096 {
            return error("invalid HTTPS request")
        }
        request += string(rune(one[0]))
    }
    if !strings.HasPrefix(request, "GET /binary HTTP/1.1\r\nHost: " + host + ":") {
        return error("wrong HTTPS authority or target")
    }
    var response = strings.Bytes("HTTP/1.1 200 OK\r\nContent-Length: 3\r\n\r\n")
    response.push(0)
    response.push(255)
    response.push(128)
    for var position = 0; position < response.len(); position += 1 {
        let n = conn.Write(response[position:position + 1])?
        if n != 1 {
            return error("short HTTPS fixture write")
        }
        time.Sleep(2 * time.Millisecond)
    }
    let _ = conn.Close()
    return nil
}

func httpsCase(host string, certPath string, keyPath string, rootsPath string, expected string) error {
    return httpsRequest(host, certPath, keyPath, rootsPath, expected, false)
}

func streamedBody(client http.Client, ctx context.Context, target string) (int, Array<byte>, error) {
    let empty = Array<byte>{}
    var stream = client.Open(ctx, "GET", target, http.NewHeader(), empty[:], http.DefaultStreamConfig())?
    var body = Array<byte>{}
    var buffer = Array<byte>{0, 0}
    for {
        let n, err = stream.Read(buffer[:])
        for var i = 0; i < n; i += 1 {
            body.push(buffer[i])
        }
        if err == io.EOF {
            break
        }
        if err != nil {
            return 0, Array<byte>{}, err
        }
    }
    let _, complete = stream.Trailers()
    if !complete {
        return 0, Array<byte>{}, error("incomplete HTTPS stream")
    }
    let status = stream.StatusCode()
    stream.Close()?
    return status, body, nil
}

func fetchBinary(client http.Client, ctx context.Context, target string, streamed bool) (int, Array<byte>, error) {
    if streamed {
        return streamedBody(client, ctx, target)
    }
    let response = client.Get(ctx, target)?
    return response.StatusCode, response.Body, nil
}

func httpsRequest(host string, certPath string, keyPath string, rootsPath string, expected string, streamed bool) error {
    let roots = os.ReadFile(rootsPath)?
    let cert = os.ReadFile(certPath)?
    let key = os.ReadFile(keyPath)?
    let serverConfig = tls.NewServerConfig(cert[:], key[:])?
    let transport = https.NewTransport(roots[:])?
    var settings = http.DefaultClientConfig()
    settings.Timeout = 3 * time.Second
    settings.PollInterval = time.Millisecond
    let client = http.NewClientWithTransport(settings, transport)?
    let listener = net.Listen("tcp4", "127.0.0.1:0")?
    let _, port, found = strings.Cut(listener.Addr(), ":")
    if !found {
        return error("listener port")
    }
    listener.SetDeadline(time.Now().Add(3 * time.Second))?
    let ctx, cancel = context.WithTimeout(context.Background(), 3 * time.Second)
    let server = go serveHTTPS(listener, serverConfig, ctx, host)
    let target = "https://" + host + ":" + port + "/binary"
    let status, body, err = fetchBinary(client, ctx, target, streamed)
    if expected == "" {
        if err != nil {
            cancel();
            return err
        }
        if status != 200 || body.len() != 3 || body[0] != 0 || body[1] != 255 || body[2] != 128 {
            panic("HTTPS binary response")
        }
    } else {
        if err == nil || body.len() != 0 {
            panic("unverified HTTPS accepted")
        }
        if !strings.Contains(errors.Message(err), expected) {
            panic(errors.Message(err))
        }
    }
    let servingErr = server.wait()
    cancel()
    if expected == "" && servingErr != nil {
        return servingErr
    }
    _ = servingErr
    return nil
}

func TestHTTPSDoVerifiesPeerAndPreservesFragmentedBinaryBytes() error {
    return httpsCase("localhost", "../../packages/tls/testdata/server.pem", "../../packages/tls/testdata/server-key.pem", "../../packages/tls/testdata/roots.pem", "")
}

func TestHTTPSOpenStreamsVerifiedFragmentedBinaryBytes() error {
    httpsRequest("localhost", "../../packages/tls/testdata/server.pem", "../../packages/tls/testdata/server-key.pem", "../../packages/tls/testdata/roots.pem", "", true)?
    return httpsRequest("localhost", "testdata/wrong-host.pem", "../../packages/tls/testdata/server-key.pem", "testdata/wrong-host.pem", "does not match", true)
}

type uploadSource struct {
    data Array<byte>
    at int
}

func (s mut uploadSource) Read(buf mut []byte) (int, error) {
    if s.at == s.data.len() {
        return 0, io.EOF
    }
    buf[0] = s.data[s.at]
    s.at += 1
    return 1, nil
}

async func serveUpload(listener own net.Listener, config own tls.ServerConfig, ctx context.Context) error {
    let accepted = listener.Accept()?
    var conn = tls.Server(ctx, accepted, config)?
    conn.SetReadDeadline(time.Now().Add(3 * time.Second))?
    var request = ""
    var one = Array<byte>{0}
    for !strings.HasSuffix(request, "\r\n\r\n") {
        let n = conn.Read(one[:])?
        if n != 1 || request.len() > 4096 {
            return error("invalid HTTPS upload head")
        }
        request += string(rune(one[0]))
    }
    if !strings.HasPrefix(request, "PUT /upload HTTP/1.1\r\n") || !strings.Contains(request, "\r\nContent-Length: 3\r\n") {
        return error("wrong HTTPS upload head")
    }
    var body = Array<byte>{}
    for body.len() < 3 {
        let n = conn.Read(one[:])?
        if n != 1 {
            return error("HTTPS upload body stalled")
        }
        body.push(one[0])
    }
    if body[0] != 0 || body[1] != 255 || body[2] != 128 {
        return error("HTTPS upload bytes changed")
    }
    conn.Write(strings.Bytes("HTTP/1.1 201 Created\r\nContent-Length: 0\r\n\r\n")[:])?
    let _ = conn.Close()
    return nil
}

func TestHTTPSUploadStreamsVerifiedBinaryBody() error {
    let roots = os.ReadFile("../../packages/tls/testdata/roots.pem")?
    let cert = os.ReadFile("../../packages/tls/testdata/server.pem")?
    let key = os.ReadFile("../../packages/tls/testdata/server-key.pem")?
    let serverConfig = tls.NewServerConfig(cert[:], key[:])?
    let transport = https.NewTransport(roots[:])?
    var settings = http.DefaultClientConfig()
    settings.Timeout = 3 * time.Second
    settings.PollInterval = time.Millisecond
    let client = http.NewClientWithTransport(settings, transport)?
    let listener = net.Listen("tcp4", "127.0.0.1:0")?
    let _, port, found = strings.Cut(listener.Addr(), ":")
    if !found {
        return error("listener port")
    }
    listener.SetDeadline(time.Now().Add(3 * time.Second))?
    let ctx, cancel = context.WithTimeout(context.Background(), 3 * time.Second)
    let server = go serveUpload(listener, serverConfig, ctx)
    let body = http.NewRequestBody(uploadSource{data: Array<byte>{0, 255, 128}, at: 0}, 3)?
    let response, err = client.Upload(ctx, "PUT", "https://localhost:" + port + "/upload", http.NewHeader(), body, http.DefaultUploadConfig())
    if err != nil {
        cancel()
        return err
    }
    if response.StatusCode != 201 {
        cancel()
        panic("HTTPS upload status")
    }
    let servingErr = server.wait()
    cancel()
    return servingErr
}

func TestHTTPSDoRejectsUntrustedExpiredAndFutureCertificates() error {
    httpsCase("localhost", "../../packages/tls/testdata/server.pem", "../../packages/tls/testdata/server-key.pem", "../../packages/tls/testdata/future.pem", "not correctly signed")?
    httpsCase("localhost", "../../packages/tls/testdata/expired.pem", "../../packages/tls/testdata/expired-key.pem", "../../packages/tls/testdata/roots.pem", "expired")?
    return httpsCase("localhost", "../../packages/tls/testdata/future.pem", "../../packages/tls/testdata/future-key.pem", "../../packages/tls/testdata/roots.pem", "future")
}

func TestHTTPSDoRejectsTrustedWrongHostname() error {
    return httpsCase("localhost", "testdata/wrong-host.pem", "../../packages/tls/testdata/server-key.pem", "testdata/wrong-host.pem", "does not match")
}

func TestHTTPSIPAddressURLsMatchOnlyIPEntries() error {
    httpsCase("127.0.0.1", "../../packages/tls/testdata/ip.pem", "../../packages/tls/testdata/server-key.pem", "../../packages/tls/testdata/ip.pem", "")?
    return httpsCase("127.0.0.1", "../../packages/tls/testdata/server.pem", "../../packages/tls/testdata/server-key.pem", "../../packages/tls/testdata/roots.pem", "does not match")
}

func TestHTTPSDefaultClientUsesPlatformRoots() error {
    let client = https.NewDefaultClient(http.DefaultClientConfig())?
    let transport = https.NewDefaultTransport()?
    return nil
}

func TestHTTPSRootedHostnameReachesContextValidation() error {
    let roots = os.ReadFile("../../packages/tls/testdata/roots.pem")?
    let transport = https.NewTransport(roots[:])?
    let target = url.ParseAbsolute("https://localhost.:443/")?
    let ctx, cancel = context.WithCancel(context.Background())
    cancel()
    let conn, err = transport.Dial(ctx, target)
    _ = err
    if err != error("context canceled") {
        panic("rooted HTTPS hostname rejected")
    }
    return nil
}
