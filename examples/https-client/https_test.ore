package main

import "std/context"
import "std/errors"
import "std/io"
import "std/net"
import "std/net/http"
import "std/net/url"
import "std/os"
import "std/strings"
import "std/time"
import "tls"
import "tls/https"

async func serveHTTPS(listener own net.Listener, config own tls.ServerConfig, ctx context.Context, host string) error {
    let accepted = listener.Accept()?
    var conn = tls.Server(ctx, accepted, config)?
    var request = ""
    var one = Array<byte>{0}
    for !strings.HasSuffix(request, "\r\n\r\n") {
        let n = conn.Read(one[:])?
        if n != 1 || request.len() > 4096 {
            return error("invalid HTTPS request")
        }
        request += string(rune(one[0]))
    }
    if !strings.HasPrefix(request, "GET /binary HTTP/1.1\r\nHost: " + host + ":") {
        return error("wrong HTTPS authority or target")
    }
    var response = strings.Bytes("HTTP/1.1 200 OK\r\nContent-Length: 3\r\n\r\n")
    response.push(0)
    response.push(255)
    response.push(128)
    for var position = 0; position < response.len(); position += 1 {
        let n = conn.Write(response[position:position + 1])?
        if n != 1 {
            return error("short HTTPS fixture write")
        }
        time.Sleep(2 * time.Millisecond)
    }
    let _ = conn.Close()
    return nil
}

func httpsCase(host string, certPath string, keyPath string, rootsPath string, expected string) error {
    return httpsRequest(host, certPath, keyPath, rootsPath, expected, false)
}

func streamedBody(client http.Client, ctx context.Context, target string) (int, Array<byte>, error) {
    let empty = Array<byte>{}
    var stream = client.Open(ctx, "GET", target, http.NewHeader(), empty[:], http.DefaultStreamConfig())?
    var body = Array<byte>{}
    var buffer = Array<byte>{0, 0}
    for {
        let n, err = stream.Read(buffer[:])
        for var i = 0; i < n; i += 1 {
            body.push(buffer[i])
        }
        if err == io.EOF {
            break
        }
        if err != nil {
            return 0, Array<byte>{}, err
        }
    }
    let _, complete = stream.Trailers()
    if !complete {
        return 0, Array<byte>{}, error("incomplete HTTPS stream")
    }
    let status = stream.StatusCode()
    stream.Close()?
    return status, body, nil
}

func fetchBinary(client http.Client, ctx context.Context, target string, streamed bool) (int, Array<byte>, error) {
    if streamed {
        return streamedBody(client, ctx, target)
    }
    let response = client.Get(ctx, target)?
    return response.StatusCode, response.Body, nil
}

func httpsRequest(host string, certPath string, keyPath string, rootsPath string, expected string, streamed bool) error {
    let roots = os.ReadFile(rootsPath)?
    let cert = os.ReadFile(certPath)?
    let key = os.ReadFile(keyPath)?
    let serverConfig = tls.NewServerConfig(cert[:], key[:])?
    let transport = https.NewTransport(roots[:])?
    var settings = http.DefaultClientConfig()
    settings.Timeout = 3 * time.Second
    settings.PollInterval = time.Millisecond
    let client = http.NewClientWithTransport(settings, transport)?
    let listener = net.Listen("tcp4", "127.0.0.1:0")?
    let _, port, found = strings.Cut(listener.Addr(), ":")
    if !found {
        return error("listener port")
    }
    listener.SetDeadline(time.Now().Add(3 * time.Second))?
    let ctx, cancel = context.WithTimeout(context.Background(), 3 * time.Second)
    let server = go serveHTTPS(listener, serverConfig, ctx, host)
    let target = "https://" + host + ":" + port + "/binary"
    let status, body, err = fetchBinary(client, ctx, target, streamed)
    if expected == "" {
        if err != nil {
            cancel();
            return err
        }
        if status != 200 || body.len() != 3 || body[0] != 0 || body[1] != 255 || body[2] != 128 {
            panic("HTTPS binary response")
        }
    } else {
        if err == nil || body.len() != 0 {
            panic("unverified HTTPS accepted")
        }
        if !strings.Contains(errors.Message(err), expected) {
            panic(errors.Message(err))
        }
    }
    let servingErr = server.wait()
    cancel()
    if expected == "" && servingErr != nil {
        return servingErr
    }
    _ = servingErr
    return nil
}

func TestHTTPSDoVerifiesPeerAndPreservesFragmentedBinaryBytes() error {
    return httpsCase("localhost", "../../packages/tls/testdata/server.pem", "../../packages/tls/testdata/server-key.pem", "../../packages/tls/testdata/roots.pem", "")
}

func TestHTTPSOpenStreamsVerifiedFragmentedBinaryBytes() error {
    httpsRequest("localhost", "../../packages/tls/testdata/server.pem", "../../packages/tls/testdata/server-key.pem", "../../packages/tls/testdata/roots.pem", "", true)?
    return httpsRequest("localhost", "testdata/wrong-host.pem", "../../packages/tls/testdata/server-key.pem", "testdata/wrong-host.pem", "does not match", true)
}

type uploadSource struct {
    data Array<byte>
    at int
}

func (s mut uploadSource) Read(buf mut []byte) (int, error) {
    if s.at == s.data.len() {
        return 0, io.EOF
    }
    buf[0] = s.data[s.at]
    s.at += 1
    return 1, nil
}

async func serveUpload(listener own net.Listener, config own tls.ServerConfig, ctx context.Context) error {
    let accepted = listener.Accept()?
    var conn = tls.Server(ctx, accepted, config)?
    conn.SetReadDeadline(time.Now().Add(3 * time.Second))?
    var request = ""
    var one = Array<byte>{0}
    for !strings.HasSuffix(request, "\r\n\r\n") {
        let n = conn.Read(one[:])?
        if n != 1 || request.len() > 4096 {
            return error("invalid HTTPS upload head")
        }
        request += string(rune(one[0]))
    }
    if !strings.HasPrefix(request, "PUT /upload HTTP/1.1\r\n") || !strings.Contains(request, "\r\nContent-Length: 3\r\n") {
        return error("wrong HTTPS upload head")
    }
    var body = Array<byte>{}
    for body.len() < 3 {
        let n = conn.Read(one[:])?
        if n != 1 {
            return error("HTTPS upload body stalled")
        }
        body.push(one[0])
    }
    if body[0] != 0 || body[1] != 255 || body[2] != 128 {
        return error("HTTPS upload bytes changed")
    }
    conn.Write(strings.Bytes("HTTP/1.1 201 Created\r\nContent-Length: 0\r\n\r\n")[:])?
    let _ = conn.Close()
    return nil
}

func TestHTTPSUploadStreamsVerifiedBinaryBody() error {
    let roots = os.ReadFile("../../packages/tls/testdata/roots.pem")?
    let cert = os.ReadFile("../../packages/tls/testdata/server.pem")?
    let key = os.ReadFile("../../packages/tls/testdata/server-key.pem")?
    let serverConfig = tls.NewServerConfig(cert[:], key[:])?
    let transport = https.NewTransport(roots[:])?
    var settings = http.DefaultClientConfig()
    settings.Timeout = 3 * time.Second
    settings.PollInterval = time.Millisecond
    let client = http.NewClientWithTransport(settings, transport)?
    let listener = net.Listen("tcp4", "127.0.0.1:0")?
    let _, port, found = strings.Cut(listener.Addr(), ":")
    if !found {
        return error("listener port")
    }
    listener.SetDeadline(time.Now().Add(3 * time.Second))?
    let ctx, cancel = context.WithTimeout(context.Background(), 3 * time.Second)
    let server = go serveUpload(listener, serverConfig, ctx)
    let body = http.NewRequestBody(uploadSource{data: Array<byte>{0, 255, 128}, at: 0}, 3)?
    let response, err = client.Upload(ctx, "PUT", "https://localhost:" + port + "/upload", http.NewHeader(), body, http.DefaultUploadConfig())
    if err != nil {
        cancel()
        return err
    }
    if response.StatusCode != 201 {
        cancel()
        panic("HTTPS upload status")
    }
    let servingErr = server.wait()
    cancel()
    return servingErr
}

func TestHTTPSDoRejectsUntrustedExpiredAndFutureCertificates() error {
    httpsCase("localhost", "../../packages/tls/testdata/server.pem", "../../packages/tls/testdata/server-key.pem", "../../packages/tls/testdata/future.pem", "not correctly signed")?
    httpsCase("localhost", "../../packages/tls/testdata/expired.pem", "../../packages/tls/testdata/expired-key.pem", "../../packages/tls/testdata/roots.pem", "expired")?
    return httpsCase("localhost", "../../packages/tls/testdata/future.pem", "../../packages/tls/testdata/future-key.pem", "../../packages/tls/testdata/roots.pem", "future")
}

func TestHTTPSDoRejectsTrustedWrongHostname() error {
    return httpsCase("localhost", "testdata/wrong-host.pem", "../../packages/tls/testdata/server-key.pem", "testdata/wrong-host.pem", "does not match")
}

func TestHTTPSIPAddressURLsMatchOnlyIPEntries() error {
    httpsCase("127.0.0.1", "../../packages/tls/testdata/ip.pem", "../../packages/tls/testdata/server-key.pem", "../../packages/tls/testdata/ip.pem", "")?
    return httpsCase("127.0.0.1", "../../packages/tls/testdata/server.pem", "../../packages/tls/testdata/server-key.pem", "../../packages/tls/testdata/roots.pem", "does not match")
}

func TestHTTPSDefaultClientUsesPlatformRoots() error {
    let client = https.NewDefaultClient(http.DefaultClientConfig())?
    let transport = https.NewDefaultTransport()?
    return nil
}

func TestHTTPSRootedHostnameReachesContextValidation() error {
    let roots = os.ReadFile("../../packages/tls/testdata/roots.pem")?
    let transport = https.NewTransport(roots[:])?
    let target = url.ParseAbsolute("https://localhost.:443/")?
    let ctx, cancel = context.WithCancel(context.Background())
    cancel()
    let conn, err = transport.Dial(ctx, target)
    _ = err
    if err != error("context canceled") {
        panic("rooted HTTPS hostname rejected")
    }
    return nil
}

async func serveKeepAlive(listener own net.Listener, config own tls.ServerConfig, ctx context.Context, requests int) error {
    let accepted = listener.Accept()?
    var conn = tls.Server(ctx, accepted, config)?
    conn.SetReadDeadline(time.Now().Add(3 * time.Second))?
    for var i = 0; i < requests; i += 1 {
        var request = ""
        var one = Array<byte>{0}
        for !strings.HasSuffix(request, "\r\n\r\n") {
            let n = conn.Read(one[:])?
            if n != 1 || request.len() > 4096 {
                return error("invalid pooled HTTPS request")
            }
            request += string(rune(one[0]))
        }
        if strings.Contains(strings.ToLower(request), "connection:") {
            return error("pooled HTTPS request closed its connection")
        }
        conn.Write(strings.Bytes("HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok")[:])?
    }
    let _ = conn.Close()
    return nil
}

func pooledHTTPS(rootsPath string) (http.Pool, net.Listener, string, error) {
    let roots = os.ReadFile(rootsPath)?
    let transport = https.NewTransport(roots[:])?
    var settings = http.DefaultClientConfig()
    settings.Timeout = 3 * time.Second
    settings.PollInterval = time.Millisecond
    let client = http.NewClientWithTransport(settings, transport)?
    let pool = http.NewPool(client, http.DefaultPoolConfig())?
    let listener = net.Listen("tcp4", "127.0.0.1:0")?
    let _, port, _ = strings.Cut(listener.Addr(), ":")
    listener.SetDeadline(time.Now().Add(3 * time.Second))?
    return pool, listener, "https://localhost:" + port + "/binary", nil
}

func TestHTTPSPoolReusesOneVerifiedConnection() error {
    let cert = os.ReadFile("../../packages/tls/testdata/server.pem")?
    let key = os.ReadFile("../../packages/tls/testdata/server-key.pem")?
    let serverConfig = tls.NewServerConfig(cert[:], key[:])?
    let pool, listener, target, setupErr = pooledHTTPS("../../packages/tls/testdata/roots.pem")
    if setupErr != nil {
        return setupErr
    }
    let ctx, cancel = context.WithTimeout(context.Background(), 3 * time.Second)
    let server = go serveKeepAlive(listener, serverConfig, ctx, 3)
    let empty = Array<byte>{}
    for var i = 0; i < 2; i += 1 {
        let response, err = pool.Do(ctx, "GET", target, http.NewHeader(), empty[:])
        if err != nil {
            cancel()
            return err
        }
        if response.StatusCode != 200 || response.Body.len() != 2 {
            cancel()
            panic("pooled HTTPS response")
        }
    }
    let status, body, streamErr = pooledStream(pool, ctx, target)
    if streamErr != nil {
        cancel()
        return streamErr
    }
    if status != 200 || body.len() != 2 || pool.Stats().Idle != 1 {
        cancel()
        panic("pooled HTTPS stream")
    }
    pool.Close()
    let servingErr = server.wait()
    cancel()
    return servingErr
}

func pooledStream(pool http.Pool, ctx context.Context, target string) (int, Array<byte>, error) {
    let empty = Array<byte>{}
    var stream = pool.Open(ctx, "GET", target, http.NewHeader(), empty[:], http.DefaultStreamConfig())?
    var body = Array<byte>{}
    var buffer = Array<byte>{0}
    for {
        let n, err = stream.Read(buffer[:])
        for var i = 0; i < n; i += 1 {
            body.push(buffer[i])
        }
        if err == io.EOF {
            break
        }
        if err != nil {
            return 0, Array<byte>{}, err
        }
    }
    let status = stream.StatusCode()
    stream.Close()?
    return status, body, nil
}

func TestHTTPSPoolRejectsTrustedWrongHostname() error {
    let cert = os.ReadFile("testdata/wrong-host.pem")?
    let key = os.ReadFile("../../packages/tls/testdata/server-key.pem")?
    let serverConfig = tls.NewServerConfig(cert[:], key[:])?
    let pool, listener, target, setupErr = pooledHTTPS("testdata/wrong-host.pem")
    if setupErr != nil {
        return setupErr
    }
    let ctx, cancel = context.WithTimeout(context.Background(), 3 * time.Second)
    let server = go serveHTTPS(listener, serverConfig, ctx, "localhost")
    let empty = Array<byte>{}
    let _, err = pool.Do(ctx, "GET", target, http.NewHeader(), empty[:])
    if err == nil || !strings.Contains(errors.Message(err), "does not match") {
        panic("unverified pooled HTTPS accepted")
    }
    if pool.Stats().Idle != 0 || pool.Stats().Active != 0 {
        panic("rejected HTTPS connection kept")
    }
    let servingErr = server.wait()
    _ = servingErr
    cancel()
    return nil
}

async func serveRedirect(listener own net.Listener, config own tls.ServerConfig, ctx context.Context, location string) error {
    let accepted = listener.Accept()?
    var conn = tls.Server(ctx, accepted, config)?
    conn.SetReadDeadline(time.Now().Add(10 * time.Second))?
    var request = ""
    var one = Array<byte>{0}
    for !strings.HasSuffix(request, "\r\n\r\n") {
        let n = conn.Read(one[:])?
        if n != 1 || request.len() > 4096 {
            return error("invalid HTTPS redirect request")
        }
        request += string(rune(one[0]))
    }
    conn.Write(strings.Bytes("HTTP/1.1 302 Found\r\nLocation: " + location + "\r\nContent-Length: 0\r\n\r\n")[:])?
    let _ = conn.Close()
    return nil
}

func redirectCase(secondCert string, expected string) error {
    var rootPEM = os.ReadFile("../../packages/tls/testdata/roots.pem")?
    let extra = os.ReadFile(secondCert)?
    for b in extra {
        rootPEM.push(b)
    }
    let goodCert = os.ReadFile("../../packages/tls/testdata/server.pem")?
    let otherCert = os.ReadFile(secondCert)?
    let key = os.ReadFile("../../packages/tls/testdata/server-key.pem")?
    let transport = https.NewTransport(rootPEM[:])?
    var settings = http.DefaultClientConfig()
    settings.Timeout = 10 * time.Second
    settings.PollInterval = time.Millisecond
    let client = http.NewClientWithTransport(settings, transport)?
    let first = net.Listen("tcp4", "127.0.0.1:0")?
    let second = net.Listen("tcp4", "127.0.0.1:0")?
    let _, firstPort, _ = strings.Cut(first.Addr(), ":")
    let _, secondPort, _ = strings.Cut(second.Addr(), ":")
    first.SetDeadline(time.Now().Add(10 * time.Second))?
    second.SetDeadline(time.Now().Add(10 * time.Second))?
    let ctx, cancel = context.WithTimeout(context.Background(), 10 * time.Second)
    let target = "https://localhost:" + secondPort + "/binary"
    let redirecting = go serveRedirect(first, tls.NewServerConfig(goodCert[:], key[:])?, ctx, target)
    let serving = go serveHTTPS(second, tls.NewServerConfig(otherCert[:], key[:])?, ctx, "localhost")
    let empty = Array<byte>{}
    let response, final, err = client.Follow(ctx, "GET", "https://localhost:" + firstPort + "/start", http.NewHeader(), empty[:], http.DefaultRedirectConfig())
    let redirectErr = redirecting.wait()
    let servingErr = serving.wait()
    cancel()
    var serverErr = redirectErr
    if serverErr == nil {
        serverErr = servingErr
    } else {
        _ = servingErr
    }
    if expected != "" {
        _ = serverErr
        if err == nil || !strings.Contains(errors.Message(err), expected) {
            panic("unverified HTTPS redirect accepted")
        }
        return nil
    }
    if err != nil {
        _ = serverErr
        return err
    }
    if response.StatusCode != 200 || response.Body.len() != 3 || final != target {
        panic("HTTPS redirect response")
    }
    return serverErr
}

func TestHTTPSRedirectVerifiesEveryHop() error {
    redirectCase("../../packages/tls/testdata/server.pem", "")?
    return redirectCase("testdata/wrong-host.pem", "does not match")
}

async func serveProxy(listener own net.Listener, ctx context.Context, upstreamAddress string) error {
    let client = listener.Accept()?
    client.SetReadDeadline(time.Now().Add(10 * time.Second))?
    var head = ""
    var one = Array<byte>{0}
    for !strings.HasSuffix(head, "\r\n\r\n") {
        let n = client.Read(one[:])?
        if n != 1 || head.len() > 4096 {
            return error("invalid proxy request")
        }
        head += string(rune(one[0]))
    }
    if !strings.HasPrefix(head, "CONNECT localhost:") || strings.Contains(head, "Proxy-Authorization") {
        return error("unexpected proxy request")
    }
    let upstream = net.Dial("tcp4", upstreamAddress)?
    client.Write(strings.Bytes("HTTP/1.1 200 Connection Established\r\n\r\n")[:])?
    var buf = Array<byte>{}
    for buf.len() < 4096 {
        buf.push(0)
    }
    for ctx.Err() == nil {
        if relayOnce(client, upstream, buf)? || relayOnce(upstream, client, buf)? {
            return nil
        }
    }
    return nil
}

func relayOnce(from net.Conn, to net.Conn, buf mut Array<byte>) (bool, error) {
    from.SetReadDeadline(time.Now().Add(5 * time.Millisecond))?
    let n, err = from.Read(buf[:])
    if n > 0 {
        let _, writeErr = to.Write(buf[:n])
        if writeErr != nil {
            _ = err
            return true, nil
        }
    }
    if err == error("net.Read: timed out") {
        return false, nil
    }
    return err != nil, nil
}

func proxiedCase(certPath string, extraRoot string, expected string) error {
    var roots = os.ReadFile("../../packages/tls/testdata/roots.pem")?
    let extra = os.ReadFile(extraRoot)?
    for b in extra {
        roots.push(b)
    }
    let cert = os.ReadFile(certPath)?
    let key = os.ReadFile("../../packages/tls/testdata/server-key.pem")?
    var settings = http.DefaultClientConfig()
    settings.Timeout = 10 * time.Second
    settings.PollInterval = time.Millisecond
    let target = net.Listen("tcp4", "127.0.0.1:0")?
    let proxy = net.Listen("tcp4", "127.0.0.1:0")?
    let _, targetPort, _ = strings.Cut(target.Addr(), ":")
    target.SetDeadline(time.Now().Add(10 * time.Second))?
    proxy.SetDeadline(time.Now().Add(10 * time.Second))?
    let client = https.NewProxyClient(roots[:], settings, http.ProxyConfig{URL: "http://" + proxy.Addr() + "/", Authorization: ""})?
    let ctx, cancel = context.WithTimeout(context.Background(), 10 * time.Second)
    let upstreamAddress = target.Addr()
    let serving = go serveHTTPS(target, tls.NewServerConfig(cert[:], key[:])?, ctx, "localhost")
    let relaying = go serveProxy(proxy, ctx, upstreamAddress)
    let empty = Array<byte>{}
    let response, err = client.Do(ctx, "GET", "https://localhost:" + targetPort + "/binary", http.NewHeader(), empty[:])
    cancel()
    let servingErr = serving.wait()
    let relayErr = relaying.wait()
    var serverErr = relayErr
    if serverErr == nil {
        serverErr = servingErr
    } else {
        _ = servingErr
    }
    if expected != "" {
        _ = serverErr
        if err == nil || !strings.Contains(errors.Message(err), expected) {
            panic("unverified proxied HTTPS accepted")
        }
        return nil
    }
    if err != nil {
        _ = serverErr
        return err
    }
    if response.StatusCode != 200 || response.Body.len() != 3 || response.Body[1] != 255 {
        panic("proxied HTTPS response")
    }
    return serverErr
}

func TestHTTPSProxyTunnelVerifiesTheTarget() error {
    proxiedCase("../../packages/tls/testdata/server.pem", "../../packages/tls/testdata/server.pem", "")?
    return proxiedCase("testdata/wrong-host.pem", "testdata/wrong-host.pem", "does not match")
}

func TestHTTPSAutoClientFallsBackToHTTP1() error {
    let roots = os.ReadFile("../../packages/tls/testdata/roots.pem")?
    let cert = os.ReadFile("../../packages/tls/testdata/server.pem")?
    let key = os.ReadFile("../../packages/tls/testdata/server-key.pem")?
    let serverConfig = tls.NewServerConfig(cert[:], key[:])?
    var settings = http.DefaultClientConfig()
    settings.Timeout = 3 * time.Second
    settings.PollInterval = time.Millisecond
    settings.DialTimeout = 0
    let client = https.NewAutoClient(roots[:], settings, http.DefaultHTTP2Config())?
    let listener = net.Listen("tcp4", "127.0.0.1:0")?
    let _, port, found = strings.Cut(listener.Addr(), ":")
    if !found {
        return error("listener port")
    }
    listener.SetDeadline(time.Now().Add(3 * time.Second))?
    let ctx, cancel = context.WithTimeout(context.Background(), 3 * time.Second)
    let server = go serveHTTPS(listener, serverConfig, ctx, "localhost")
    let empty = Array<byte>{}
    let response = client.Do(ctx, "GET", "https://localhost:" + port + "/binary", http.NewHeader(), empty[:])?
    server.wait()?
    cancel()
    if response.StatusCode != 200 || response.Body.len() != 3 || response.Body[1] != 255 {
        return error("fallback response")
    }
    if client.Stats().HTTP2Connections != 0 {
        return error("fallback kept an HTTP/2 connection")
    }
    let quick, stop = context.WithTimeout(context.Background(), 2 * time.Second)
    let _, plainFirst = client.Do(quick, "GET", "http://127.0.0.1:1/", http.NewHeader(), empty[:])
    let _, secureAfter = client.Do(quick, "GET", "https://127.0.0.1:1/", http.NewHeader(), empty[:])
    stop()
    _ = secureAfter
    if plainFirst == nil || secureAfter == nil || strings.Contains(errors.Message(secureAfter), "deadline") {
        return error("https request after a plain one to the same address did not fail at once")
    }
    client.Close()
    let _, closedErr = client.Do(context.Background(), "GET", "https://localhost:" + port + "/binary", http.NewHeader(), empty[:])
    if closedErr != error("https.AutoClient: closed client") {
        return error("closed client accepted a request")
    }
    let _, plainErr = client.Do(context.Background(), "GET", "http://127.0.0.1:1/", http.NewHeader(), empty[:])
    if plainErr != error("https.AutoClient: closed client") {
        return error("closed client accepted a plain request")
    }
    return nil
}
