package main

import "std/context"
import "std/errors"
import "std/net/http"
import "std/os"
import "tls/https"

func newClient(args Array<string>) (http.Client, error) {
    if args.len() == 3 {
        let roots = os.ReadFile(args[1])?
        return https.NewClient(roots[:], http.DefaultClientConfig())
    }
    return https.NewDefaultClient(http.DefaultClientConfig())
}

func run() error {
    let args = os.Args()
    if args.len() != 2 && args.len() != 3 { return error("usage: https-client [roots.pem] https://example.com/") }
    let client = newClient(args)?
    let response = client.Get(context.Background(), args[args.len() - 1])?
    println(response.StatusCode)
    return nil
}
func main() {
    let err = run()
    if err != nil { println(errors.Message(err)); os.Exit(1) }
}
