package securehttp

import "std/context"
import "std/net/http"
import "std/net/url"
import "tls"

type Transport struct { config tls.ClientConfig }
type secureConn struct { source tls.Conn }

func NewTransport(rootsPEM []byte) (Transport, error) {
    let config = tls.NewClientConfig(rootsPEM)?
    return Transport{config: config}, nil
}
func requireHTTPS(scheme string) error {
    if scheme != "https" { return error("securehttp: HTTPS transport requires https URL") }
    return nil
}
func (t Transport) Dial(ctx context.Context, scheme string, authority string) (http.ClientConn, error) {
    requireHTTPS(scheme)?
    let target = url.ParseAbsolute("https://" + authority)?
    let conn = tls.DialContext(ctx, target.Address, target.Hostname, t.config)?
    return secureConn{source: conn}, nil
}
func (c mut secureConn) Read(data mut []byte) (int, error) {
    let n, err = c.source.Read(data)
    if err == error("tls: timed out") { return n, http.ClientPollTimeout }
    return n, err
}
func (c mut secureConn) Write(data []byte) (int, error) {
    let n, err = c.source.Write(data)
    if err == error("tls: timed out") { return n, http.ClientPollTimeout }
    return n, err
}
func (c mut secureConn) SetReadDeadline(deadline int) error { return c.source.SetReadDeadline(deadline) }
func (c mut secureConn) SetWriteDeadline(deadline int) error { return c.source.SetWriteDeadline(deadline) }
