package main

import "zore/net"
import "zore/strings"

func checksum(data []byte) int {
    var total = 0
    for i, b in data {
        total += int(b)
    }
    return total
}

func reverse(conn own net.Conn) {
    var buf = Array<byte>{0, 0, 0, 0, 0, 0, 0, 0}
    let count, err = conn.Read(buf[:])
    if err != nil {
        return
    }
    var flipped = Array<byte>{}
    for var i = count; i > 0; i -= 1 {
        flipped.push(buf[i - 1])
    }
    _, _ = conn.Write(flipped[:])
}

func main() {
    let word = strings.Bytes("héllo")
    println(word.len())
    println(checksum(word[:]))

    let back, err = strings.FromBytes(word[:])
    println(back)
    _ = err

    let broken = Array<byte>{104, 255, 105}
    let _, failure = strings.FromBytes(broken[:])
    println(failure == error("strings.FromBytes: invalid UTF-8"))

    let listener, listenErr = net.Listen("tcp", "127.0.0.1:0")
    if listenErr != nil {
        println("listen failed")
        return
    }
    let address = listener.Addr()
    let server = go accept(listener)
    let conn, dialErr = net.Dial("tcp", address)
    if dialErr != nil {
        println("dial failed")
        return
    }
    _, _ = conn.Write(broken[:])
    var reply = Array<byte>{0, 0, 0, 0, 0, 0, 0, 0}
    let count, readErr = conn.Read(reply[:])
    _ = readErr
    println(count)
    println(reply[0])
    println(reply[1])
    println(reply[2])
    server.wait()
}

func accept(listener own net.Listener) {
    let conn, err = listener.Accept()
    if err != nil {
        return
    }
    reverse(conn)
}
