package main

import "zore/net"
import "zore/strings"
import "zore/time"

func shout(conn own net.Conn) {
    var buf = strings.Bytes("................................")
    for {
        let count, err = conn.Read(buf[:])
        if err != nil {
            return
        }
        let text, invalid = strings.FromBytes(buf[:count])
        if invalid != nil {
            return
        }
        let reply = strings.Bytes(text + "!")
        let _, writeErr = conn.Write(reply[:])
        if writeErr != nil {
            return
        }
    }
}

func serve(listener own net.Listener, clients int) {
    for var i = 0; i < clients; i += 1 {
        let conn, err = listener.Accept()
        if err != nil {
            return
        }
        go shout(conn)
    }
}

func ask(address string, message string, delay int, answers channel<string>) {
    time.Sleep(delay)
    let conn, err = net.Dial("tcp", address)
    if err != nil {
        answers.send("dial failed")
        return
    }
    let data = strings.Bytes(message)
    let _, writeErr = conn.Write(data[:])
    if writeErr != nil {
        answers.send("write failed")
        return
    }
    var buf = strings.Bytes("................................")
    let count, readErr = conn.Read(buf[:])
    if readErr != nil {
        answers.send("read failed")
        return
    }
    let reply, _ = strings.FromBytes(buf[:count])
    answers.send(reply)
}

func main() {
    let listener, err = net.Listen("tcp", "127.0.0.1:0")
    if err != nil {
        println("listen failed")
        return
    }
    let address = listener.Addr()
    go serve(listener, 3)

    let answers = channel<string>(3)
    go ask(address, "slow", 300 * time.Millisecond, answers)
    go ask(address, "medium", 150 * time.Millisecond, answers)
    go ask(address, "fast", 0, answers)

    for var i = 0; i < 3; i += 1 {
        let reply, _ = answers.receive()
        println(reply)
    }

    let before = time.Now()
    time.Sleep(20 * time.Millisecond)
    println(time.Since(before) >= 20 * time.Millisecond)
}
