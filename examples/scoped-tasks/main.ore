package main

func sum(values Array<int>) int {
    var total = 0
    for value in values { total += value }
    return total
}

func increment(value mut int) { value += 1 }

async func combined(values own Array<int>) int {
    scope {
        let first = go sum(values)
        let second = go sum(values)
        return (await first) + (await second)
    }
}

func main() {
    let values = Array<int>{1, 2, 3, 4}
    scope {
        let first = go sum(values)
        let second = go sum(values)
        println(first.wait() + second.wait())
    }

    var count = 0
    scope {
        go increment(count)
    }
    println(count)
    let asynchronous = go combined(values)
    println(asynchronous.wait())
}
